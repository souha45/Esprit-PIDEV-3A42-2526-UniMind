<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.PrendreRendezVousModalController"
           prefWidth="760"
           style="-fx-background-color: #f5f3ff;">

    <!-- ══════════════════════════════════════
         CONTENU PRINCIPAL
    ══════════════════════════════════════ -->
    <VBox spacing="0">

        <!-- ── HEADER ── -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color:#4c1d95;-fx-padding:20 24 18 24;">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Prendre un rendez-vous"
                       style="-fx-font-family:'Segoe UI';-fx-font-size:17px;
                              -fx-font-weight:bold;-fx-text-fill:#ffffff;"/>
                <Label text="Choisissez un créneau parmi les psychologues disponibles"
                       style="-fx-font-family:'Segoe UI';-fx-font-size:11px;
                              -fx-text-fill:rgba(255,255,255,0.65);"/>
            </VBox>
            <Button fx:id="btnFermer" text="✕"
                    style="-fx-background-color:rgba(255,255,255,0.12);-fx-text-fill:#ffffff;
                           -fx-font-size:13px;-fx-min-width:28;-fx-min-height:28;
                           -fx-background-radius:50;-fx-cursor:hand;-fx-border-width:0;"/>
        </HBox>

        <!-- ── BODY ── -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" maxHeight="480"
                    style="-fx-background-color:#f5f3ff;-fx-background:#f5f3ff;-fx-border-width:0;">
            <VBox spacing="14" style="-fx-padding:18 22 14 22;">

                <!-- Filtres -->
                <VBox spacing="10"
                      style="-fx-background-color:#ffffff;-fx-background-radius:12;
                             -fx-padding:14 16;-fx-border-color:#ddd6fe;
                             -fx-border-width:1;-fx-border-radius:12;">
                    <Label text="Filtres"
                           style="-fx-font-family:'Segoe UI';-fx-font-size:12px;
                                  -fx-font-weight:bold;-fx-text-fill:#7c3aed;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Psychologue"
                                   style="-fx-font-family:'Segoe UI';-fx-font-size:10px;-fx-text-fill:#9ca3af;"/>
                            <ComboBox fx:id="comboPsy" promptText="Tous les psychologues" maxWidth="Infinity"
                                      style="-fx-background-color:#f5f3ff;-fx-border-color:#ddd6fe;
                                             -fx-border-radius:8;-fx-background-radius:8;
                                             -fx-border-width:1;-fx-font-family:'Segoe UI';
                                             -fx-font-size:12px;-fx-pref-height:34px;-fx-cursor:hand;"/>
                        </VBox>
                        <VBox spacing="4" prefWidth="150">
                            <Label text="Type"
                                   style="-fx-font-family:'Segoe UI';-fx-font-size:10px;-fx-text-fill:#9ca3af;"/>
                            <ComboBox fx:id="comboType" promptText="Tous" maxWidth="Infinity"
                                      style="-fx-background-color:#f5f3ff;-fx-border-color:#ddd6fe;
                                             -fx-border-radius:8;-fx-background-radius:8;
                                             -fx-border-width:1;-fx-font-family:'Segoe UI';
                                             -fx-font-size:12px;-fx-pref-height:34px;-fx-cursor:hand;"/>
                        </VBox>
                        <VBox spacing="4" prefWidth="150">
                            <Label text="À partir du"
                                   style="-fx-font-family:'Segoe UI';-fx-font-size:10px;-fx-text-fill:#9ca3af;"/>
                            <DatePicker fx:id="datePickerFiltre" maxWidth="Infinity"
                                        style="-fx-background-color:#f5f3ff;-fx-border-color:#ddd6fe;
                                               -fx-border-radius:8;-fx-background-radius:8;
                                               -fx-border-width:1;-fx-font-family:'Segoe UI';
                                               -fx-font-size:12px;-fx-pref-height:34px;-fx-cursor:hand;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Label nb créneaux -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Créneaux disponibles"
                           style="-fx-font-family:'Segoe UI';-fx-font-size:13px;
                                  -fx-font-weight:bold;-fx-text-fill:#4c1d95;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblNbCreneaux"
                           style="-fx-background-color:#ede9fe;-fx-text-fill:#5b21b6;
                                  -fx-font-family:'Segoe UI';-fx-font-size:11px;-fx-font-weight:bold;
                                  -fx-padding:3 12;-fx-background-radius:20;"/>
                </HBox>

                <!-- Grille -->
                <VBox style="-fx-background-color:#ffffff;-fx-background-radius:12;
                             -fx-border-color:#ddd6fe;-fx-border-width:1;-fx-border-radius:12;
                             -fx-padding:14;">
                    <TilePane fx:id="gridCreneaux" hgap="10" vgap="10"
                              prefColumns="3" prefTileWidth="210" prefTileHeight="118"
                              style="-fx-background-color:transparent;"/>
                    <Label fx:id="lblEmptyCreneaux"
                           text="Aucun créneau disponible pour ces critères"
                           visible="false" managed="false"
                           style="-fx-font-family:'Segoe UI';-fx-font-size:13px;
                                  -fx-text-fill:#c4b5fd;-fx-padding:12 0;"/>
                </VBox>

                <!-- Bandeau sélection -->
                <HBox fx:id="boxSelection" alignment="CENTER_LEFT" spacing="10"
                      visible="false" managed="false"
                      style="-fx-background-color:#ecfdf5;-fx-background-radius:10;
                             -fx-border-color:#6ee7b7;-fx-border-width:1;-fx-border-radius:10;
                             -fx-padding:10 14;">
                    <Label text="✅" style="-fx-font-size:15px;"/>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Créneau sélectionné"
                               style="-fx-font-family:'Segoe UI';-fx-font-size:10px;
                                      -fx-text-fill:#059669;-fx-font-weight:bold;"/>
                        <Label fx:id="lblSelection"
                               style="-fx-font-family:'Segoe UI';-fx-font-size:12px;
                                      -fx-font-weight:bold;-fx-text-fill:#065f46;"/>
                    </VBox>
                    <Button fx:id="btnDeselectionner" text="✕ Désélectionner"
                            style="-fx-background-color:transparent;-fx-text-fill:#34d399;
                                   -fx-font-size:11px;-fx-cursor:hand;-fx-border-width:0;"/>
                </HBox>

                <!-- Motif -->
                <!-- MOTIF avec bouton dictée -->
                <VBox spacing="6"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 12;
             -fx-padding: 16 18; -fx-border-color: #e0e7ff; -fx-border-width: 1;
             -fx-border-radius: 12;
             -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.07), 8, 0, 0, 2);">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="📝  Motif de consultation"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                      -fx-font-weight: bold; -fx-text-fill: #3730a3;" />
                        <Label text="(optionnel)"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                      -fx-text-fill: #9ca3af;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnDictation" text="🎤 Dictée vocale"
                                style="-fx-background-color: #6366f1; -fx-text-fill: white;
                       -fx-font-size: 11px; -fx-font-weight: bold;
                       -fx-padding: 5 12; -fx-background-radius: 8;
                       -fx-cursor: hand;" />
                    </HBox>
                    <TextArea fx:id="txtMotif"
                              promptText="Décrivez brièvement la raison de votre consultation…"
                              prefHeight="60" wrapText="true"
                              style="-fx-background-color: #f5f3ff; -fx-border-color: #e0e7ff;
                     -fx-border-width: 1; -fx-border-radius: 10; -fx-background-radius: 10;
                     -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                     -fx-text-fill: #374151; -fx-prompt-text-fill: #c4b5fd;
                     -fx-control-inner-background: #f5f3ff;" />
                </VBox>

            </VBox>
        </ScrollPane>

        <!-- ── Toast zone (juste au-dessus du footer) ── -->
        <StackPane fx:id="toastContainer"
                   style="-fx-padding:0 0 6 0;"
                   minHeight="0" prefHeight="0"
                   visible="false" managed="false"
                   mouseTransparent="true"
                   StackPane.alignment="BOTTOM_CENTER"/>

        <!-- ── FOOTER ── -->
        <HBox alignment="CENTER_RIGHT" spacing="10"
              style="-fx-padding:13 22;-fx-background-color:#ffffff;
                     -fx-border-color:#ddd6fe;-fx-border-width:1 0 0 0;">
            <Button fx:id="btnAnnuler" text="Annuler"
                    style="-fx-background-color:#f3f4f6;-fx-text-fill:#6b7280;
                           -fx-font-family:'Segoe UI';-fx-font-size:13px;
                           -fx-padding:9 20;-fx-background-radius:10;
                           -fx-border-color:#e5e7eb;-fx-border-width:1;
                           -fx-border-radius:10;-fx-cursor:hand;"/>
            <Button fx:id="btnConfirmer" text="✓  Confirmer la réservation"
                    style="-fx-background-color:#7c3aed;-fx-text-fill:#ffffff;
                           -fx-font-family:'Segoe UI';-fx-font-size:13px;-fx-font-weight:bold;
                           -fx-padding:9 22;-fx-background-radius:10;-fx-cursor:hand;
                           -fx-effect:dropshadow(gaussian,rgba(124,58,237,0.35),8,0,0,2);"/>
        </HBox>
    </VBox>

    <!-- ══════════════════════════════════════
         OVERLAY CONFIRMATION (fond semi-transparent)
    ══════════════════════════════════════ -->
    <StackPane fx:id="confirmOverlay"
               style="-fx-background-color:rgba(15,5,30,0.45);"
               visible="false" managed="false"/>

</StackPane>