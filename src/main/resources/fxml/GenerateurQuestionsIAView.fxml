<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.GenerateurQuestionsIAController"
      spacing="16"
      style="-fx-background-color: #f1f5f9; -fx-padding: 24;">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="🤖 Générateur de Questions par IA"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
        <Label text="Générez automatiquement des questions QCM selon le type du questionnaire"
               style="-fx-font-size: 12px; -fx-text-fill: #94a3b8;"/>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <VBox spacing="12" prefWidth="380"
              style="-fx-background-color: white; -fx-background-radius: 12;
                     -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;
                     -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

            <Label text="⚙️ Configuration"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>

            <VBox spacing="4">
                <Label text="Questionnaire cible *"
                       style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                <ComboBox fx:id="cbQuestionnaire" maxWidth="Infinity"
                          promptText="Choisir un questionnaire..."
                          style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1;
                                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px;"/>
            </VBox>

            <VBox spacing="6"
                  style="-fx-background-color: #f8fafc; -fx-background-radius: 8;
                         -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-border-width: 1;
                         -fx-padding: 12;">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Type détecté :"
                           style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="lblType" text="—"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                </HBox>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Nombre de questions prévu :"
                           style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                    <Label fx:id="lblNbreQuestions" text="—"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                </HBox>
            </VBox>

            <VBox spacing="4">
                <Label text="Nombre de questions à générer *"
                       style="-fx-font-size: 12px; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                <Spinner fx:id="spinnerNbre" min="1" max="20" initialValue="5"
                         editable="true" maxWidth="Infinity"
                         style="-fx-font-size: 13px;"/>
                <Label text="(max 20 questions par génération)"
                       style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <VBox spacing="4"
                  style="-fx-background-color: #ede9fe; -fx-background-radius: 8;
                         -fx-border-color: #c4b5fd; -fx-border-radius: 8; -fx-border-width: 1;
                         -fx-padding: 10;">
                <Label text="📝 Format généré : QCM"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                <Label text="• 4 options de réponse par question"
                       style="-fx-font-size: 11px; -fx-text-fill: #6d28d9;"/>
                <Label text="• Scores : 0, 1, 2, 3"
                       style="-fx-font-size: 11px; -fx-text-fill: #6d28d9;"/>
                <Label text="• Questions cliniquement adaptées au type"
                       style="-fx-font-size: 11px; -fx-text-fill: #6d28d9;"/>
            </VBox>

            <VBox spacing="8">
                <padding><Insets top="8"/></padding>
                <Button fx:id="btnGenerer" text="🤖 Générer avec IA" onAction="#handleGenerer"
                        maxWidth="Infinity"
                        style="-fx-background-color: #7c3aed; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-font-size: 14px;
                               -fx-padding: 12 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="btnSauvegarder" text="💾 Sauvegarder en BDD" onAction="#handleSauvegarder"
                        maxWidth="Infinity" disable="true"
                        style="-fx-background-color: #10b981; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-font-size: 13px;
                               -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button text="🔄 Réinitialiser" onAction="#handleReset"
                        maxWidth="Infinity"
                        style="-fx-background-color: #e2e8f0; -fx-text-fill: #64748b;
                               -fx-font-weight: bold; -fx-font-size: 12px;
                               -fx-padding: 8 20; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </VBox>

            <Label fx:id="lblStatus" text="" wrapText="true"
                   style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
        </VBox>

        <VBox spacing="12" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12;
                     -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;
                     -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

            <Label text="📋 Questions Générées"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #374151;"/>

            <VBox fx:id="boxChargement" alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS"
                  visible="false" managed="false">
                <ProgressIndicator style="-fx-pref-width: 60; -fx-pref-height: 60;"/>
                <Label text="⏳ L'IA génère vos questions..."
                       style="-fx-font-size: 14px; -fx-text-fill: #7c3aed; -fx-font-weight: bold;"/>
                <Label text="Cela peut prendre 10 à 30 secondes"
                       style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
            </VBox>

            <VBox fx:id="boxResultat" spacing="8" VBox.vgrow="ALWAYS"
                  visible="false" managed="false">
                <ListView fx:id="listQuestions" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: #f8fafc;
                                 -fx-border-color: #e2e8f0; -fx-border-radius: 8;
                                 -fx-background-radius: 8; -fx-font-size: 12px;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="12" VBox.vgrow="ALWAYS">
                <Label text="🤖" style="-fx-font-size: 48px;"/>
                <Label text="Sélectionnez un questionnaire et cliquez"
                       style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
                <Label text="'Générer avec IA' pour créer vos questions"
                       style="-fx-font-size: 13px; -fx-text-fill: #94a3b8;"/>
            </VBox>
        </VBox>
    </HBox>
</VBox>