<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.MainController"
            style="-fx-background-color: #0f1117;">

    <top>
        <VBox style="-fx-background-color: #161b27; -fx-border-color: #2a3050; -fx-border-width: 0 0 1 0;">
            <padding><Insets top="16" right="24" bottom="16" left="24"/></padding>
            <Label text="🧠 UniMind"
                   style="-fx-text-fill: #7c8dfc; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Plateforme de Gestion des Questionnaires Psychologiques"
                   style="-fx-text-fill: #8892a4; -fx-font-size: 12px;"/>
            <HBox spacing="10">
                <padding><Insets top="12" bottom="4"/></padding>
                <Button fx:id="btnQuestionnaire" text="📋  Questionnaires"
                        onAction="#showQuestionnaire"
                        style="-fx-background-color: #7c8dfc; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 18; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="btnQuestion" text="❓  Questions"
                        onAction="#showQuestion"
                        style="-fx-background-color: #1e2436; -fx-text-fill: #8892a4; -fx-font-weight: bold; -fx-padding: 7 18; -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button fx:id="btnReponse" text="📝  Réponses"
                        onAction="#showReponse"
                        style="-fx-background-color: #1e2436; -fx-text-fill: #8892a4; -fx-font-weight: bold; -fx-padding: 7 18; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane fx:id="contentArea"
                   style="-fx-background-color: #0f1117; -fx-padding: 20;">
        </StackPane>
    </center>

</BorderPane>