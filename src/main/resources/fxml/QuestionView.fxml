<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.QuestionController"
      spacing="20" style="-fx-background-color: #f1f5f9;" prefHeight="650" prefWidth="900">

    <!-- ═══════════════════ FORMULAIRE ═══════════════════ -->
    <ScrollPane fitToWidth="true" prefWidth="380"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox spacing="4" prefWidth="360"
              style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #e2e8f0;
                     -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

            <Label text="❓ Nouvelle Question"
                   style="-fx-text-fill: #3b82f6; -fx-font-size: 14px; -fx-font-weight: bold;"/>

            <Label text="Texte *" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <TextArea fx:id="taTexte" promptText="Texte de la question" prefRowCount="3"
                      style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1;
                             -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px;"/>
            <Label fx:id="errTexte" text="" prefHeight="16" maxHeight="16"
                   style="-fx-text-fill: #ef4444; -fx-font-size: 11px;"/>

            <Label text="Questionnaire associé *" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <ComboBox fx:id="cbQuestionnaire" promptText="Choisir un questionnaire" maxWidth="Infinity"
                      style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1;
                             -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px;"/>
            <Label fx:id="errQuestionnaire" text="" prefHeight="16" maxHeight="16"
                   style="-fx-text-fill: #ef4444; -fx-font-size: 11px;"/>

            <Label text="Type Question *" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <ComboBox fx:id="cbTypeQuestion" promptText="Choisir le type" maxWidth="Infinity"
                      style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1;
                             -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px;"/>
            <Label fx:id="errTypeQuestion" text="" prefHeight="16" maxHeight="16"
                   style="-fx-text-fill: #ef4444; -fx-font-size: 11px;"/>

            <!-- ── AJOUT OPTION + SCORE ── -->
            <Label text="Ajouter une Option" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
            <HBox spacing="6">
                <TextField fx:id="tfOptionInput" promptText="Ex: Jamais"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1;
                                  -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-padding: 7;"/>
                <TextField fx:id="tfScoreInput" promptText="Score"
                           prefWidth="70"
                           style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1;
                                  -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-padding: 7;"/>
                <Button text="➕" onAction="#handleAjouterOption"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-padding: 7 10; -fx-background-radius: 7; -fx-cursor: hand;"/>
                <Button text="🗑" onAction="#handleSupprimerOption"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-padding: 7 10; -fx-background-radius: 7; -fx-cursor: hand;"/>
            </HBox>
            <Label fx:id="errOptions" text="" prefHeight="16" maxHeight="16"
                   style="-fx-text-fill: #ef4444; -fx-font-size: 11px;"/>

            <!-- ── LISTE OPTIONS + SCORES CÔTE À CÔTE ── -->
            <HBox spacing="6">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Options ajoutées" style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                    <ListView fx:id="lvOptions" prefHeight="100"
                              style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1;
                                     -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px;"/>
                </VBox>
                <VBox spacing="2" prefWidth="80">
                    <Label text="Scores" style="-fx-text-fill: #64748b; -fx-font-size: 11px;"/>
                    <ListView fx:id="lvScores" prefHeight="100"
                              style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1;
                                     -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px;"/>
                </VBox>
            </HBox>
            <Label fx:id="errScores" text="" prefHeight="16" maxHeight="16"
                   style="-fx-text-fill: #ef4444; -fx-font-size: 11px;"/>

            <HBox spacing="8"><padding><Insets top="8"/></padding>
                <Button text="➕ Ajouter"   onAction="#handleAjouter"
                        style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-padding: 7 14; -fx-background-radius: 7; -fx-cursor: hand;"/>
                <Button text="✏️ Modifier"  onAction="#handleModifier"
                        style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-padding: 7 14; -fx-background-radius: 7; -fx-cursor: hand;"/>
                <Button text="🗑 Supprimer" onAction="#handleSupprimer"
                        style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-padding: 7 14; -fx-background-radius: 7; -fx-cursor: hand;"/>
                <Button text="🔄 Reset"     onAction="#handleReset"
                        style="-fx-background-color: #94a3b8; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-padding: 7 14; -fx-background-radius: 7; -fx-cursor: hand;"/>
            </HBox>
            <Label fx:id="lblStatus" text="" wrapText="true" prefHeight="18"
                   style="-fx-font-size: 12px;"/>
        </VBox>
    </ScrollPane>

    <!-- ═══════════════════ LISTE ═══════════════════ -->
    <VBox spacing="10" HBox.hgrow="ALWAYS"
          style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #e2e8f0;
                 -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

        <Label text="❓ Liste des Questions"
               style="-fx-text-fill: #1e293b; -fx-font-size: 14px; -fx-font-weight: bold;"/>

        <TextField fx:id="tfSearch"
                   promptText="🔍  Rechercher par texte, type ou questionnaire..."
                   style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b;
                          -fx-border-color: #cbd5e1; -fx-border-radius: 8;
                          -fx-background-radius: 8; -fx-font-size: 13px; -fx-padding: 8 12 8 12;"/>

        <ListView fx:id="listQuestion" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: transparent;
                         -fx-border-color: transparent;
                         -fx-padding: 0;"/>
    </VBox>
</HBox>