<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.ReponseController"
      spacing="10"
      style="-fx-background-color: #ffffff; -fx-background-radius: 12;
             -fx-border-color: #e2e8f0; -fx-border-radius: 12;
             -fx-border-width: 1; -fx-padding: 20;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

    <Label text="📝 Toutes les Réponses"
           style="-fx-text-fill: #3b82f6; -fx-font-size: 16px; -fx-font-weight: bold;"/>
    <Label text="Vue lecture seule — toutes les réponses des étudiants"
           style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>

    <TableView fx:id="tableReponse" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #ffffff; -fx-font-size: 13px;">
        <columns>
            <TableColumn fx:id="colId"     text="ID"               prefWidth="50"/>
            <TableColumn fx:id="colScore"  text="Score"            prefWidth="80"/>
            <TableColumn fx:id="colNiveau" text="Niveau"           prefWidth="90"/>
            <TableColumn fx:id="colPsy"    text="Besoin Psy"       prefWidth="100"/>
            <TableColumn fx:id="colQId"    text="Questionnaire ID" prefWidth="130"/>
            <TableColumn fx:id="colUserId" text="User ID"          prefWidth="80"/>
            <TableColumn fx:id="colDuree"  text="Durée (min)"      prefWidth="100"/>
            <TableColumn fx:id="colDate"   text="Date"             prefWidth="160"/>
        </columns>
    </TableView>
</VBox>