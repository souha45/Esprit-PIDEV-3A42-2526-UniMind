<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.QuestionnaireController"
      spacing="20" style="-fx-background-color: #f1f5f9;" prefHeight="620">

    <VBox spacing="4" prefWidth="370"
          style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

        <Label text="📋 Nouveau Questionnaire"
               style="-fx-text-fill: #3b82f6; -fx-font-size: 14px; -fx-font-weight: bold;"/>

        <Label text="Code *" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
        <TextField fx:id="tfCode" promptText="Ex: Q001"
                   style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-padding: 7;"/>
        <Label fx:id="errCode" text="" style="-fx-text-fill: #ef4444; -fx-font-size: 11px;"/>

        <Label text="Nom *" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
        <TextField fx:id="tfNom" promptText="Nom du questionnaire"
                   style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-padding: 7;"/>
        <Label fx:id="errNom" text="" style="-fx-text-fill: #ef4444; -fx-font-size: 11px;"/>

        <Label text="Description" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
        <TextArea fx:id="taDescription" promptText="Description (optionnel)" prefRowCount="2"
                  style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px;"/>

        <Label text="Type *" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
        <ComboBox fx:id="cbType" promptText="Choisir le type" maxWidth="Infinity"
                  style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px;"/>
        <Label fx:id="errType" text="" style="-fx-text-fill: #ef4444; -fx-font-size: 11px;"/>

        <HBox spacing="8">
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Seuil Légère *" style="-fx-text-fill: #64748b; -fx-font-size: 12px;">
                    <tooltip>
                        <Tooltip text="Score maximum pour le niveau LÉGÈRE.&#10;En dessous de ce score → niveau légère.&#10;Ex: si seuil = 10, score ≤ 10 = légère"/>
                    </tooltip>
                </Label>
                <TextField fx:id="tfSeuilLeger" promptText="Ex: 10"
                           style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-padding: 7;">
                    <tooltip>
                        <Tooltip text="Score maximum pour le niveau LÉGÈRE.&#10;En dessous de ce score → niveau légère.&#10;Ex: si seuil = 10, score ≤ 10 = légère"/>
                    </tooltip>
                </TextField>
                <Label fx:id="errSeuilLeger" text="" style="-fx-text-fill: #ef4444; -fx-font-size: 10px;"/>
            </VBox>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Seuil Modéré *" style="-fx-text-fill: #64748b; -fx-font-size: 12px;">
                    <tooltip>
                        <Tooltip text="Score maximum pour le niveau MODÉRÉ.&#10;Entre seuil légère et ce score → niveau modéré.&#10;Ex: si seuil = 20, score entre 11-20 = modéré"/>
                    </tooltip>
                </Label>
                <TextField fx:id="tfSeuilModere" promptText="Ex: 20"
                           style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-padding: 7;">
                    <tooltip>
                        <Tooltip text="Score maximum pour le niveau MODÉRÉ.&#10;Entre seuil légère et ce score → niveau modéré.&#10;Ex: si seuil = 20, score entre 11-20 = modéré"/>
                    </tooltip>
                </TextField>
                <Label fx:id="errSeuilModere" text="" style="-fx-text-fill: #ef4444; -fx-font-size: 10px;"/>
            </VBox>
            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label text="Seuil Sévère *" style="-fx-text-fill: #64748b; -fx-font-size: 12px;">
                    <tooltip>
                        <Tooltip text="Score maximum pour le niveau SÉVÈRE.&#10;Au dessus de seuil modéré → niveau sévère.&#10;Ex: si seuil = 30, score > 20 = sévère"/>
                    </tooltip>
                </Label>
                <TextField fx:id="tfSeuilSevere" promptText="Ex: 30"
                           style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-padding: 7;">
                    <tooltip>
                        <Tooltip text="Score maximum pour le niveau SÉVÈRE.&#10;Au dessus de seuil modéré → niveau sévère.&#10;Ex: si seuil = 30, score > 20 = sévère"/>
                    </tooltip>
                </TextField>
                <Label fx:id="errSeuilSevere" text="" style="-fx-text-fill: #ef4444; -fx-font-size: 10px;"/>
            </VBox>
        </HBox>

        <Label text="Nombre de Questions *" style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
        <TextField fx:id="tfNbreQuestions" promptText="Ex: 10"
                   style="-fx-background-color: #f8fafc; -fx-text-fill: #1e293b; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px; -fx-padding: 7;"/>
        <Label fx:id="errNbreQuestions" text="" style="-fx-text-fill: #ef4444; -fx-font-size: 11px;"/>

        <HBox spacing="8"><padding><Insets top="8"/></padding>
            <Button text="➕ Ajouter"   onAction="#handleAjouter"
                    style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 14; -fx-background-radius: 7; -fx-cursor: hand;"/>
            <Button text="✏️ Modifier"  onAction="#handleModifier"
                    style="-fx-background-color: #f59e0b; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 14; -fx-background-radius: 7; -fx-cursor: hand;"/>
            <Button text="🗑 Supprimer" onAction="#handleSupprimer"
                    style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 14; -fx-background-radius: 7; -fx-cursor: hand;"/>
            <Button text="🔄 Reset"     onAction="#handleReset"
                    style="-fx-background-color: #94a3b8; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 14; -fx-background-radius: 7; -fx-cursor: hand;"/>
        </HBox>
        <Label fx:id="lblStatus" text="" wrapText="true" style="-fx-font-size: 12px;"/>
    </VBox>

    <VBox spacing="8" HBox.hgrow="ALWAYS"
          style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
        <Label text="Liste des Questionnaires"
               style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-font-weight: bold;"/>
        <TableView fx:id="tableQuestionnaire" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: #ffffff; -fx-font-size: 13px;">
            <columns>
                <TableColumn fx:id="colId"   text="ID"           prefWidth="50"/>
                <TableColumn fx:id="colCode" text="Code"         prefWidth="80"/>
                <TableColumn fx:id="colNom"  text="Nom"          prefWidth="150"/>
                <TableColumn fx:id="colType" text="Type"         prefWidth="100"/>
                <TableColumn fx:id="colNbre" text="Nb Questions" prefWidth="110"/>
                <TableColumn fx:id="colSL"   text="Seuil L."     prefWidth="70"/>
                <TableColumn fx:id="colSM"   text="Seuil M."     prefWidth="70"/>
                <TableColumn fx:id="colSS"   text="Seuil S."     prefWidth="70"/>
            </columns>
        </TableView>
    </VBox>
</HBox>