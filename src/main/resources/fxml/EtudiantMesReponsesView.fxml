<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.EtudiantMesReponsesController"
      spacing="12"
      style="-fx-background-color: #ffffff; -fx-background-radius: 12;
             -fx-border-color: #ddd6fe; -fx-border-radius: 12;
             -fx-border-width: 1; -fx-padding: 20;
             -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.1), 8, 0, 0, 2);">

    <Label text="📊 Mes Réponses"
           style="-fx-text-fill: #7c3aed; -fx-font-size: 16px; -fx-font-weight: bold;"/>
    <Label text="Historique de vos réponses aux questionnaires"
           style="-fx-text-fill: #a78bfa; -fx-font-size: 12px;"/>

    <TableView fx:id="tableReponse" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #ffffff; -fx-font-size: 13px;">
        <columns>
            <TableColumn fx:id="colScore"  text="Score"       prefWidth="100"/>
            <TableColumn fx:id="colNiveau" text="Niveau"      prefWidth="120"/>
            <TableColumn fx:id="colPsy"    text="Besoin Psy"  prefWidth="120"/>
            <TableColumn fx:id="colDuree"  text="Durée (min)" prefWidth="110"/>
            <TableColumn fx:id="colDate"   text="Date"        prefWidth="200"/>
        </columns>
    </TableView>
</VBox>