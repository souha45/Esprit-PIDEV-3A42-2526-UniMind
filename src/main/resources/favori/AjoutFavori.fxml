<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.favori.AjoutFavoriController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
            <children>
                <Label text="AJOUTER UN FAVORI" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="🔙 Retour" onAction="#retour" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" />
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 30;">
                <children>
                    <HBox spacing="20" alignment="CENTER">
                        <children>
                            <!-- ID Événement -->
                            <VBox spacing="5" prefWidth="250">
                                <children>
                                    <Label text="Événement (ID) *" style="-fx-font-weight: bold;" />
                                    <TextField fx:id="txtEvenementId" promptText="ID de l'événement" prefWidth="250" />
                                    <Label fx:id="lblErreurEvenementId" text="Obligatoire"
                                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                                </children>
                            </VBox>

                            <!-- ID Étudiant -->
                            <VBox spacing="5" prefWidth="250">
                                <children>
                                    <Label text="Étudiant (ID) *" style="-fx-font-weight: bold;" />
                                    <TextField fx:id="txtEtudiantId" promptText="ID de l'étudiant" prefWidth="250" />
                                    <Label fx:id="lblErreurEtudiantId" text="Obligatoire"
                                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                                    <Label fx:id="lblErreurUnicite" text="Ce favori existe déjà"
                                           style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                        <children>
                            <Button text="💾 Enregistrer" onAction="#enregistrerFavori"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 150;" />
                            <Button text="❌ Annuler" onAction="#retour"
                                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-pref-width: 150;" />
                        </children>
                    </HBox>

                    <Label fx:id="lblSucces" text="Favori ajouté avec succès !"
                           style="-fx-text-fill: #27ae60; -fx-font-size: 14px; -fx-font-weight: bold;" visible="false" />
                </children>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
