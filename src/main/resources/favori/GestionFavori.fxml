<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.favori.GestionFavoriController">

    <top>
        <VBox spacing="10" style="-fx-background-color: #ecf0f1; -fx-padding: 15;">
            <children>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="GESTION DES FAVORIS"
                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnAjouter" text="➕ Ajouter un favori" onAction="#ajouterFavori"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>

                        <Button text="🔙 Retour" onAction="#retourAccueil"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
                    </children>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Total:" style="-fx-font-weight: bold;"/>
                        <Label fx:id="lblTotal" text="0 favoris"/>
                    </children>
                </HBox>

                <Separator/>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableFavoris" prefHeight="500">
            <columns>
                <TableColumn fx:id="colEvenement" text="Événement" prefWidth="350"/>
                <TableColumn fx:id="colEtudiant" text="Étudiant" prefWidth="200"/>
                <TableColumn fx:id="colDateAjout" text="Date d'ajout" prefWidth="200"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
