<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.favori.GestionFavoriController"
            stylesheets="@../styles/etudiant.css"
            styleClass="dashboard-bg">

    <top>
        <VBox spacing="16" styleClass="padding-medium">
            <children>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <Label text="GESTION DES FAVORIS"
                               styleClass="label-subtitle"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnAjouter" text="➕ Ajouter un favori" onAction="#ajouterFavori"
                                styleClass="btn-primary"/>

                        <Button text="🔙 Retour" onAction="#retourAccueil"
                                styleClass="btn-secondary"/>
                    </children>
                </HBox>

                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Total:" styleClass="form-label"/>
                        <Label fx:id="lblTotal" text="0 favoris" styleClass="form-label"/>
                    </children>
                </HBox>

                <Separator/>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableFavoris" prefHeight="500">
            <columns>
                <TableColumn fx:id="colEvenement" text="Événement" prefWidth="350"/>
                <TableColumn fx:id="colEtudiant" text="Étudiant" prefWidth="200"/>
                <TableColumn fx:id="colDateAjout" text="Date d'ajout" prefWidth="200"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
