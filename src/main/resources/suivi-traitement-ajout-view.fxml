<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.SuiviTraitementAjoutController" stylesheets="@/css/traitements-suivis.css">

    <!-- En-tête de la page -->
    <VBox styleClass="page-header">
        <Label text="Ajouter un Suivi de Traitement" styleClass="page-title"/>
        <Label text="Ajoutez un nouveau suivi pour un traitement" styleClass="page-subtitle"/>
    </VBox>

    <!-- Formulaire principal -->
    <VBox styleClass="form-container" spacing="20">
        <padding>
            <Insets top="20" right="30" bottom="20" left="30"/>
        </padding>

        <!-- Grille du formulaire -->
        <GridPane hgap="20" vgap="15" styleClass="form-grid">

            <!-- Ligne 1 : Date Suivi et Traitement -->
            <Label text="Date Suivi" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dpDateSuivi" styleClass="form-datepicker" promptText="jj/mm/aaaa" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Traitement" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <ComboBox fx:id="cmbTraitement" promptText="Sélectionnez un traitement" styleClass="form-combo" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

            <!-- Ligne 2 : Étudiant (visible uniquement pour psychologue) -->
            <Label fx:id="lblEtudiant" text="Étudiant" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbEtudiant" promptText="Sélectionnez un étudiant" styleClass="form-combo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label fx:id="lblPsychologue" text="Psychologue" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <TextField fx:id="txtPsychologue" styleClass="form-field-readonly" editable="false" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

            <!-- Ligne 3 : Notes (pleine largeur) -->
            <Label text="Notes / Observations" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextArea fx:id="txtNotes" promptText="Saisissez vos observations ici..." styleClass="form-textarea" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

        </GridPane>

        <!-- Séparateur -->
        <Separator styleClass="form-separator"/>

        <!-- Boutons d'action -->
        <HBox spacing="15" alignment="CENTER" styleClass="form-buttons">
            <Button text="Enregistrer" onAction="#handleEnregistrer" styleClass="btn-primary"/>
            <Button text="Vider" onAction="#handleVider" styleClass="btn-secondary"/>
            <Button text="Annuler" onAction="#handleAnnuler" styleClass="btn-danger"/>
        </HBox>

        <!-- Barre de statut -->
        <HBox styleClass="status-bar">
            <Label fx:id="lblStatus" text="✓ Prêt à ajouter un suivi" styleClass="status-text"/>
        </HBox>
    </VBox>
</VBox>