<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.ResetPasswordController"
            minWidth="500" minHeight="400"
            style="-fx-background-color: #F0EFFF;">

    <VBox alignment="CENTER" spacing="20"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          style="-fx-background-color: #F8F7FF; -fx-padding: 40;">

        <VBox spacing="20" alignment="CENTER" maxWidth="400"
              style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 5);">

            <Circle radius="40" fill="#4F46E5" opacity="0.1"/>
            <Label text="🔐" style="-fx-font-size: 40px; -fx-translate-y: -55px;"/>

            <Label text="Réinitialisation du mot de passe"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>

            <Label text="Entrez votre nouveau mot de passe"
                   style="-fx-font-size: 13px; -fx-text-fill: #6B7280; -fx-font-family: 'Segoe UI';"/>

            <VBox spacing="15" maxWidth="Infinity">
                <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #DDD6FE; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-background-color: white;"/>

                <PasswordField fx:id="confirmPasswordField" promptText="Confirmer le mot de passe"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #DDD6FE; -fx-border-radius: 10; -fx-border-width: 1.5; -fx-background-color: white;"/>
            </VBox>

            <Label fx:id="messageLabel" wrapText="true"
                   style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-text-alignment: center;"/>

            <Button fx:id="resetButton" text="Réinitialiser" onAction="#resetPassword"
                    style="-fx-background-color: linear-gradient(to right, #D97706, #F59E0B); -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 10; -fx-padding: 12 30; -fx-font-size: 14px; -fx-font-family: 'Segoe UI';"
                    maxWidth="Infinity"/>

        </VBox>

    </VBox>
</AnchorPane>