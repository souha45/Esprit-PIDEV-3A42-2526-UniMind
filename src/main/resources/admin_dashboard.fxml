<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<!--
    UniMind Admin Dashboard — Design inspiré Argon Dashboard
    Sidebar sombre + Contenu clair + Tables modernes avec badge statut
    Toutes les fonctionnalités originales conservées
-->
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.admin.AdminDashboardController"
            prefWidth="1280" prefHeight="760"
            style="-fx-background-color: #F8F7FF;">

    <!-- ══════════════════════════════════════════════════════════════
         SIDEBAR GAUCHE — Navigation verticale sombre
         ══════════════════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="240" spacing="0"
              style="-fx-background-color: #1E1B4B; -fx-padding: 0;">

            <!-- Logo Brand -->
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-padding: 24 20 20 20; -fx-border-color: transparent transparent #2D2A5E transparent; -fx-border-width: 0 0 1 0;">
                <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                    <image><Image url="@/images/unimind.png"/></image>
                </ImageView>
                <Label text="UniMind"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
            </HBox>

            <!-- Avatar Admin -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-padding: 20 20 16 20; -fx-border-color: transparent transparent #2D2A5E transparent; -fx-border-width: 0 0 1 0;">
                <StackPane>
                    <ImageView fx:id="navPhotoAdmin" fitWidth="56" fitHeight="56">
                        <clip><Circle centerX="28" centerY="28" radius="28"/></clip>
                    </ImageView>
                    <!-- Fallback initiales si pas de photo -->
                    <Label text="A"
                           style="-fx-background-color: #7C3AED; -fx-text-fill: white;
                                  -fx-font-size: 20px; -fx-font-weight: bold;
                                  -fx-min-width: 56; -fx-min-height: 56;
                                  -fx-alignment: CENTER; -fx-background-radius: 50;"/>
                </StackPane>
                <Label fx:id="navNomAdmin"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                              -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
                <Label text="Administrateur"
                       style="-fx-font-size: 10px; -fx-text-fill: #A78BFA;
                              -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <!-- Section label -->
            <Label text="MENU PRINCIPAL"
                   style="-fx-font-size: 9px; -fx-font-weight: bold;
                          -fx-text-fill: #6366F1; -fx-font-family: 'Segoe UI';
                          -fx-padding: 16 0 8 20; -fx-letter-spacing: 1px;"/>

            <!-- Boutons navigation -->
            <Button fx:id="btnGestionUsers"
                    text="👥   Gestion Utilisateurs"
                    onAction="#afficherGestion"
                    maxWidth="Infinity"
                    style="-fx-background-color: #4F46E5; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                           -fx-font-weight: bold; -fx-pref-height: 46;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20;
                           -fx-cursor: hand; -fx-background-radius: 0;
                           -fx-border-color: transparent transparent transparent #A78BFA;
                           -fx-border-width: 0 0 0 3;"/>

            <Button fx:id="btnDemandes"
                    text="📋   Demandes en attente"
                    onAction="#afficherDemandes"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #C4B5FD;
                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                           -fx-pref-height: 46; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 0 0 0 23; -fx-cursor: hand;
                           -fx-background-radius: 0;"/>

            <Button fx:id="btnProfil"
                    text="👤   Mon Profil"
                    onAction="#afficherProfil"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #C4B5FD;
                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                           -fx-pref-height: 46; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 0 0 0 23; -fx-cursor: hand;
                           -fx-background-radius: 0;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Séparateur + Déconnexion -->
            <Region prefHeight="1"
                    style="-fx-background-color: #2D2A5E;"/>

            <Button fx:id="btnDeconnexion"
                    text="🚪   Déconnexion"
                    onAction="#seDeconnecter"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #FCA5A5;
                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                           -fx-pref-height: 46; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 0 0 0 23; -fx-cursor: hand;
                           -fx-background-radius: 0;"/>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════════════════════
         TOP — Navbar horizontale
         ══════════════════════════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" prefHeight="64"
              style="-fx-background-color: white; -fx-padding: 0 24;
                     -fx-border-color: transparent transparent #E5E7EB transparent;
                     -fx-border-width: 0 0 1 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">

            <!-- Fil d'Ariane -->
            <VBox spacing="2">
                <Label text="Pages / Administration"
                       style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;
                              -fx-font-family: 'Segoe UI';"/>
                <Label text="Dashboard Admin"
                       style="-fx-font-size: 15px; -fx-font-weight: bold;
                              -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Barre de recherche -->
            <HBox alignment="CENTER_LEFT" spacing="8" prefHeight="36" prefWidth="220"
                  style="-fx-background-color: #F3F0FF; -fx-background-radius: 20;
                         -fx-padding: 0 14; -fx-border-color: #E9D5FF;
                         -fx-border-radius: 20; -fx-border-width: 1;">
                <Label text="🔍" style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;"/>
                <TextField fx:id="navRechercheField"
                           promptText="Rechercher un utilisateur..."
                           style="-fx-background-color: transparent;
                                  -fx-border-color: transparent;
                                  -fx-font-size: 12px; -fx-font-family: 'Segoe UI';"
                           prefWidth="170"/>
            </HBox>

            <!-- Notif -->
            <Button text="🔔"
                    style="-fx-background-color: #F3F0FF; -fx-font-size: 15px;
                           -fx-cursor: hand; -fx-background-radius: 50;
                           -fx-min-width: 36; -fx-min-height: 36; -fx-padding: 0;"/>
        </HBox>
    </top>

    <!-- ══════════════════════════════════════════════════════════════
         CENTRE — Contenu principal scrollable
         ══════════════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #F8F7FF; -fx-background: #F8F7FF;
                           -fx-border-color: transparent;">
            <VBox spacing="0" style="-fx-padding: 28 28 28 28;">

                <!-- ════════════════════════════════════════════════
                     PANNEAU GESTION UTILISATEURS
                     ════════════════════════════════════════════════ -->
                <VBox fx:id="panneauGestion" spacing="20">

                    <!-- En-tête section -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="3">
                            <Label text="Gestion des Utilisateurs"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold;
                                          -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                            <Label text="Gérez, modifiez et contrôlez tous les comptes de la plateforme."
                                   style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;
                                          -fx-font-family: 'Segoe UI';"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="➕  Ajouter un utilisateur"
                                onAction="#ouvrirModalAjout"
                                style="-fx-background-color: linear-gradient(to right, #4F46E5, #7C3AED);
                                       -fx-text-fill: white; -fx-cursor: hand;
                                       -fx-background-radius: 10; -fx-padding: 10 20;
                                       -fx-font-weight: bold; -fx-font-size: 13px;
                                       -fx-font-family: 'Segoe UI';
                                       -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.35), 8, 0, 0, 3);"/>
                    </HBox>

                    <!-- Message statut -->
                    <Label fx:id="messageGestion"
                           style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI';"/>

                    <!-- Carte table -->
                    <VBox spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                 -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">

                        <!-- En-tête carte -->
                        <HBox alignment="CENTER_LEFT" spacing="12"
                              style="-fx-padding: 16 20; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 0 0 1 0;">
                            <Label text="👥  Liste des utilisateurs"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                                          -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                        </HBox>

                        <!-- Table -->
                        <TableView fx:id="tableUtilisateurs"
                                   prefHeight="460"
                                   style="-fx-background-color: transparent;
                                          -fx-border-color: transparent;
                                          -fx-table-cell-border-color: #F9FAFB;
                                          -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;">
                            <columns>
                                <TableColumn fx:id="colNom"    text="Nom"     prefWidth="130"/>
                                <TableColumn fx:id="colPrenom" text="Prénom"  prefWidth="130"/>
                                <TableColumn fx:id="colEmail"  text="Email"   prefWidth="230"/>
                                <TableColumn fx:id="colRole"   text="Rôle"    prefWidth="130"/>
                                <TableColumn fx:id="colStatut" text="Statut"  prefWidth="100"/>
                                <TableColumn fx:id="colActif"  text="Actif"   prefWidth="80"/>
                                <TableColumn fx:id="colActions" text="Actions" prefWidth="300"/>
                            </columns>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="8" style="-fx-padding: 40;">
                                    <Label text="👥" style="-fx-font-size: 36px;"/>
                                    <Label text="Aucun utilisateur trouvé"
                                           style="-fx-font-size: 14px; -fx-text-fill: #9CA3AF;
                                                  -fx-font-family: 'Segoe UI';"/>
                                </VBox>
                            </placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                    </VBox>
                </VBox>

                <!-- ════════════════════════════════════════════════
                     PANNEAU DEMANDES EN ATTENTE
                     ════════════════════════════════════════════════ -->
                <VBox fx:id="panneauDemandes" spacing="20"
                      visible="false" managed="false">

                    <!-- En-tête section -->
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="3">
                            <Label text="Demandes d'inscription"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold;
                                          -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                            <Label text="Validez ou refusez les nouvelles demandes de compte."
                                   style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;
                                          -fx-font-family: 'Segoe UI';"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="messageDemandes"
                           style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI';"/>

                    <!-- Carte table demandes -->
                    <VBox spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                 -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">

                        <HBox alignment="CENTER_LEFT" spacing="12"
                              style="-fx-padding: 16 20; -fx-border-color: transparent transparent #F3F4F6 transparent; -fx-border-width: 0 0 1 0;">
                            <Label text="📋  Comptes en attente de validation"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                                          -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                        </HBox>

                        <TableView fx:id="tableDemandes"
                                   prefHeight="380"
                                   style="-fx-background-color: transparent;
                                          -fx-border-color: transparent;
                                          -fx-table-cell-border-color: #F9FAFB;
                                          -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;">
                            <columns>
                                <TableColumn fx:id="dColNom"    text="Nom"     prefWidth="200"/>
                                <TableColumn fx:id="dColPrenom" text="Prénom"  prefWidth="200"/>
                                <TableColumn fx:id="dColEmail"  text="Email"   prefWidth="320"/>
                                <TableColumn fx:id="dColRole"   text="Rôle"    prefWidth="200"/>
                            </columns>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="8" style="-fx-padding: 40;">
                                    <Label text="✅" style="-fx-font-size: 36px;"/>
                                    <Label text="Aucune demande en attente"
                                           style="-fx-font-size: 14px; -fx-text-fill: #9CA3AF;
                                                  -fx-font-family: 'Segoe UI';"/>
                                </VBox>
                            </placeholder>
                        </TableView>

                        <!-- Boutons action -->
                        <HBox spacing="12" alignment="CENTER_RIGHT"
                              style="-fx-padding: 14 20; -fx-border-color: #F3F4F6 transparent transparent transparent; -fx-border-width: 1 0 0 0;">
                            <Button text="✅  Accepter la sélection"
                                    onAction="#accepterDemande"
                                    style="-fx-background-color: #059669; -fx-text-fill: white;
                                           -fx-cursor: hand; -fx-background-radius: 8;
                                           -fx-padding: 10 22; -fx-font-weight: bold;
                                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                                           -fx-effect: dropshadow(gaussian, rgba(5,150,105,0.3), 6, 0, 0, 2);"/>
                            <Button text="❌  Refuser la sélection"
                                    onAction="#refuserDemande"
                                    style="-fx-background-color: #DC2626; -fx-text-fill: white;
                                           -fx-cursor: hand; -fx-background-radius: 8;
                                           -fx-padding: 10 22; -fx-font-weight: bold;
                                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                                           -fx-effect: dropshadow(gaussian, rgba(220,38,38,0.3), 6, 0, 0, 2);"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- ════════════════════════════════════════════════
                     PANNEAU PROFIL ADMIN
                     ════════════════════════════════════════════════ -->
                <VBox fx:id="panneauProfil" spacing="24"
                      visible="false" managed="false">

                    <VBox spacing="3">
                        <Label text="Mon Profil"
                               style="-fx-font-size: 22px; -fx-font-weight: bold;
                                      -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                        <Label text="Gérez vos informations personnelles et votre sécurité."
                               style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;
                                      -fx-font-family: 'Segoe UI';"/>
                    </VBox>

                    <HBox spacing="20" alignment="TOP_LEFT">

                        <!-- Colonne photo -->
                        <VBox spacing="14" alignment="CENTER"
                              style="-fx-background-color: white; -fx-padding: 28;
                                     -fx-background-radius: 14;
                                     -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                     -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);"
                              prefWidth="200">
                            <StackPane>
                                <ImageView fx:id="photoProfile" fitWidth="100" fitHeight="100">
                                    <clip><Circle centerX="50" centerY="50" radius="50"/></clip>
                                </ImageView>
                            </StackPane>
                            <Label fx:id="pNomPrenom"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                                          -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"
                                   wrapText="true" textAlignment="CENTER"/>
                            <Label fx:id="pRole"
                                   style="-fx-background-color: #EDE9FE; -fx-text-fill: #7C3AED;
                                          -fx-font-size: 11px; -fx-font-weight: bold;
                                          -fx-background-radius: 20; -fx-padding: 4 12;
                                          -fx-font-family: 'Segoe UI';"/>
                            <Button text="📷  Changer la photo"
                                    onAction="#choisirPhoto"
                                    style="-fx-background-color: #F3F0FF;
                                           -fx-text-fill: #7C3AED; -fx-cursor: hand;
                                           -fx-background-radius: 8; -fx-padding: 8 14;
                                           -fx-font-size: 11px; -fx-font-family: 'Segoe UI';
                                           -fx-border-color: #DDD6FE; -fx-border-radius: 8;
                                           -fx-border-width: 1;"/>
                        </VBox>

                        <!-- Colonne droite -->
                        <VBox spacing="16" HBox.hgrow="ALWAYS">

                            <!-- Infos compte -->
                            <VBox spacing="14"
                                  style="-fx-background-color: white; -fx-padding: 20;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                         -fx-border-width: 1;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="👤" style="-fx-font-size: 14px;"/>
                                    <Label text="Informations du compte"
                                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                                                  -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                                </HBox>
                                <Region prefHeight="1"
                                        style="-fx-background-color: #F3F4F6;"/>
                                <GridPane hgap="20" vgap="10">
                                    <Label text="Email :" GridPane.rowIndex="0" GridPane.columnIndex="0"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                                  -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                                    <Label fx:id="pEmail" GridPane.rowIndex="0" GridPane.columnIndex="1"
                                           style="-fx-font-size: 12px; -fx-text-fill: #6B7280;
                                                  -fx-font-family: 'Segoe UI';"/>
                                    <Label text="Statut :" GridPane.rowIndex="1" GridPane.columnIndex="0"
                                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                                  -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                                    <Label fx:id="pStatut" GridPane.rowIndex="1" GridPane.columnIndex="1"
                                           style="-fx-font-size: 12px; -fx-text-fill: #059669;
                                                  -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                                </GridPane>
                            </VBox>

                            <!-- Modifier profil -->
                            <VBox spacing="14"
                                  style="-fx-background-color: white; -fx-padding: 20;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                         -fx-border-width: 1;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="✏" style="-fx-font-size: 14px;"/>
                                    <Label text="Modifier le profil"
                                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                                                  -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                                </HBox>
                                <Region prefHeight="1"
                                        style="-fx-background-color: #F3F4F6;"/>
                                <HBox spacing="16">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="Bio"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold;
                                                      -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                                        <TextField fx:id="pBio" promptText="Parlez de vous..."
                                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                                          -fx-padding: 10 12; -fx-background-radius: 10;
                                                          -fx-border-color: #DDD6FE; -fx-border-radius: 10;
                                                          -fx-border-width: 1.5; -fx-background-color: #FAFAFA;"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="Téléphone"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold;
                                                      -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                                        <TextField fx:id="pTel" promptText="8 chiffres"
                                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                                          -fx-padding: 10 12; -fx-background-radius: 10;
                                                          -fx-border-color: #DDD6FE; -fx-border-radius: 10;
                                                          -fx-border-width: 1.5; -fx-background-color: #FAFAFA;"/>
                                        <Label fx:id="pErrTel"
                                               style="-fx-text-fill: #DC2626; -fx-font-size: 10px;
                                                      -fx-font-family: 'Segoe UI';"/>
                                    </VBox>
                                </HBox>
                                <Button text="💾  Sauvegarder les modifications"
                                        onAction="#sauvegarderProfil"
                                        style="-fx-background-color: #059669; -fx-text-fill: white;
                                               -fx-cursor: hand; -fx-background-radius: 8;
                                               -fx-padding: 10 20; -fx-font-weight: bold;
                                               -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                                               -fx-effect: dropshadow(gaussian, rgba(5,150,105,0.3), 6, 0, 0, 2);"/>
                            </VBox>

                            <!-- Changer mot de passe -->
                            <VBox spacing="14"
                                  style="-fx-background-color: white; -fx-padding: 20;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                         -fx-border-width: 1;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="🔒" style="-fx-font-size: 14px;"/>
                                    <Label text="Changer le mot de passe"
                                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                                                  -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                                </HBox>
                                <Region prefHeight="1"
                                        style="-fx-background-color: #F3F4F6;"/>
                                <HBox spacing="16">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="Ancien mot de passe"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold;
                                                      -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                                        <PasswordField fx:id="pAncienMdp"
                                                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                                              -fx-padding: 10 12; -fx-background-radius: 10;
                                                              -fx-border-color: #DDD6FE; -fx-border-radius: 10;
                                                              -fx-border-width: 1.5; -fx-background-color: #FAFAFA;"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="Nouveau mot de passe"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold;
                                                      -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                                        <PasswordField fx:id="pNouveauMdp"
                                                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                                              -fx-padding: 10 12; -fx-background-radius: 10;
                                                              -fx-border-color: #DDD6FE; -fx-border-radius: 10;
                                                              -fx-border-width: 1.5; -fx-background-color: #FAFAFA;"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="Confirmer"
                                               style="-fx-font-size: 11px; -fx-font-weight: bold;
                                                      -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                                        <PasswordField fx:id="pConfirmMdp"
                                                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                                              -fx-padding: 10 12; -fx-background-radius: 10;
                                                              -fx-border-color: #DDD6FE; -fx-border-radius: 10;
                                                              -fx-border-width: 1.5; -fx-background-color: #FAFAFA;"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="pErrMdp"
                                       style="-fx-text-fill: #DC2626; -fx-font-size: 11px;
                                              -fx-font-family: 'Segoe UI';"/>
                                <Button text="🔑  Changer le mot de passe"
                                        onAction="#changerMotDePasse"
                                        style="-fx-background-color: #D97706; -fx-text-fill: white;
                                               -fx-cursor: hand; -fx-background-radius: 8;
                                               -fx-padding: 10 20; -fx-font-weight: bold;
                                               -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                                               -fx-effect: dropshadow(gaussian, rgba(217,119,6,0.3), 6, 0, 0, 2);"/>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- Message global profil -->
                    <Label fx:id="pMessageProfil"
                           style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI';"/>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
