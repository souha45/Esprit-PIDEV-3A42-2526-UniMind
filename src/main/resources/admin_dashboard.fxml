                                           style="-fx-font-size: 12px; -fx-text-fill: #059669;
                                                  -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
                                </GridPane>
                            </VBox>
                            <!-- Modifier profil -->
                            <VBox spacing="14"
                                  style="-fx-background-color: white; -fx-padding: 20;
                                         -fx-background-radius: 14;
                                         -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                         -fx-border-width: 1;
                                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="✏" style="-fx-font-size: 14px;"/>
                                    <Label text="Modifier le profil"
                                           style="-fx-font-size: 14px; -fx-font-weight: bold;
                                                  -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
