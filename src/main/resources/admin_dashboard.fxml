<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.admin.AdminDashboardController"
            prefWidth="1280" prefHeight="760"
            style="-fx-background-color: #F3F0FF;">

    <!-- NAVBAR (inchangée) -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" prefHeight="60"
              style="-fx-background-color: white; -fx-padding: 0 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 5, 0, 0, 2);">
            <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                <Image url="@/images/unimind.png"/>
            </ImageView>
            <Label text="UniMind" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #7C3AED;"/>
            <Label text="|" style="-fx-text-fill: #D1D5DB; -fx-font-size: 16;"/>
            <Label text="Administration" style="-fx-font-size: 13; -fx-text-fill: #6B7280;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="4" prefHeight="32"
                  style="-fx-background-color: #F3F0FF; -fx-background-radius: 16; -fx-padding: 4 10;">
                <Label text="🔍" style="-fx-font-size: 12; -fx-text-fill: #9CA3AF;"/>
                <TextField fx:id="navRechercheField" promptText="Rechercher..."
                           prefWidth="160" prefHeight="26"
                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 12;"/>
            </HBox>
            <Button text="🔔" style="-fx-background-color: transparent; -fx-font-size: 16; -fx-cursor: hand;"/>
            <HBox alignment="CENTER" spacing="8">
                <ImageView fx:id="navPhotoAdmin" fitWidth="34" fitHeight="34">
                    <clip><Circle centerX="17" centerY="17" radius="17"/></clip>
                </ImageView>
                <Label fx:id="navNomAdmin" style="-fx-font-weight: bold; -fx-text-fill: #374151; -fx-font-size: 13;"/>
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR (inchangée) -->
    <left>
        <VBox prefWidth="250" spacing="5" style="-fx-background-color: #5B21B6; -fx-padding: 20 0;">
            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 10 0 20 0;">
                <ImageView fx:id="sidePhotoAdmin" fitWidth="70" fitHeight="70">
                    <clip><Circle centerX="35" centerY="35" radius="35"/></clip>
                </ImageView>
                <Label text="Administrateur" style="-fx-text-fill: #C4B5FD; -fx-font-size: 11;"/>
            </VBox>
            <Separator style="-fx-background-color: #7C3AED;"/>
            <Label text="MENU PRINCIPAL" style="-fx-text-fill: #A78BFA; -fx-font-size: 10; -fx-padding: 15 0 5 20; -fx-font-weight: bold;"/>

            <Button fx:id="btnGestionUsers" text="👥  Gestion Utilisateurs"
                    onAction="#afficherGestion"
                    style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>

            <Button fx:id="btnDemandes" text="📋  Demandes en attente"
                    onAction="#afficherDemandes"
                    style="-fx-background-color: transparent; -fx-text-fill: #E9D5FF; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>

            <Button fx:id="btnSeances" text="❤  Séances Méditation"
                    onAction="#showSeances"
                    style="-fx-background-color: transparent; -fx-text-fill: #E9D5FF; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>

            <Button fx:id="btnEvenements" text="🎪  Gestion Événements"
                    onAction="#showEvenements"
                    style="-fx-background-color: transparent; -fx-text-fill: #E9D5FF; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>

            <Button fx:id="btnParticipations" text="✅  Gestion Participations"
                    onAction="#showParticipations"
                    style="-fx-background-color: transparent; -fx-text-fill: #E9D5FF; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>

            <Button fx:id="btnSponsors" text="🏢  Gestion Sponsors"
                    onAction="#showSponsors"
                    style="-fx-background-color: transparent; -fx-text-fill: #E9D5FF; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>

            <Button fx:id="btnFeedbacks" text="💬  Feedbacks"
                    onAction="#showFeedbacks"
                    style="-fx-background-color: transparent; -fx-text-fill: #E9D5FF; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>

            <Button fx:id="btnStats" text="📊  Statistiques"
                    onAction="#showStats"
                    style="-fx-background-color: transparent; -fx-text-fill: #E9D5FF; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>

            <Button fx:id="btnQuestionnaires" text="📋  Questionnaires"
                    onAction="#showQuestionnaires"
                    style="-fx-background-color: transparent; -fx-text-fill: #E9D5FF; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>

            <Button fx:id="btnQuestions" text="❓  Questions"
                    onAction="#showQuestions"
                    style="-fx-background-color: transparent; -fx-text-fill: #E9D5FF; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>

            <Button fx:id="btnProfil" text="👤  Mon Profil"
                    onAction="#afficherProfil"
                    style="-fx-background-color: transparent; -fx-text-fill: #E9D5FF; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #7C3AED;"/>
            <Button fx:id="btnDeconnexion" text="🚪  Déconnexion"
                    onAction="#seDeconnecter"
                    style="-fx-background-color: transparent; -fx-text-fill: #FCA5A5; -fx-pref-width: 210; -fx-pref-height: 42; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20; -fx-cursor: hand; -fx-background-radius: 8; -fx-font-size: 13;"/>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #F8FAFC;">

            <!-- PANNEAU GESTION UTILISATEURS -->
            <VBox fx:id="panneauGestion" spacing="20" visible="true" managed="true"
                  style="-fx-padding: 25;">

                <!-- En-tête avec titre et bouton ajout -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="3">
                        <Label text="Gestion des Utilisateurs"
                               style="-fx-font-size: 22px; -fx-font-weight: bold;
                                      -fx-text-fill: #1E293B; -fx-font-family: 'Segoe UI';"/>
                        <Label text="Gérez, modifiez et contrôlez tous les comptes."
                               style="-fx-font-size: 12px; -fx-text-fill: #64748B;
                                      -fx-font-family: 'Segoe UI';"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="➕  Ajouter un utilisateur" onAction="#ouvrirModalAjout"
                            style="-fx-background-color: linear-gradient(to right, #4F46E5, #7C3AED);
                                   -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 10;
                                   -fx-padding: 10 22; -fx-font-weight: bold; -fx-font-size: 13px;
                                   -fx-font-family: 'Segoe UI';
                                   -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.35), 8, 0, 0, 3);"/>
                </HBox>

                <!-- Barre de filtres -->
                <VBox spacing="12"
                      style="-fx-background-color: white; -fx-padding: 16 24;
                             -fx-background-radius: 12; -fx-border-color: #E2E8F0;
                             -fx-border-radius: 12; -fx-border-width: 1;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);">

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="🔎" style="-fx-font-size: 14px;"/>
                        <Label text="Filtres avancés"
                               style="-fx-font-size: 13px; -fx-font-weight: bold;
                                      -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                    </HBox>

                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <!-- Filtre Rôle -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Rôle"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #6B7280; -fx-font-family: 'Segoe UI';"/>
                            <ComboBox fx:id="filtreRole" promptText="Tous les rôles" prefWidth="180">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Tous les rôles"/>
                                        <String fx:value="Admin"/>
                                        <String fx:value="Etudiant"/>
                                        <String fx:value="Psychologue"/>
                                        <String fx:value="Responsable Etudiant"/>
                                    </FXCollections>
                                </items>
                                <value><String fx:value="Tous les rôles"/></value>
                            </ComboBox>
                        </VBox>

                        <!-- Filtre Statut -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Statut"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #6B7280; -fx-font-family: 'Segoe UI';"/>
                            <ComboBox fx:id="filtreStatut" promptText="Tous les statuts" prefWidth="180">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Tous les statuts"/>
                                        <String fx:value="actif"/>
                                        <String fx:value="en_attente"/>
                                        <String fx:value="bloqué"/>
                                        <String fx:value="inactif"/>
                                    </FXCollections>
                                </items>
                                <value><String fx:value="Tous les statuts"/></value>
                            </ComboBox>
                        </VBox>

                        <!-- Filtre Actif/Inactif -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Activation"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                  -fx-text-fill: #6B7280; -fx-font-family: 'Segoe UI';"/>
                            <ComboBox fx:id="filtreActif" promptText="Tous" prefWidth="140">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Tous"/>
                                        <String fx:value="Actif"/>
                                        <String fx:value="Inactif"/>
                                    </FXCollections>
                                </items>
                                <value><String fx:value="Tous"/></value>
                            </ComboBox>
                        </VBox>

                        <!-- Bouton Réinitialiser -->
                        <VBox spacing="4" alignment="BOTTOM_RIGHT">
                            <Button text="↺  Réinitialiser"
                                    onAction="#reinitialiserFiltres"
                                    style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569;
                                           -fx-cursor: hand; -fx-background-radius: 8;
                                           -fx-padding: 8 16; -fx-font-size: 12px;
                                           -fx-font-family: 'Segoe UI';
                                           -fx-border-color: #E2E8F0; -fx-border-radius: 8;
                                           -fx-border-width: 1;"/>
                        </VBox>
                    </HBox>

                    <!-- Chips de filtres rapides -->
                    <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT">
                        <Label text="Accès rapide :"
                               style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;
                                      -fx-font-family: 'Segoe UI';"
                               minWidth="70"/>

                        <Button text="🟣 Admins" onAction="#filtrerAdmins"
                                style="-fx-background-color: #EDE9FE; -fx-text-fill: #6D28D9;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-cursor: hand; -fx-background-radius: 20;
                                       -fx-padding: 5 14; -fx-font-family: 'Segoe UI';"/>

                        <Button text="🔵 Étudiants" onAction="#filtrerEtudiants"
                                style="-fx-background-color: #DBEAFE; -fx-text-fill: #1D4ED8;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-cursor: hand; -fx-background-radius: 20;
                                       -fx-padding: 5 14; -fx-font-family: 'Segoe UI';"/>

                        <Button text="🟢 Psychologues" onAction="#filtrerPsychologues"
                                style="-fx-background-color: #D1FAE5; -fx-text-fill: #065F46;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-cursor: hand; -fx-background-radius: 20;
                                       -fx-padding: 5 14; -fx-font-family: 'Segoe UI';"/>

                        <Button text="🟠 Responsables" onAction="#filtrerResponsables"
                                style="-fx-background-color: #FFEDD5; -fx-text-fill: #C2410C;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-cursor: hand; -fx-background-radius: 20;
                                       -fx-padding: 5 14; -fx-font-family: 'Segoe UI';"/>

                        <Button text="⛔ Bloqués" onAction="#filtrerBloques"
                                style="-fx-background-color: #FEE2E2; -fx-text-fill: #991B1B;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-cursor: hand; -fx-background-radius: 20;
                                       -fx-padding: 5 14; -fx-font-family: 'Segoe UI';"/>

                        <Button text="⏳ En attente" onAction="#filtrerEnAttente"
                                style="-fx-background-color: #FEF9C3; -fx-text-fill: #854D0E;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-cursor: hand; -fx-background-radius: 20;
                                       -fx-padding: 5 14; -fx-font-family: 'Segoe UI';"/>

                        <Button text="✅ Actifs" onAction="#filtrerActifs"
                                style="-fx-background-color: #D1FAE5; -fx-text-fill: #065F46;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-cursor: hand; -fx-background-radius: 20;
                                       -fx-padding: 5 14; -fx-font-family: 'Segoe UI';"/>

                        <Button text="❌ Inactifs" onAction="#filtrerInactifs"
                                style="-fx-background-color: #F3F4F6; -fx-text-fill: #6B7280;
                                       -fx-font-size: 11px; -fx-font-weight: bold;
                                       -fx-cursor: hand; -fx-background-radius: 20;
                                       -fx-padding: 5 14; -fx-font-family: 'Segoe UI';"/>
                    </FlowPane>
                </VBox>

                <!-- Message de gestion -->
                <Label fx:id="messageGestion" style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI';"/>

                <!-- Carte table -->
                <VBox spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-border-color: #E2E8F0; -fx-border-radius: 16;
                             -fx-border-width: 1;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 10, 0, 0, 4);">

                    <HBox alignment="CENTER_LEFT" spacing="12"
                          style="-fx-padding: 16 20;
                                 -fx-border-color: transparent transparent #F1F5F9 transparent;
                                 -fx-border-width: 0 0 1 0;">
                        <Label text="👥" style="-fx-font-size: 16px;"/>
                        <Label text="Liste des utilisateurs"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;
                                      -fx-text-fill: #334155; -fx-font-family: 'Segoe UI';"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="labelNbResultats"
                               style="-fx-font-size: 11px; -fx-text-fill: #94A3B8;
                                      -fx-background-color: #F1F5F9;
                                      -fx-padding: 4 10; -fx-background-radius: 20;"/>
                    </HBox>

                    <TableView fx:id="tableUtilisateurs" prefHeight="450"
                               style="-fx-background-color: white; -fx-background-radius: 0 0 16 16;
                                      -fx-border-color: transparent;
                                      -fx-table-cell-border-color: #F1F5F9;
                                      -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;">
                        <columns>
                            <TableColumn fx:id="colNom" text="Nom" prefWidth="160"/>
                            <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="160"/>
                            <TableColumn fx:id="colEmail" text="Email" prefWidth="240"/>
                            <TableColumn fx:id="colRole" text="Rôle" prefWidth="130"/>
                            <TableColumn fx:id="colStatut" text="Statut" prefWidth="110"/>
                            <TableColumn fx:id="colActif" text="Status" prefWidth="90"/>
                            <TableColumn fx:id="colActions" text="Actions" prefWidth="320"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                                <Label text="🔍" style="-fx-font-size: 40px;"/>
                                <Label text="Aucun utilisateur trouvé"
                                       style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;
                                              -fx-font-family: 'Segoe UI';"/>
                            </VBox>
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>

            <!-- PANNEAU DEMANDES EN ATTENTE -->
            <VBox fx:id="panneauDemandes" spacing="20" visible="false" managed="false"
                  style="-fx-padding: 25;">

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="3">
                        <Label text="Demandes d'inscription"
                               style="-fx-font-size: 22px; -fx-font-weight: bold;
                                      -fx-text-fill: #1E293B; -fx-font-family: 'Segoe UI';"/>
                        <Label text="Validez ou refusez les nouvelles demandes de compte."
                               style="-fx-font-size: 12px; -fx-text-fill: #64748B;
                                      -fx-font-family: 'Segoe UI';"/>
                    </VBox>
                </HBox>

                <Label fx:id="messageDemandes" style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI';"/>

                <VBox spacing="0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-border-color: #E2E8F0; -fx-border-radius: 16;
                             -fx-border-width: 1;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 10, 0, 0, 4);">

                    <HBox alignment="CENTER_LEFT" spacing="12"
                          style="-fx-padding: 16 20;
                                 -fx-border-color: transparent transparent #F1F5F9 transparent;
                                 -fx-border-width: 0 0 1 0;">
                        <Label text="⏳" style="-fx-font-size: 16px;"/>
                        <Label text="Comptes en attente de validation"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;
                                      -fx-text-fill: #334155; -fx-font-family: 'Segoe UI';"/>
                    </HBox>

                    <TableView fx:id="tableDemandes" prefHeight="380"
                               style="-fx-background-color: white; -fx-background-radius: 0 0 16 16;
                                      -fx-border-color: transparent;
                                      -fx-table-cell-border-color: #F1F5F9;
                                      -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;">
                        <columns>
                            <TableColumn fx:id="dColNom" text="Nom" prefWidth="200"/>
                            <TableColumn fx:id="dColPrenom" text="Prénom" prefWidth="200"/>
                            <TableColumn fx:id="dColEmail" text="Email" prefWidth="340"/>
                            <TableColumn fx:id="dColRole" text="Rôle demandé" prefWidth="180"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                                <Label text="✅" style="-fx-font-size: 40px;"/>
                                <Label text="Aucune demande en attente"
                                       style="-fx-font-size: 14px; -fx-text-fill: #94A3B8;
                                              -fx-font-family: 'Segoe UI';"/>
                            </VBox>
                        </placeholder>
                    </TableView>

                    <HBox spacing="15" alignment="CENTER_RIGHT"
                          style="-fx-padding: 16 20; -fx-border-color: #F1F5F9 transparent transparent transparent;
                                 -fx-border-width: 1 0 0 0;">
                        <Button text="❌  Refuser la sélection" onAction="#refuserDemande"
                                style="-fx-background-color: white; -fx-text-fill: #DC2626;
                                       -fx-cursor: hand; -fx-background-radius: 8;
                                       -fx-padding: 10 24; -fx-font-weight: bold; -fx-font-size: 13px;
                                       -fx-font-family: 'Segoe UI';
                                       -fx-border-color: #DC2626; -fx-border-radius: 8;
                                       -fx-border-width: 1.5;"/>
                        <Button text="✅  Accepter la sélection" onAction="#accepterDemande"
                                style="-fx-background-color: #10B981; -fx-text-fill: white;
                                       -fx-cursor: hand; -fx-background-radius: 8;
                                       -fx-padding: 10 24; -fx-font-weight: bold; -fx-font-size: 13px;
                                       -fx-font-family: 'Segoe UI';
                                       -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.3), 6, 0, 0, 2);"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- PANNEAU PROFIL ADMIN -->
            <VBox fx:id="panneauProfil" spacing="20" visible="false" managed="false"
                  style="-fx-padding: 25;">
                <Label text="Mon Profil"
                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #4C1D95;"/>
                <HBox spacing="30" alignment="TOP_LEFT">
                    <VBox spacing="15" alignment="CENTER"
                          style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);"
                          prefWidth="220">
                        <ImageView fx:id="photoProfile" fitWidth="120" fitHeight="120">
                            <clip><Circle centerX="60" centerY="60" radius="60"/></clip>
                        </ImageView>
                        <Button text="📷 Changer la photo" onAction="#choisirPhoto"
                                style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 8 16; -fx-font-size: 11;"/>
                    </VBox>
                    <VBox spacing="15" HBox.hgrow="ALWAYS">
                        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <Label text="Informations du compte" style="-fx-font-weight: bold; -fx-text-fill: #4C1D95; -fx-font-size: 15;"/>
                            <GridPane hgap="15" vgap="10">
                                <Label text="Nom complet :" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <Label fx:id="pNomPrenom" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #6B7280;"/>
                                <Label text="Email :" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <Label fx:id="pEmail" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #6B7280;"/>
                                <Label text="Rôle :" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <Label fx:id="pRole" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #7C3AED; -fx-font-weight: bold;"/>
                                <Label text="Statut :" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                                <Label fx:id="pStatut" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-text-fill: #6B7280;"/>
                            </GridPane>
                        </VBox>
                        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <Label text="Modifier le profil" style="-fx-font-weight: bold; -fx-text-fill: #4C1D95; -fx-font-size: 15;"/>
                            <GridPane hgap="15" vgap="10">
                                <Label text="Bio :" GridPane.rowIndex="0" GridPane.columnIndex="0" prefWidth="80"/>
                                <TextField fx:id="pBio" promptText="Parlez de vous..." GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>
                                <Label text="Téléphone :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="pTel" promptText="8 chiffres" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label fx:id="pErrTel" style="-fx-text-fill: #DC2626; -fx-font-size: 10;" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                            </GridPane>
                            <Button text="💾 Sauvegarder les modifications" onAction="#sauvegarderProfil"
                                    style="-fx-background-color: #059669; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <Label text="Changer le mot de passe" style="-fx-font-weight: bold; -fx-text-fill: #4C1D95; -fx-font-size: 15;"/>
                            <GridPane hgap="15" vgap="10">
                                <Label text="Ancien mot de passe :" GridPane.rowIndex="0" GridPane.columnIndex="0" prefWidth="140"/>
                                <PasswordField fx:id="pAncienMdp" prefWidth="260" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Nouveau mot de passe :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="pNouveauMdp" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                <Label text="Confirmer :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                <PasswordField fx:id="pConfirmMdp" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            </GridPane>
                            <Label fx:id="pErrMdp" style="-fx-text-fill: #DC2626; -fx-font-size: 11;"/>
                            <Button text="🔑 Changer le mot de passe" onAction="#changerMotDePasse"
                                    style="-fx-background-color: #D97706; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: bold;"/>
                        </VBox>
                    </VBox>
                </HBox>
                <Label fx:id="pMessageProfil" style="-fx-font-size: 13;"/>
            </VBox>

            <!-- PANNEAU QUESTIONNAIRES -->
            <VBox fx:id="panneauQuestionnaires" spacing="15" visible="false" managed="false"
                  style="-fx-padding: 0;">
                <fx:include source="/fxml/QuestionnaireView.fxml"/>
            </VBox>

            <!-- PANNEAU QUESTIONS -->
            <VBox fx:id="panneauQuestions" spacing="15" visible="false" managed="false"
                  style="-fx-padding: 0;">
                <fx:include source="/fxml/QuestionView.fxml"/>
            </VBox>

        </StackPane>
    </center>
</BorderPane>