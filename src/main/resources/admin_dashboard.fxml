<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.*?>

<!--
    UniMind Admin Dashboard — avec DashboardAdmin (stats + graphiques)
    et système de filtrage avancé (rôle, statut, actif/inactif)
-->
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.admin.AdminDashboardController"
            prefWidth="1280" prefHeight="760"
            style="-fx-background-color: #F8F7FF;">

    <!-- ══════════════════════════════════════════════════════════════
         SIDEBAR GAUCHE
         ══════════════════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="240" spacing="0"
              style="-fx-background-color: #1E1B4B; -fx-padding: 0;">

            <!-- Logo Brand -->
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-padding: 24 20 20 20;
                         -fx-border-color: transparent transparent #2D2A5E transparent;
                         -fx-border-width: 0 0 1 0;">
                <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                    <image><Image url="@/images/unimind.png"/></image>
                </ImageView>
                <Label text="UniMind"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
            </HBox>

            <!-- Avatar Admin -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-padding: 20 20 16 20;
                         -fx-border-color: transparent transparent #2D2A5E transparent;
                         -fx-border-width: 0 0 1 0;">
                <StackPane>
                    <ImageView fx:id="navPhotoAdmin" fitWidth="56" fitHeight="56">
                        <clip><Circle centerX="28" centerY="28" radius="28"/></clip>
                    </ImageView>
                    <Label text="A"
                           style="-fx-background-color: #7C3AED; -fx-text-fill: white;
                                  -fx-font-size: 20px; -fx-font-weight: bold;
                                  -fx-min-width: 56; -fx-min-height: 56;
                                  -fx-alignment: CENTER; -fx-background-radius: 50;"/>
                </StackPane>
                <Label fx:id="navNomAdmin"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;
                              -fx-text-fill: white; -fx-font-family: 'Segoe UI';"/>
                <Label text="Administrateur"
                       style="-fx-font-size: 10px; -fx-text-fill: #A78BFA;
                              -fx-font-family: 'Segoe UI';"/>
            </VBox>

            <!-- Section label -->
            <Label text="MENU PRINCIPAL"
                   style="-fx-font-size: 9px; -fx-font-weight: bold;
                          -fx-text-fill: #6366F1; -fx-font-family: 'Segoe UI';
                          -fx-padding: 16 0 8 20; -fx-letter-spacing: 1px;"/>

            <!-- ── Bouton Dashboard (nouveau) ─────────────── -->
            <Button fx:id="btnDashboard"
                    text="📊   Dashboard"
                    onAction="#afficherDashboard"
                    maxWidth="Infinity"
                    style="-fx-background-color: #4F46E5; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                           -fx-font-weight: bold; -fx-pref-height: 46;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 20;
                           -fx-cursor: hand; -fx-background-radius: 0;
                           -fx-border-color: transparent transparent transparent #A78BFA;
                           -fx-border-width: 0 0 0 3;"/>

            <Button fx:id="btnGestionUsers"
                    text="👥   Gestion Utilisateurs"
                    onAction="#afficherGestion"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #C4B5FD;
                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                           -fx-pref-height: 46; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 0 0 0 23; -fx-cursor: hand;
                           -fx-background-radius: 0;"/>

            <Button fx:id="btnDemandes"
                    text="📋   Demandes en attente"
                    onAction="#afficherDemandes"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #C4B5FD;
                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                           -fx-pref-height: 46; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 0 0 0 23; -fx-cursor: hand;
                           -fx-background-radius: 0;"/>

            <Button fx:id="btnProfil"
                    text="👤   Mon Profil"
                    onAction="#afficherProfil"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #C4B5FD;
                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                           -fx-pref-height: 46; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 0 0 0 23; -fx-cursor: hand;
                           -fx-background-radius: 0;"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Region prefHeight="1" style="-fx-background-color: #2D2A5E;"/>

            <Button fx:id="btnDeconnexion"
                    text="🚪   Déconnexion"
                    onAction="#seDeconnecter"
                    maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #FCA5A5;
                           -fx-font-size: 13px; -fx-font-family: 'Segoe UI';
                           -fx-pref-height: 46; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 0 0 0 23; -fx-cursor: hand;
                           -fx-background-radius: 0;"/>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════════════════════
         TOP — Navbar
         ══════════════════════════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" prefHeight="64"
              style="-fx-background-color: white; -fx-padding: 0 24;
                     -fx-border-color: transparent transparent #E5E7EB transparent;
                     -fx-border-width: 0 0 1 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 6, 0, 0, 2);">
            <VBox spacing="2">
                <Label text="Pages / Administration"
                       style="-fx-font-size: 10px; -fx-text-fill: #9CA3AF;
                              -fx-font-family: 'Segoe UI';"/>
                <Label text="Dashboard Admin"
                       style="-fx-font-size: 15px; -fx-font-weight: bold;
                              -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_LEFT" spacing="8" prefHeight="36" prefWidth="240"
                  style="-fx-background-color: #F3F0FF; -fx-background-radius: 20;
                         -fx-padding: 0 14; -fx-border-color: #E9D5FF;
                         -fx-border-radius: 20; -fx-border-width: 1;">
                <Label text="🔍" style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;"/>
                <TextField fx:id="navRechercheField"
                           promptText="Rechercher un utilisateur..."
                           style="-fx-background-color: transparent;
                                  -fx-border-color: transparent;
                                  -fx-font-size: 12px; -fx-font-family: 'Segoe UI';"
                           prefWidth="190"/>
            </HBox>
            <Button text="🔔"
                    style="-fx-background-color: #F3F0FF; -fx-font-size: 15px;
                           -fx-cursor: hand; -fx-background-radius: 50;
                           -fx-min-width: 36; -fx-min-height: 36; -fx-padding: 0;"/>
        </HBox>
    </top>

    <!-- ══════════════════════════════════════════════════════════════
         CENTRE — Contenu
         ══════════════════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #F8F7FF; -fx-background: #F8F7FF;
                           -fx-border-color: transparent;">
            <VBox spacing="0" style="-fx-padding: 28;">

                <!-- ════════════════════════════════════════════════
                     PANNEAU DASHBOARD ADMIN — STATISTIQUES
                     ════════════════════════════════════════════════ -->
                <VBox fx:id="panneauDashboard" spacing="24">

                    <!-- En-tête -->
                    <VBox spacing="4">
                        <Label text="📊  Dashboard Admin"
                               style="-fx-font-size: 22px; -fx-font-weight: bold;
                                      -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                        <Label text="Vue d'ensemble de la plateforme UniMind."
                               style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;
                                      -fx-font-family: 'Segoe UI';"/>
                    </VBox>

                    <!-- ── Cartes statistiques ────────────────────── -->
                    <HBox spacing="16">

                        <!-- Total utilisateurs -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-padding: 20;
                                     -fx-background-radius: 14;
                                     -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                     -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="👥"
                                       style="-fx-font-size: 22px;
                                              -fx-background-color: #EDE9FE;
                                              -fx-background-radius: 10;
                                              -fx-padding: 8 10;"/>
                                <VBox spacing="2">
                                    <Label text="Total utilisateurs"
                                           style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;
                                                  -fx-font-family: 'Segoe UI';"/>
                                    <Label fx:id="statTotalUsers" text="0"
                                           style="-fx-font-size: 28px; -fx-font-weight: bold;
                                                  -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                                </VBox>
                            </HBox>
                            <Label text="Tous rôles confondus"
                                   style="-fx-font-size: 10px; -fx-text-fill: #C4B5FD;
                                          -fx-font-family: 'Segoe UI';"/>
                        </VBox>

                        <!-- Actifs -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-padding: 20;
                                     -fx-background-radius: 14;
                                     -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                     -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="✅"
                                       style="-fx-font-size: 22px;
                                              -fx-background-color: #D1FAE5;
                                              -fx-background-radius: 10;
                                              -fx-padding: 8 10;"/>
                                <VBox spacing="2">
                                    <Label text="Comptes actifs"
                                           style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;
                                                  -fx-font-family: 'Segoe UI';"/>
                                    <Label fx:id="statActifs" text="0"
                                           style="-fx-font-size: 28px; -fx-font-weight: bold;
                                                  -fx-text-fill: #059669; -fx-font-family: 'Segoe UI';"/>
                                </VBox>
                            </HBox>
                            <Label text="Statut actif confirmé"
                                   style="-fx-font-size: 10px; -fx-text-fill: #6EE7B7;
                                          -fx-font-family: 'Segoe UI';"/>
                        </VBox>

                        <!-- En attente -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-padding: 20;
                                     -fx-background-radius: 14;
                                     -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                     -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="⏳"
                                       style="-fx-font-size: 22px;
                                              -fx-background-color: #FEF9C3;
                                              -fx-background-radius: 10;
                                              -fx-padding: 8 10;"/>
                                <VBox spacing="2">
                                    <Label text="En attente"
                                           style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;
                                                  -fx-font-family: 'Segoe UI';"/>
                                    <Label fx:id="statEnAttente" text="0"
                                           style="-fx-font-size: 28px; -fx-font-weight: bold;
                                                  -fx-text-fill: #D97706; -fx-font-family: 'Segoe UI';"/>
                                </VBox>
                            </HBox>
                            <Label text="Inscription à valider"
                                   style="-fx-font-size: 10px; -fx-text-fill: #FDE68A;
                                          -fx-font-family: 'Segoe UI';"/>
                        </VBox>

                        <!-- Bloqués -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-padding: 20;
                                     -fx-background-radius: 14;
                                     -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                     -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🔒"
                                       style="-fx-font-size: 22px;
                                              -fx-background-color: #FEE2E2;
                                              -fx-background-radius: 10;
                                              -fx-padding: 8 10;"/>
                                <VBox spacing="2">
                                    <Label text="Comptes bloqués"
                                           style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;
                                                  -fx-font-family: 'Segoe UI';"/>
                                    <Label fx:id="statBloques" text="0"
                                           style="-fx-font-size: 28px; -fx-font-weight: bold;
                                                  -fx-text-fill: #DC2626; -fx-font-family: 'Segoe UI';"/>
                                </VBox>
                            </HBox>
                            <Label text="Accès restreint"
                                   style="-fx-font-size: 10px; -fx-text-fill: #FCA5A5;
                                          -fx-font-family: 'Segoe UI';"/>
                        </VBox>
                    </HBox>

                    <!-- ── Graphiques ligne 1 ─────────────────────── -->
                    <HBox spacing="16">

                        <!-- Donut — Rôles -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-padding: 20;
                                     -fx-background-radius: 14;
                                     -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                     -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="🎯" style="-fx-font-size: 14px;"/>
                                <Label text="Répartition par Rôle"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold;
                                              -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                            </HBox>
                            <Region prefHeight="1" style="-fx-background-color: #F3F4F6;"/>
                            <Canvas fx:id="canvasRoles" width="480" height="220"/>
                        </VBox>

                        <!-- Barres — Statuts -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-padding: 20;
                                     -fx-background-radius: 14;
                                     -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                     -fx-border-width: 1;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="📊" style="-fx-font-size: 14px;"/>
                                <Label text="Répartition par Statut"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold;
                                              -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                            </HBox>
                            <Region prefHeight="1" style="-fx-background-color: #F3F4F6;"/>
                            <Canvas fx:id="canvasStatuts" width="440" height="220"/>
                        </VBox>
                    </HBox>

                    <!-- ── Graphique ligne 2 — Évolution ─────────── -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-padding: 20;
                                 -fx-background-radius: 14;
                                 -fx-border-color: #E5E7EB; -fx-border-radius: 14;
                                 -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 3);">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📈" style="-fx-font-size: 14px;"/>
                            <Label text="Évolution des inscriptions (7 derniers jours)"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                                          -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                        </HBox>
                        <Region prefHeight="1" style="-fx-background-color: #F3F4F6;"/>
                        <Canvas fx:id="canvasEvolution" width="1100" height="200"/>
                    </VBox>

                </VBox><!-- fin panneauDashboard -->

                <!-- ════════════════════════════════════════════════
                     PANNEAU GESTION UTILISATEURS
                     ════════════════════════════════════════════════ -->
                <VBox fx:id="panneauGestion" spacing="20"
                      visible="false" managed="false">

                    <!-- En-tête -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <VBox spacing="3">
                            <Label text="Gestion des Utilisateurs"
                                   style="-fx-font-size: 22px; -fx-font-weight: bold;
                                          -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                            <Label text="Gérez, modifiez et contrôlez tous les comptes."
                                   style="-fx-font-size: 12px; -fx-text-fill: #9CA3AF;
                                          -fx-font-family: 'Segoe UI';"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="➕  Ajouter un utilisateur"
                                onAction="#ouvrirModalAjout"
                                style="-fx-background-color: linear-gradient(to right, #4F46E5, #7C3AED);
                                       -fx-text-fill: white; -fx-cursor: hand;
                                       -fx-background-radius: 10; -fx-padding: 10 20;
                                       -fx-font-weight: bold; -fx-font-size: 13px;
                                       -fx-font-family: 'Segoe UI';
                                       -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.35), 8, 0, 0, 3);"/>
                    </HBox>

                    <!-- ── Barre de filtres avancés ──────────────── -->
                    <VBox spacing="12"
                          style="-fx-background-color: white; -fx-padding: 16 20;
                                 -fx-background-radius: 12;
                                 -fx-border-color: #E5E7EB; -fx-border-radius: 12;
                                 -fx-border-width: 1;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);">

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="🔎" style="-fx-font-size: 13px;"/>
                            <Label text="Filtres avancés"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold;
                                          -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                        </HBox>

                        <HBox spacing="12" alignment="CENTER_LEFT">

                            <!-- Filtre Rôle -->
                            <VBox spacing="4">
                                <Label text="Rôle"
                                       style="-fx-font-size: 11px; -fx-font-weight: bold;
                                              -fx-text-fill: #6B7280; -fx-font-family: 'Segoe UI';"/>
                                <ComboBox fx:id="filtreRole"
                                          style="-fx-background-radius: 8;
                                                 -fx-border-color: #DDD6FE;
                                                 -fx-border-radius: 8; -fx-border-width: 1.5;
                                                 -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                                 -fx-pref-width: 175; -fx-pref-height: 34;"
                                          onAction="#appliquerFiltres">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Tous les rôles"/>
                                            <String fx:value="Admin"/>
                                            <String fx:value="Etudiant"/>
                                            <String fx:value="Psychologue"/>
                                            <String fx:value="Responsable Etudiant"/>
                                        </FXCollections>
                                    </items>
                                    <value><String fx:value="Tous les rôles"/></value>
                                </ComboBox>
                            </VBox>

                            <!-- Filtre Statut -->
                            <VBox spacing="4">
                                <Label text="Statut"
                                       style="-fx-font-size: 11px; -fx-font-weight: bold;
                                              -fx-text-fill: #6B7280; -fx-font-family: 'Segoe UI';"/>
                                <ComboBox fx:id="filtreStatut"
                                          style="-fx-background-radius: 8;
                                                 -fx-border-color: #DDD6FE;
                                                 -fx-border-radius: 8; -fx-border-width: 1.5;
                                                 -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                                 -fx-pref-width: 175; -fx-pref-height: 34;"
                                          onAction="#appliquerFiltres">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Tous les statuts"/>
                                            <String fx:value="actif"/>
                                            <String fx:value="en_attente"/>
                                            <String fx:value="bloqué"/>
                                            <String fx:value="inactif"/>
                                        </FXCollections>
                                    </items>
                                    <value><String fx:value="Tous les statuts"/></value>
                                </ComboBox>
                            </VBox>

                            <!-- Filtre Actif/Inactif -->
                            <VBox spacing="4">
                                <Label text="Activation"
                                       style="-fx-font-size: 11px; -fx-font-weight: bold;
                                              -fx-text-fill: #6B7280; -fx-font-family: 'Segoe UI';"/>
                                <ComboBox fx:id="filtreActif"
                                          style="-fx-background-radius: 8;
                                                 -fx-border-color: #DDD6FE;
                                                 -fx-border-radius: 8; -fx-border-width: 1.5;
                                                 -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                                 -fx-pref-width: 140; -fx-pref-height: 34;"
                                          onAction="#appliquerFiltres">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <String fx:value="Tous"/>
                                            <String fx:value="Actif"/>
                                            <String fx:value="Inactif"/>
                                        </FXCollections>
                                    </items>
                                    <value><String fx:value="Tous"/></value>
                                </ComboBox>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <!-- Résultats + Réinitialiser -->
                            <VBox spacing="4" alignment="CENTER_RIGHT">
                                <Label fx:id="labelNbResultats"
                                       style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;
                                              -fx-font-family: 'Segoe UI';"/>
                                <Button text="↺  Réinitialiser"
                                        onAction="#reinitialiserFiltres"
                                        style="-fx-background-color: #F3F4F6;
                                               -fx-text-fill: #374151; -fx-cursor: hand;
                                               -fx-background-radius: 8; -fx-padding: 6 14;
                                               -fx-font-size: 12px; -fx-font-family: 'Segoe UI';
                                               -fx-border-color: #D1D5DB; -fx-border-radius: 8;
                                               -fx-border-width: 1;"/>
                            </VBox>
                        </HBox>

                        <!-- Chips de filtres rapides par rôle -->
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Accès rapide :"
                                   style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;
                                          -fx-font-family: 'Segoe UI';"/>

                            <Button text="🟣 Admins"
                                    style="-fx-background-color: #EDE9FE; -fx-text-fill: #6D28D9;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-cursor: hand; -fx-background-radius: 20;
                                           -fx-padding: 4 12; -fx-font-family: 'Segoe UI';"
                                    onAction="#filtrerAdmins"/>
                            <Button text="🔵 Étudiants"
                                    style="-fx-background-color: #DBEAFE; -fx-text-fill: #1D4ED8;
