<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.participation.AjoutParticipationDialogController"
      spacing="16" styleClass="card-white" style="-fx-padding: 24; -fx-min-width: 500; -fx-max-width: 500;">

    <!-- Titre du Dialog -->
    <Label text="📝 Inscrire un étudiant" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #667eea;" />

    <!-- Événement -->
    <VBox spacing="6">
        <Label text="Événement *" styleClass="form-label" />
        <ComboBox fx:id="comboEvenement" promptText="Sélectionner l'événement" prefWidth="450" styleClass="form-input" />
        <Label fx:id="lblErreurEvenementId" text="Obligatoire" styleClass="error-label" visible="false" />
        <Label fx:id="lblErreurCapacite" text="Cet événement a atteint sa capacité maximale" styleClass="error-label" visible="false" />
    </VBox>

    <!-- Étudiant -->
    <VBox spacing="6">
        <Label text="Étudiant *" styleClass="form-label" />
        <ComboBox fx:id="comboEtudiant" promptText="Sélectionner l'étudiant" prefWidth="450" styleClass="form-input" />
        <Label fx:id="lblErreurEtudiantId" text="Obligatoire" styleClass="error-label" visible="false" />
        <Label fx:id="lblErreurUnicite" text="Cette participation existe déjà" styleClass="error-label" visible="false" />
    </VBox>

    <!-- Date et Statut sur une ligne -->
    <HBox spacing="16">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Date d'inscription" styleClass="form-label" />
            <DatePicker fx:id="dateInscription" prefWidth="215" styleClass="form-input" />
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Statut *" styleClass="form-label" />
            <ComboBox fx:id="comboStatut" prefWidth="215" styleClass="form-input" />
        </VBox>
    </HBox>

    <!-- Boutons -->
    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 16 0 0 0;">
        <Button text="❌ Annuler" onAction="#annuler" styleClass="btn-secondary" />
        <Button text="💾 Enregistrer" onAction="#enregistrer" styleClass="btn-primary" />
    </HBox>

    <!-- Message succès -->
    <Label fx:id="lblSucces" text="✅ Participation ajoutée avec succès !"
           style="-fx-text-fill: #27ae60; -fx-font-size: 13px; -fx-font-weight: bold;" visible="false" />

</VBox>
