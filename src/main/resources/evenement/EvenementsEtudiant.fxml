<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.evenement.EvenementsEtudiantController"
      stylesheets="@../styles/etudiant.css"
      spacing="16" styleClass="etudiant-content" maxWidth="Infinity">

    <children>
        <VBox spacing="12" styleClass="etudiant-page" maxWidth="Infinity">
            <children>
                <VBox spacing="6" styleClass="page-header">
                    <children>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <children>
                                <Label text="Événements" styleClass="page-title" />
                                <Label text="UniMind" styleClass="page-title-accent" />
                            </children>
                        </HBox>
                        <Label text="Liste des événements" styleClass="page-subtitle" />
                    </children>
                </VBox>

                <VBox spacing="12" styleClass="card-surface">
                    <children>
                        <GridPane hgap="12" vgap="10" styleClass="filter-grid">
                            <children>
                                <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2">
                                    <children>
                                        <Label text="Recherche" styleClass="form-label" />
                                        <TextField fx:id="txtRecherche" promptText="Titre, description, lieu" styleClass="form-input" />
                                    </children>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="Type" styleClass="form-label" />
                                        <ComboBox fx:id="comboType" promptText="Tous" styleClass="filter-combo" />
                                    </children>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="Statut" styleClass="form-label" />
                                        <ComboBox fx:id="comboStatut" promptText="Tous" styleClass="filter-combo" />
                                    </children>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="4" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="Du" styleClass="form-label" />
                                        <DatePicker fx:id="dateDu" styleClass="form-input" />
                                    </children>
                                </VBox>

                                <VBox spacing="6" GridPane.columnIndex="5" GridPane.rowIndex="0">
                                    <children>
                                        <Label text="Au" styleClass="form-label" />
                                        <DatePicker fx:id="dateAu" styleClass="form-input" />
                                    </children>
                                </VBox>

                                <HBox spacing="10" alignment="CENTER_LEFT" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="6">
                                    <children>
                                        <Button text="Filtrer" onAction="#appliquerFiltres" styleClass="btn-primary" />
                                        <Button text="Réinitialiser" onAction="#reinitialiserFiltres" styleClass="btn-secondary" />
                                    </children>
                                </HBox>
                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <VBox spacing="12" styleClass="card-surface" maxWidth="Infinity">
                    <children>
                        <HBox alignment="CENTER_LEFT" styleClass="card-header">
                            <children>
                                <Label text="Événements à venir" styleClass="section-title" />
                            </children>
                        </HBox>

                        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" styleClass="event-scroll">
                            <content>
                                <VBox spacing="0" maxWidth="Infinity" fillWidth="true">
                                    <padding>
                                        <Insets topRightBottomLeft="20"/>
                                    </padding>
                                    <children>
                                        <StackPane maxWidth="Infinity">
                                            <children>
                                                <TilePane fx:id="tileEvenements" hgap="30" vgap="30" styleClass="event-tile-pane" prefTileWidth="340" prefTileHeight="440" maxWidth="Infinity" />
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <HBox spacing="16" alignment="CENTER">
                            <children>
                                <Label fx:id="lblTotal" text="0 événements" styleClass="total-label"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>

</VBox>
