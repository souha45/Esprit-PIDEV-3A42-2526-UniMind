<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.evenement.ModificationEvenementController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
            <children>
                <Label text="MODIFICATION ÉVÉNEMENT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="🔙 Retour" onAction="#retour" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" />
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="15" alignment="TOP_CENTER" style="-fx-padding: 30;">
                <children>
                    <VBox spacing="5">
                        <children>
                            <Label text="Titre *" style="-fx-font-weight: bold;" />
                            <TextField fx:id="txtTitre" promptText="Titre de l'événement" prefWidth="400" />
                            <Label fx:id="lblErreurTitre" text="Le titre est obligatoire"
                                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                            <Label fx:id="lblErreurUnicite" text="Un événement avec ce titre et cette date existe déjà"
                                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                        </children>
                    </VBox>

                    <VBox spacing="5">
                        <children>
                            <Label text="Description" style="-fx-font-weight: bold;" />
                            <TextArea fx:id="txtDescription" promptText="Description de l'événement"
                                      prefRowCount="3" prefWidth="400" wrapText="true" />
                        </children>
                    </VBox>

                    <HBox spacing="20" alignment="CENTER">
                        <children>
                            <VBox spacing="5" prefWidth="200">
                                <children>
                                    <Label text="Type *" style="-fx-font-weight: bold;" />
                                    <ComboBox fx:id="comboType" promptText="Type" prefWidth="200" />
                                </children>
                            </VBox>
                            <VBox spacing="5" prefWidth="200">
                                <children>
                                    <Label text="Statut *" style="-fx-font-weight: bold;" />
                                    <ComboBox fx:id="comboStatut" promptText="Statut" prefWidth="200" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <VBox spacing="5">
                        <children>
                            <Label text="Date de début *" style="-fx-font-weight: bold;" />
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <children>
                                    <DatePicker fx:id="dateDebut" promptText="Date de début" prefWidth="250" />
                                    <TextField fx:id="txtHeureDebut" promptText="Heure (HH:mm)" prefWidth="140" />
                                </children>
                            </HBox>
                            <Label fx:id="lblErreurHeureDebut" text="Heure de début invalide (HH:mm)"
                                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                        </children>
                    </VBox>

                    <VBox spacing="5">
                        <children>
                            <Label text="Date de fin *" style="-fx-font-weight: bold;" />
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <children>
                                    <DatePicker fx:id="dateFin" promptText="Date de fin" prefWidth="250" />
                                    <TextField fx:id="txtHeureFin" promptText="Heure (HH:mm)" prefWidth="140" />
                                </children>
                            </HBox>
                            <Label fx:id="lblErreurHeureFin" text="Heure de fin invalide (HH:mm)"
                                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                            <Label fx:id="lblErreurDates" text="La date/heure de fin doit être après la date/heure de début"
                                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                        </children>
                    </VBox>

                    <VBox spacing="5">
                        <children>
                            <Label text="Date limite d'inscription" style="-fx-font-weight: bold;" />
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <children>
                                    <DatePicker fx:id="dateLimiteInscription" promptText="Date limite (optionnel)" prefWidth="250" />
                                    <TextField fx:id="txtHeureLimite" promptText="Heure (HH:mm)" prefWidth="140" />
                                </children>
                            </HBox>
                            <Label fx:id="lblErreurHeureLimite" text="Heure limite invalide (HH:mm)"
                                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                            <Label fx:id="lblErreurDateLimite" text="La date/heure limite doit être avant la date/heure de début"
                                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                        </children>
                    </VBox>

                    <VBox spacing="5">
                        <children>
                            <Label text="Lieu *" style="-fx-font-weight: bold;" />
                            <TextField fx:id="txtLieu" promptText="Lieu de l'événement" prefWidth="400" />
                            <Label fx:id="lblErreurLieu" text="Le lieu est obligatoire"
                                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                        </children>
                    </VBox>

                    <VBox spacing="5">
                        <children>
                            <Label text="Capacité maximale *" style="-fx-font-weight: bold;" />
                            <TextField fx:id="txtCapacite" promptText="Nombre maximum de participants" prefWidth="400" />
                            <Label fx:id="lblErreurCapacite" text="La capacité doit être supérieure à 0"
                                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;" visible="false" />
                        </children>
                    </VBox>

                    <VBox fx:id="vboxOrganisateur" spacing="5">
                        <children>
                            <Label text="Organisateur" style="-fx-font-weight: bold;" />
                            <ComboBox fx:id="comboOrganisateur" promptText="Sélectionner l'organisateur" prefWidth="400" />
                        </children>
                    </VBox>

                    <!-- Image -->
                    <VBox spacing="5">
                        <children>
                            <Label text="Image" style="-fx-font-weight: bold;" />
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <children>
                                    <TextField fx:id="txtImage" promptText="Nom du fichier image (ex: mon-image.jpg)" prefWidth="300" />
                                    <Button text="Parcourir" onAction="#parcourirImage" style="-fx-background-color: #3498db; -fx-text-fill: white;" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>

                    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                        <children>
                            <Button text="💾 Enregistrer" onAction="#enregistrerModification"
                                    prefWidth="150" prefHeight="40"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" />
                            <Button text="↩ Annuler" onAction="#retour"
                                    prefWidth="150" prefHeight="40"
                                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" />
                        </children>
                    </HBox>

                    <Label fx:id="lblSucces" text="Modification enregistrée avec succès !"
                           style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 14px;" visible="false" />
                </children>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
