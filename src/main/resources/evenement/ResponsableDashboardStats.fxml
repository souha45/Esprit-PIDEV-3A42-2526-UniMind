<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="24" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="padding-large">
    <children>
        <Label text="Mes Statistiques" styleClass="label-title" />

        <HBox spacing="20" alignment="CENTER">
            <children>
                <VBox spacing="10" styleClass="card card-warning" style="-fx-pref-width: 220;">
                    <children>
                        <Label text="Mes Événements" styleClass="card-title" />
                        <Label fx:id="lblMesEvenements" text="0" styleClass="card-value" />
                    </children>
                </VBox>

                <VBox spacing="10" styleClass="card card-success" style="-fx-pref-width: 220;">
                    <children>
                        <Label text="Événements à venir" styleClass="card-title" />
                        <Label fx:id="lblEvenementsAVenir" text="0" styleClass="card-value" />
                    </children>
                </VBox>

                <VBox spacing="10" styleClass="card card-info" style="-fx-pref-width: 220;">
                    <children>
                        <Label text="Total Participants" styleClass="card-title" />
                        <Label fx:id="lblTotalParticipants" text="0" styleClass="card-value" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox spacing="20" alignment="CENTER">
            <children>
                <VBox spacing="10" styleClass="card card-primary" style="-fx-pref-width: 220;">
                    <children>
                        <Label text="Total Participations" styleClass="card-title" />
                        <Label fx:id="lblTotalParticipations" text="0" styleClass="card-value" />
                    </children>
                </VBox>

                <VBox spacing="10" styleClass="card card-info" style="-fx-pref-width: 220;">
                    <children>
                        <Label text="Sponsors attribués" styleClass="card-title" />
                        <Label fx:id="lblSponsorsAttribues" text="0" styleClass="card-value" />
                    </children>
                </VBox>

                <VBox spacing="10" styleClass="card card-danger" style="-fx-pref-width: 220;">
                    <children>
                        <Label text="Événements annulés" styleClass="card-title" />
                        <Label fx:id="lblEvenementsAnnules" text="0" styleClass="card-value" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
