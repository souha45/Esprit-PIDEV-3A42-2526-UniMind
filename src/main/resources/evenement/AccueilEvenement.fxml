<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="org.example.controllers.evenement.AccueilEvenementController"
      spacing="20" alignment="CENTER" style="-fx-padding: 30;">
    
    <children>
        <!-- Titre principal -->
        <Label text="GESTION DES ÉVÉNEMENTS" 
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        
        <!-- Menu principal -->
        <HBox spacing="15" alignment="CENTER">
            <children>
                <Button text="📅 Gérer les Événements" 
                        prefWidth="200" prefHeight="50"
                        style="-fx-font-size: 14px; -fx-background-color: #3498db; -fx-text-fill: white;"
                        onAction="#gererEvenements"/>
                
                <Button text="👥 Gérer les Participations" 
                        prefWidth="200" prefHeight="50"
                        style="-fx-font-size: 14px; -fx-background-color: #e74c3c; -fx-text-fill: white;"
                        onAction="#gererParticipations"/>
                
                <Button text="🏢 Gérer les Sponsors" 
                        prefWidth="200" prefHeight="50"
                        style="-fx-font-size: 14px; -fx-background-color: #f39c12; -fx-text-fill: white;"
                        onAction="#gererSponsors"/>
                
                <Button text="❤️ Gérer les Favoris" 
                        prefWidth="200" prefHeight="50"
                        style="-fx-font-size: 14px; -fx-background-color: #9b59b6; -fx-text-fill: white;"
                        onAction="#gererFavoris"/>
            </children>
        </HBox>
        
        <!-- Zone d'information -->
        <Separator/>
        <Label text="Module de Gestion des Événements - Unimind" 
               style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
        
        <!-- Bouton quitter -->
        <Button text="🚪 Quitter" 
                prefWidth="150" prefHeight="40"
                style="-fx-font-size: 14px; -fx-background-color: #95a5a6; -fx-text-fill: white;"
                onAction="#quitter"/>
    </children>
</VBox>
