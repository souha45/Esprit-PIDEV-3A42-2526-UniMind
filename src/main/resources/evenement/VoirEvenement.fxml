<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.evenement.VoirEvenementController"
            stylesheets="@../css/EventBack.css"
            styleClass="dashboard-bg">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: #ecf0f1; -fx-padding: 12 18;" BorderPane.alignment="CENTER">
            <children>
                <Label text="DÉTAILS DE L'ÉVÉNEMENT" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="📄 Export PDF" onAction="#exporterPdfEvenement" style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 14; -fx-background-radius: 8;" />
                <Button text="👥 PDF Participants" onAction="#exporterPdfParticipants" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 14; -fx-background-radius: 8;" />
                <Button text="🔙 Retour" onAction="#retour" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 14; -fx-background-radius: 8;" />
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="16" alignment="TOP_CENTER" styleClass="padding-large">
                <children>
                    <VBox spacing="16" styleClass="card-white">
                        <children>
                            <!-- Image -->
                            <VBox spacing="5" alignment="CENTER" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <Label text="Image" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                    <ImageView fx:id="imgEvenement" fitHeight="200" fitWidth="400" preserveRatio="true" />
                                    <Label fx:id="lblPasImage" text="Aucune image" visible="false" style="-fx-text-fill: #95a5a6;" />
                                </children>
                            </VBox>

                            <!-- Titre -->
                            <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <Label text="Titre" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                    <Label fx:id="lblTitre" text="-" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #000000;" />
                                </children>
                            </VBox>

                    <HBox spacing="20" alignment="TOP_LEFT">
                        <children>
                            <!-- Type -->
                            <VBox spacing="5" prefWidth="200" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <Label text="Type" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                    <Label fx:id="lblType" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                                </children>
                            </VBox>

                            <!-- Statut -->
                            <VBox spacing="5" prefWidth="200" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <Label text="Statut" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                    <Label fx:id="lblStatut" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                                </children>
                            </VBox>

                            <!-- Capacité -->
                            <VBox spacing="5" prefWidth="200" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <Label text="Capacité" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                    <Label fx:id="lblCapacite" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <HBox spacing="20" alignment="TOP_LEFT">
                        <children>
                            <!-- Date début -->
                            <VBox spacing="5" prefWidth="250" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <Label text="Date de début" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                    <Label fx:id="lblDateDebut" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                                </children>
                            </VBox>

                            <!-- Date fin -->
                            <VBox spacing="5" prefWidth="250" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <Label text="Date de fin" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                    <Label fx:id="lblDateFin" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- Lieu -->
                    <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                        <children>
                            <Label text="Lieu" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                            <Label fx:id="lblLieu" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                        </children>
                    </VBox>

                    <!-- Carte du lieu -->
                    <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                        <children>
                            <Label text="Localisation" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                            <WebView fx:id="mapView" prefHeight="300" prefWidth="700" />
                        </children>
                    </VBox>

                    <!-- Description -->
                    <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                        <children>
                            <Label text="Description" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                            <TextArea fx:id="txtDescription" prefRowCount="4" prefWidth="700" wrapText="true" editable="false" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #000000;" />
                        </children>
                    </VBox>

                    <!-- Organisateur -->
                    <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                        <children>
                            <Label text="Organisateur" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                            <Label fx:id="lblOrganisateur" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                        </children>
                    </VBox>

                    <!-- Boutons d'action -->
                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                        <children>
                            <Button fx:id="btnParticiper" text="🎯 Participer" onAction="#participer" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 180;" visible="false" />
                            <Label fx:id="lblDejaInscrit" text="✅ Vous êtes déjà inscrit" style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 14px; -fx-min-width: 220;" visible="false" />
                            <Button fx:id="btnFavori" text="⭐ Ajouter aux favoris" onAction="#ajouterFavori" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 220;" visible="false" />
                            <Button fx:id="btnLaisserAvis" text="💬 Laisser un avis" onAction="#laisserAvis" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 180;" visible="false" />
                            <Label fx:id="lblAvisDonne" text="✓ Avis déjà donné" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 10; -fx-font-size: 14px; -fx-font-weight: bold; -fx-min-width: 220; -fx-alignment: CENTER;" visible="false" />
                            <Button fx:id="btnModifier" text="✏️ Modifier" onAction="#modifier" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 16; -fx-min-width: 150; -fx-min-height: 40; -fx-pref-width: 150;" />
                            <Button fx:id="btnSupprimer" text="❌ Supprimer" onAction="#supprimer" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 10 16; -fx-min-width: 150; -fx-min-height: 40; -fx-pref-width: 150;" />
                        </children>
                    </HBox>

                            <!-- Section Avis -->
                            <VBox spacing="12" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <children>
                                            <Label text="Avis des participants" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 16px;" />
                                            <Label fx:id="lblNoteMoyenne" text="⭐ 0.0/5" style="-fx-text-fill: #f39c12; -fx-font-weight: bold;" />
                                            <Label fx:id="lblNbAvis" text="(0 avis)" style="-fx-text-fill: #95a5a6;" />
                                        </children>
                                    </HBox>
                                    <ScrollPane prefHeight="200" fitToWidth="true">
                                        <VBox fx:id="vboxAvis" spacing="10">
                                            <children>
                                                <Label fx:id="lblAucunAvis" text="Aucun avis pour le moment" style="-fx-text-fill: #95a5a6; -fx-font-style: italic;" />
                                            </children>
                                        </VBox>
                                    </ScrollPane>
                                </children>
                            </VBox>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
