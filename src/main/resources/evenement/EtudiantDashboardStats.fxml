<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="24" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="padding-large">
    <children>
        <Label text="Bienvenue !" styleClass="label-title" />

        <HBox spacing="20" alignment="CENTER">
            <children>
                <VBox spacing="10" styleClass="card card-info" style="-fx-pref-width: 220;">
                    <children>
                        <Label text="Événements disponibles" styleClass="card-title" />
                        <Label fx:id="lblEvenementsDisponibles" text="0" styleClass="card-value" />
                    </children>
                </VBox>

                <VBox spacing="10" styleClass="card card-success" style="-fx-pref-width: 220;">
                    <children>
                        <Label text="Mes participations" styleClass="card-title" />
                        <Label fx:id="lblMesParticipations" text="0" styleClass="card-value" />
                    </children>
                </VBox>

                <VBox spacing="10" styleClass="card card-warning" style="-fx-pref-width: 220;">
                    <children>
                        <Label text="Mes favoris" styleClass="card-title" />
                        <Label fx:id="lblMesFavoris" text="0" styleClass="card-value" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
