<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ModifierDisponibiliteController"
      spacing="0"
      prefWidth="500" prefHeight="600"
      maxWidth="500" maxHeight="600"
      style="-fx-background-color: #f0f4ff;">

    <!-- Header -->
    <VBox style="-fx-background-color: linear-gradient(to bottom right, #6366f1, #8b5cf6);
                 -fx-padding: 20 24 18 24;" spacing="3">
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="&#x270f;&#xfe0f;  Modifier la disponibilité"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 17px;
                              -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                <Label text="Modifiez un créneau existant"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                              -fx-text-fill: rgba(255,255,255,0.75);" />
            </VBox>
            <Button fx:id="btnFermer" text="&#xd7;"
                    style="-fx-background-color: rgba(255,255,255,0.18); -fx-text-fill: #ffffff;
                           -fx-font-size: 13px; -fx-padding: 5 10; -fx-background-radius: 8;
                           -fx-cursor: hand; -fx-border-width: 0;" />
        </HBox>
    </VBox>

    <!-- Body -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                VBox.vgrow="ALWAYS" style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox spacing="14" style="-fx-padding: 22 24 16 24; -fx-background-color: #f0f4ff;">

            <!-- Date -->
            <VBox spacing="4">
                <Label text="&#x1f4c5;  Date de disponibilité  *"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                          -fx-font-weight: bold; -fx-text-fill: #6366f1;" />
                <DatePicker fx:id="datePicker"
                            promptText="Sélectionnez une date"
                            maxWidth="Infinity"
                            style="-fx-background-color: #f5f3ff; -fx-border-color: #e0e7ff;
                               -fx-border-radius: 10; -fx-background-radius: 10;
                               -fx-border-width: 1; -fx-font-family: 'Segoe UI';
                               -fx-font-size: 13px; -fx-pref-height: 38px;" />
                <Label fx:id="errDate" text=""
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                          -fx-text-fill: #ef4444;" visible="false" managed="false" />
            </VBox>

            <!-- Heure début -->
            <VBox spacing="4">
                <Label text="&#x1f550;  Heure de début  *"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                          -fx-font-weight: bold; -fx-text-fill: #6366f1;" />
                <HBox spacing="8" alignment="CENTER_LEFT">

                    <!-- Spinner Heure -->
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Heure"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px;
                                  -fx-text-fill: #9ca3af;" />
                        <Spinner fx:id="spinnerHeureDebut"
                                 min="0" max="23" initialValue="-1"
                                 prefWidth="80" prefHeight="38"
                                 style="-fx-background-color: #f5f3ff; -fx-border-color: #e0e7ff;
                                    -fx-border-radius: 10; -fx-background-radius: 10;
                                    -fx-border-width: 1; -fx-font-family: 'Segoe UI';
                                    -fx-font-size: 14px;" />
                    </VBox>

                    <Label text=":"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-text-fill: #6366f1; -fx-padding: 14 0 0 0;" />

                    <!-- Spinner Minute -->
                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Minute"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px;
                                  -fx-text-fill: #9ca3af;" />
                        <Spinner fx:id="spinnerMinuteDebut"
                                 min="0" max="59" initialValue="-1"
                                 prefWidth="80" prefHeight="38"
                                 style="-fx-background-color: #f5f3ff; -fx-border-color: #e0e7ff;
                                    -fx-border-radius: 10; -fx-background-radius: 10;
                                    -fx-border-width: 1; -fx-font-family: 'Segoe UI';
                                    -fx-font-size: 14px;" />
                    </VBox>

                    <Label fx:id="lblPreviewDebut" text="--:--"
                           style="-fx-background-color: #ede9fe; -fx-text-fill: #6366f1;
                              -fx-font-family: 'Segoe UI'; -fx-font-size: 14px;
                              -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 20;
                              -fx-padding-top: 16;" />
                </HBox>
                <Label fx:id="errHeureDebut" text=""
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                          -fx-text-fill: #ef4444;" visible="false" managed="false" />
            </VBox>

            <!-- Heure fin -->
            <VBox spacing="4">
                <Label text="&#x1f551;  Heure de fin  *"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                          -fx-font-weight: bold; -fx-text-fill: #6366f1;" />
                <HBox spacing="8" alignment="CENTER_LEFT">

                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Heure"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px;
                                  -fx-text-fill: #9ca3af;" />
                        <Spinner fx:id="spinnerHeureFin"
                                 min="0" max="23" initialValue="-1"
                                 prefWidth="80" prefHeight="38"
                                 style="-fx-background-color: #f5f3ff; -fx-border-color: #e0e7ff;
                                    -fx-border-radius: 10; -fx-background-radius: 10;
                                    -fx-border-width: 1; -fx-font-family: 'Segoe UI';
                                    -fx-font-size: 14px;" />
                    </VBox>

                    <Label text=":"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-text-fill: #6366f1; -fx-padding: 14 0 0 0;" />

                    <VBox spacing="2" alignment="CENTER">
                        <Label text="Minute"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px;
                                  -fx-text-fill: #9ca3af;" />
                        <Spinner fx:id="spinnerMinuteFin"
                                 min="0" max="59" initialValue="-1"
                                 prefWidth="80" prefHeight="38"
                                 style="-fx-background-color: #f5f3ff; -fx-border-color: #e0e7ff;
                                    -fx-border-radius: 10; -fx-background-radius: 10;
                                    -fx-border-width: 1; -fx-font-family: 'Segoe UI';
                                    -fx-font-size: 14px;" />
                    </VBox>

                    <Label fx:id="lblPreviewFin" text="--:--"
                           style="-fx-background-color: #ede9fe; -fx-text-fill: #6366f1;
                              -fx-font-family: 'Segoe UI'; -fx-font-size: 14px;
                              -fx-font-weight: bold; -fx-padding: 6 14; -fx-background-radius: 20;
                              -fx-padding-top: 16;" />
                </HBox>
                <Label fx:id="errHeureFin" text=""
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                          -fx-text-fill: #ef4444;" visible="false" managed="false" />
            </VBox>

            <!-- Type consultation -->
            <VBox spacing="4">
                <Label text="&#x1f4ac;  Type de consultation  *"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                          -fx-font-weight: bold; -fx-text-fill: #6366f1;" />
                <ComboBox fx:id="cbTypeConsult"
                          promptText="-- Sélectionnez un type --"
                          maxWidth="Infinity"
                          style="-fx-background-color: #f5f3ff; -fx-border-color: #e0e7ff;
                             -fx-border-radius: 10; -fx-background-radius: 10;
                             -fx-border-width: 1; -fx-font-family: 'Segoe UI';
                             -fx-font-size: 13px; -fx-pref-height: 38px; -fx-cursor: hand;">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Présentiel" />
                            <String fx:value="En ligne" />
                        </FXCollections>
                    </items>
                </ComboBox>
                <Label fx:id="errType" text=""
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                          -fx-text-fill: #ef4444;" visible="false" managed="false" />
            </VBox>

            <!-- Lieu (conditionnel) -->
            <!-- Lieu (conditionnel) avec bouton carte -->
            <VBox fx:id="boxLieu" spacing="4" visible="false" managed="false">
                <Label text="📍  Lieu de consultation  *"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                  -fx-font-weight: bold; -fx-text-fill: #6366f1;" />
                <HBox spacing="10">
                    <TextField fx:id="txtLieu"
                               promptText="Ex : Salle 12, Bâtiment A, Campus..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #f5f3ff; -fx-border-color: #e0e7ff;
                          -fx-border-radius: 10; -fx-background-radius: 10;
                          -fx-border-width: 1; -fx-font-family: 'Segoe UI';
                          -fx-font-size: 13px; -fx-text-fill: #374151;
                          -fx-prompt-text-fill: #c4b5fd; -fx-padding: 10 14;
                          -fx-pref-height: 38px;" />
                    <Button fx:id="btnOuvrirCarte" text="🌍 Carte"
                            style="-fx-background-color: #6366f1; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-padding: 8 15; -fx-background-radius: 8;
                       -fx-cursor: hand;" />
                </HBox>
                <Label fx:id="errLieu" text=""
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                  -fx-text-fill: #ef4444;" visible="false" managed="false" />
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- Footer -->
    <HBox alignment="CENTER_RIGHT" spacing="10"
          style="-fx-padding: 14 24; -fx-background-color: #ffffff;
                 -fx-border-color: #e0e7ff; -fx-border-width: 1 0 0 0;">
        <Button fx:id="btnAnnuler" text="Annuler"
                style="-fx-background-color: #f3f4f6; -fx-text-fill: #6b7280;
                       -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                       -fx-padding: 10 22; -fx-background-radius: 10;
                       -fx-border-color: #e5e7eb; -fx-border-width: 1; -fx-border-radius: 10;
                       -fx-cursor: hand;" />
        <Button fx:id="btnEnregistrer" text="&#x2713;  Enregistrer les modifications"
                style="-fx-background-color: #6366f1; -fx-text-fill: #ffffff;
                       -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-padding: 10 22; -fx-background-radius: 10; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.35), 8, 0, 0, 2);" />
    </HBox>

</VBox>