<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.sponsor.VoirSponsorController">

    <top>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #ecf0f1;" BorderPane.alignment="CENTER">
            <children>
                <Label text="DÉTAILS DU SPONSOR" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="🔙 Retour" onAction="#retour" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" />
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 30;">
                <children>
                    <!-- Logo -->
                    <VBox spacing="5" alignment="CENTER" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                        <children>
                            <Label text="Logo" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                            <ImageView fx:id="imgLogo" fitHeight="200" fitWidth="400" preserveRatio="true" />
                            <Label fx:id="lblPasLogo" text="Aucun logo" visible="false" style="-fx-text-fill: #95a5a6;" />
                        </children>
                    </VBox>

                    <!-- Nom -->
                    <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                        <children>
                            <Label text="Nom du sponsor" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                            <Label fx:id="lblNom" text="-" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                        </children>
                    </VBox>

                    <HBox spacing="20" alignment="TOP_LEFT">
                        <children>
                            <!-- Type -->
                            <VBox spacing="5" prefWidth="200" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <Label text="Type" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                    <Label fx:id="lblType" text="-" style="-fx-font-size: 14px;" />
                                </children>
                            </VBox>

                            <!-- Statut -->
                            <VBox spacing="5" prefWidth="200" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <Label text="Statut" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                    <Label fx:id="lblStatut" text="-" style="-fx-font-size: 14px;" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <HBox spacing="20" alignment="TOP_LEFT">
                        <children>
                            <!-- Téléphone -->
                            <VBox spacing="5" prefWidth="250" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <Label text="Téléphone" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                    <Label fx:id="lblTelephone" text="-" style="-fx-font-size: 14px;" />
                                </children>
                            </VBox>

                            <!-- Email -->
                            <VBox spacing="5" prefWidth="250" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                                <children>
                                    <Label text="Email" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                                    <Label fx:id="lblEmail" text="-" style="-fx-font-size: 14px;" />
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- Site web -->
                    <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                        <children>
                            <Label text="Site web" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                            <Label fx:id="lblSiteWeb" text="-" style="-fx-font-size: 14px;" />
                        </children>
                    </VBox>

                    <!-- Domaine d'activité -->
                    <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                        <children>
                            <Label text="Domaine d'activité" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                            <Label fx:id="lblDomaine" text="-" style="-fx-font-size: 14px;" />
                        </children>
                    </VBox>

                    <!-- Adresse -->
                    <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 5;">
                        <children>
                            <Label text="Adresse" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;" />
                            <TextArea fx:id="txtAdresse" prefRowCount="3" prefWidth="700" wrapText="true" editable="false" style="-fx-background-color: transparent; -fx-border-color: transparent;" />
                        </children>
                    </VBox>

                    <!-- Boutons d'action -->
                    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20;">
                        <children>
                            <Button fx:id="btnModifier" text="✏️ Modifier" onAction="#modifier" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 150;" />
                            <Button fx:id="btnSupprimer" text="❌ Supprimer" onAction="#supprimer" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 150;" />
                        </children>
                    </HBox>
                </children>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
