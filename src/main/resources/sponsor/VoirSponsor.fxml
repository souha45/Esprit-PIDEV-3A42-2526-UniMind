<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.sponsor.VoirSponsorController"
            stylesheets="@../css/EventBack.css"
            styleClass="dashboard-bg">

    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="topbar" BorderPane.alignment="CENTER">
            <children>
                <Label text="DÉTAILS DU SPONSOR" styleClass="label-subtitle" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="🔙 Retour" onAction="#retour" styleClass="btn-secondary" />
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="16" alignment="TOP_CENTER" styleClass="padding-large">
                <children>
                    <VBox spacing="16" styleClass="card-white">
                        <children>
                            <!-- Logo -->
                            <VBox spacing="8" alignment="CENTER">
                                <children>
                                    <Label text="Logo" styleClass="form-label" />
                                    <ImageView fx:id="imgLogo" fitHeight="200" fitWidth="400" preserveRatio="true" />
                                    <Label fx:id="lblPasLogo" text="Aucun logo" visible="false" styleClass="form-label" />
                                </children>
                            </VBox>

                            <!-- Nom -->
                            <VBox spacing="8">
                                <children>
                                    <Label text="Nom du sponsor" styleClass="form-label" />
                                    <Label fx:id="lblNom" text="-" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #000000;" />
                                </children>
                            </VBox>

                            <HBox spacing="20" alignment="TOP_LEFT">
                                <children>
                                    <!-- Type -->
                                    <VBox spacing="8" prefWidth="200">
                                        <children>
                                            <Label text="Type" styleClass="form-label" />
                                            <Label fx:id="lblType" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                                        </children>
                                    </VBox>

                                    <!-- Statut -->
                                    <VBox spacing="8" prefWidth="200">
                                        <children>
                                            <Label text="Statut" styleClass="form-label" />
                                            <Label fx:id="lblStatut" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>

                            <HBox spacing="20" alignment="TOP_LEFT">
                                <children>
                                    <!-- Téléphone -->
                                    <VBox spacing="8" prefWidth="250">
                                        <children>
                                            <Label text="Téléphone" styleClass="form-label" />
                                            <Label fx:id="lblTelephone" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                                        </children>
                                    </VBox>

                                    <!-- Email -->
                                    <VBox spacing="8" prefWidth="250">
                                        <children>
                                            <Label text="Email" styleClass="form-label" />
                                            <Label fx:id="lblEmail" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>

                            <!-- Site web -->
                            <VBox spacing="8">
                                <children>
                                    <Label text="Site web" styleClass="form-label" />
                                    <Label fx:id="lblSiteWeb" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                                </children>
                            </VBox>

                            <!-- Domaine d'activité -->
                            <VBox spacing="8">
                                <children>
                                    <Label text="Domaine d'activité" styleClass="form-label" />
                                    <Label fx:id="lblDomaine" text="-" style="-fx-font-size: 14px; -fx-text-fill: #000000;" />
                                </children>
                            </VBox>

                            <!-- Adresse -->
                            <VBox spacing="8">
                                <children>
                                    <Label text="Adresse" styleClass="form-label" />
                                    <TextArea fx:id="txtAdresse" prefRowCount="3" prefWidth="700" wrapText="true" editable="false" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #000000;" />
                                </children>
                            </VBox>

                            <!-- Boutons d'action -->
                            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                                <children>
                                    <Button fx:id="btnModifier" text="✏️ Modifier" onAction="#modifier" prefWidth="150" styleClass="btn-primary" />
                                    <Button fx:id="btnSupprimer" text="❌ Supprimer" onAction="#supprimer" prefWidth="150" styleClass="btn-delete" />
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
