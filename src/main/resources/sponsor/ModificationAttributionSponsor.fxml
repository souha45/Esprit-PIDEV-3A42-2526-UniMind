<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.sponsor.ModificationAttributionSponsorController"
            stylesheets="@../css/EventBack.css"
            styleClass="dashboard-bg">

    <top>
        <HBox spacing="16" alignment="CENTER_LEFT" styleClass="topbar" BorderPane.alignment="CENTER">
            <children>
                <Label text="MODIFIER L'ATTRIBUTION DE SPONSOR" styleClass="label-subtitle" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="🔙 Retour" onAction="#annuler" styleClass="btn-secondary" />
            </children>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="16" alignment="TOP_CENTER" styleClass="padding-large">
                <children>
                    <VBox spacing="16" styleClass="card-white">
                        <children>
                            <VBox spacing="8">
                                <Label text="Événement *" styleClass="form-label"/>
                                <ComboBox fx:id="comboEvenement" promptText="Sélectionner un événement" styleClass="form-input"/>
                                <Label fx:id="lblErreurEvenement" text="Veuillez sélectionner un événement" styleClass="error-label" visible="false"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Sponsor *" styleClass="form-label"/>
                                <ComboBox fx:id="comboSponsor" promptText="Sélectionner un sponsor" styleClass="form-input"/>
                                <Label fx:id="lblErreurSponsor" text="Veuillez sélectionner un sponsor" styleClass="error-label" visible="false"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Montant de contribution (DT)" styleClass="form-label"/>
                                <TextField fx:id="txtMontant" promptText="Ex: 5000" styleClass="form-input"/>
                                <Label fx:id="lblErreurMontant" text="Veuillez entrer un montant valide" styleClass="error-label" visible="false"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Type de contribution" styleClass="form-label"/>
                                <ComboBox fx:id="comboType" styleClass="form-input"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Description" styleClass="form-label"/>
                                <TextArea fx:id="txtDescription" promptText="Description de la contribution (optionnel)" prefRowCount="3" styleClass="form-textarea"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Date de contribution" styleClass="form-label"/>
                                <DatePicker fx:id="dateContribution" styleClass="form-input"/>
                                <Label fx:id="lblErreurDateContribution" text="La date de contribution ne peut pas être dans le passé" styleClass="error-label" visible="false"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Statut" styleClass="form-label"/>
                                <ComboBox fx:id="comboStatut" styleClass="form-input"/>
                            </VBox>

                            <Label fx:id="lblSucces" text="Attribution modifiée avec succès !" style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 14px;" visible="false"/>

                            <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                                <Button text="Annuler" onAction="#annuler" styleClass="btn-secondary" prefWidth="150"/>
                                <Button text="Enregistrer" onAction="#enregistrerModification" styleClass="btn-primary" prefWidth="150"/>
                            </HBox>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
