<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@../css/EventBack.css"
      styleClass="dashboard-bg"
      fx:controller="org.example.controllers.sponsor.GestionAttributionSponsorController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <children>
            <HBox spacing="4" styleClass="page-header-container" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                <children>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <children>
                            <Label text="💰 GESTION DES ATTRIBUTIONS DE SPONSORS" styleClass="page-header-title"/>
                            <Label text="Attribuez des sponsors aux événements et suivez les partenariats" styleClass="page-header-subtitle"/>
                        </children>
                    </VBox>
                    <Button text="➕ Nouvelle Attribution" onAction="#ajouterAttribution" styleClass="btn-primary"/>
                    <Button text="📊 Export Excel" onAction="#exporterExcel" styleClass="btn-secondary"/>
                    <Button text="📄 Export PDF" onAction="#exporterPdf" styleClass="btn-secondary"/>
                </children>
            </HBox>
        </children>
    </HBox>

    <!-- Barre de recherche -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8">
            <Label text="🔍" styleClass="search-icon"/>
            <TextField fx:id="txtRecherche" prefWidth="250" promptText="Événement, sponsor..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
        </HBox>
        <Button text="🔍 Rechercher" onAction="#rechercherAttributions" styleClass="btn-primary"/>
        <Button text="🔄" onAction="#reinitialiserRecherche" styleClass="btn-secondary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotal" text="Total : 0" styleClass="form-label"/>
    </HBox>

    <!-- Filtres avancés -->
    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="filter-bar">
        <children>
            <!-- Statut sponsor -->
            <VBox spacing="4">
                <children>
                    <Label text="Statut sponsor" styleClass="form-label"/>
                    <ComboBox fx:id="comboStatut" prefWidth="150" promptText="Tous les statuts"/>
                </children>
            </VBox>

            <!-- Type de contribution -->
            <VBox spacing="4">
                <children>
                    <Label text="Type contribution" styleClass="form-label"/>
                    <ComboBox fx:id="comboType" prefWidth="180" promptText="Tous les types"/>
                </children>
            </VBox>

            <!-- Période -->
            <VBox spacing="4">
                <children>
                    <Label text="Période contribution" styleClass="form-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <children>
                            <DatePicker fx:id="dateDebut" prefWidth="120" promptText="Du"/>
                            <Label text="au" styleClass="form-label"/>
                            <DatePicker fx:id="dateFin" prefWidth="120" promptText="Au"/>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Boutons -->
            <Button text="🔍 Filtrer" onAction="#appliquerFiltres" styleClass="btn-primary"/>
            <Button text="🔄 Réinitialiser" onAction="#reinitialiserFiltres" styleClass="btn-secondary"/>
        </children>
    </HBox>

    <!-- Statistiques -->
    <HBox spacing="16" alignment="CENTER_LEFT" styleClass="stats-bar">
        <children>
            <Label text="Statistiques :" styleClass="stats-label"/>
            <Label fx:id="lblTotalAttributions" text="0 attributions" styleClass="stat-badge stat-total"/>
            <HBox spacing="4" alignment="CENTER">
                <Label text="Montant total :" styleClass="form-label"/>
                <Label fx:id="lblMontantTotal" text="0 DT" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
            </HBox>
            <HBox spacing="4" alignment="CENTER">
                <Region styleClass="legend-color" style="-fx-background-color: #e8f5e9;"/>
                <Label fx:id="lblStatutConfirme" text="0 confirmées" styleClass="stat-badge stat-actif"/>
            </HBox>
            <HBox spacing="4" alignment="CENTER">
                <Region styleClass="legend-color" style="-fx-background-color: #fff3e0;"/>
                <Label fx:id="lblStatutEnAttente" text="0 en attente" styleClass="stat-badge stat-inactif"/>
            </HBox>
            <HBox spacing="4" alignment="CENTER">
                <Region styleClass="legend-color" style="-fx-background-color: #ffebee;"/>
                <Label fx:id="lblStatutRefuse" text="0 refusées" styleClass="stat-badge stat-refuse"/>
            </HBox>
            <HBox spacing="4" alignment="CENTER">
                <Region styleClass="legend-color" style="-fx-background-color: #f5f5f5;"/>
                <Label fx:id="lblStatutAnnule" text="0 annulées" styleClass="stat-badge"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="4" alignment="CENTER">
                <Label text="Top sponsor :" styleClass="form-label"/>
                <Label fx:id="lblTopSponsor" text="-" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>
            </HBox>
        </children>
    </HBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <children>
            <TableView fx:id="tableAttributions" VBox.vgrow="ALWAYS" styleClass="data-table">
                <columns>
                    <TableColumn fx:id="colEvenement" text="Événement" prefWidth="300" sortable="true"/>
                    <TableColumn fx:id="colSponsor" text="Sponsor" prefWidth="150" sortable="true"/>
                    <TableColumn fx:id="colMontant" text="Montant" prefWidth="100" sortable="true"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="120" sortable="true"/>
                    <TableColumn fx:id="colStatut" text="Statut" prefWidth="100" sortable="true"/>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="150" sortable="true"/>
                    <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 6 0 0 0;">
                <children>
                    <Label fx:id="lblPageInfo" text="" styleClass="form-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Pagination fx:id="paginationAttributions" maxPageIndicatorCount="7" prefHeight="40"/>
                </children>
            </HBox>
        </children>
    </VBox>

</VBox>
