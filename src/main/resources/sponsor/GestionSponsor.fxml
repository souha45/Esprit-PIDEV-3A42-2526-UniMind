<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.sponsor.GestionSponsorController"
            stylesheets="@../styles/admin.css"
            styleClass="dashboard-bg">

    <top>
        <VBox spacing="16" styleClass="padding-medium">
            <children>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <Label text="GESTION DES SPONSORS" styleClass="label-subtitle"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="➕ Ajouter" onAction="#ajouterSponsor" styleClass="btn-primary"/>

                        <Button text="🔙 Retour" onAction="#retourAccueil" styleClass="btn-secondary"/>
                    </children>
                </HBox>

                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8">
                            <Label text="🔍" styleClass="search-icon"/>
                            <TextField fx:id="txtRecherche" prefWidth="250" promptText="Nom, email, type..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Button text="🔍 Rechercher" onAction="#rechercherSponsors" styleClass="btn-primary"/>
                        <Button text="🔄 Réinitialiser" onAction="#reinitialiserRecherche" styleClass="btn-secondary"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Total:" styleClass="form-label"/>
                        <Label fx:id="lblTotal" text="0 sponsors" styleClass="form-label"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableSponsors" prefHeight="500" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colEvenement" text="Événement" prefWidth="200"/>
                <TableColumn fx:id="colLogo" text="Logo" prefWidth="80"/>
                <TableColumn fx:id="colNom" text="Sponsor" prefWidth="180"/>
                <TableColumn fx:id="colType" text="Type" prefWidth="120"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                <TableColumn fx:id="colStatut" text="Statut" prefWidth="100"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="200"/>
            </columns>
        </TableView>
    </center>
</BorderPane>
