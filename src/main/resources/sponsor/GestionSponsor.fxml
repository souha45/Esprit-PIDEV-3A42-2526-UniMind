<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.0" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.sponsor.GestionSponsorController"
            stylesheets="@../css/EventBack.css"
            styleClass="dashboard-bg">

    <top>
        <VBox spacing="16" style="-fx-padding: 20;">
            <children>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <HBox spacing="4" styleClass="page-header-container" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="🤝 GESTION DES SPONSORS" styleClass="page-header-title"/>
                                        <Label text="Gérez les sponsors et les partenariats pour vos événements" styleClass="page-header-subtitle"/>
                                    </children>
                                </VBox>

                                <Button text="➕ Ajouter" onAction="#ajouterSponsor" styleClass="btn-primary"/>

                            </children>
                        </HBox>
                    </children>
                </HBox>

                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8">
                            <Label text="🔍" styleClass="search-icon"/>
                            <TextField fx:id="txtRecherche" prefWidth="250" promptText="Nom, email, événement..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Button text="🔍 Rechercher" onAction="#rechercherSponsors" styleClass="btn-primary"/>
                        <Button text="🔄" onAction="#reinitialiserRecherche" styleClass="btn-secondary"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Total:" styleClass="form-label"/>
                        <Label fx:id="lblTotal" text="0 sponsors" styleClass="form-label"/>
                    </children>
                </HBox>

                <!-- Filtres avancés -->
                <HBox spacing="16" alignment="CENTER_LEFT" styleClass="filter-bar">
                    <children>
                        <!-- Type -->
                        <VBox spacing="4">
                            <children>
                                <Label text="Type" styleClass="form-label"/>
                                <ComboBox fx:id="comboType" prefWidth="150" promptText="Tous les types"/>
                            </children>
                        </VBox>

                        <!-- Statut -->
                        <VBox spacing="4">
                            <children>
                                <Label text="Statut" styleClass="form-label"/>
                                <ComboBox fx:id="comboStatut" prefWidth="150" promptText="Tous les statuts"/>
                            </children>
                        </VBox>

                        <!-- Période -->
                        <VBox spacing="4">
                            <children>
                                <Label text="Période" styleClass="form-label"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <children>
                                        <DatePicker fx:id="dateDu" prefWidth="120" promptText="Du"/>
                                        <Label text="au" styleClass="form-label"/>
                                        <DatePicker fx:id="dateAu" prefWidth="120" promptText="Au"/>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Boutons -->
                        <Button text="🔍 Filtrer" onAction="#appliquerFiltres" styleClass="btn-primary"/>
                        <Button text="🔄 Réinitialiser" onAction="#reinitialiserFiltres" styleClass="btn-secondary"/>
                    </children>
                </HBox>

                <HBox spacing="16" alignment="CENTER_LEFT" styleClass="stats-bar">
                    <children>
                        <Label text="Statistiques :" styleClass="stats-label"/>
                        <HBox spacing="4" alignment="CENTER">
                            <Region styleClass="legend-color" style="-fx-background-color: #e8f5e9;"/>
                            <Label fx:id="lblStatutActif" text="0 confirmés" styleClass="stat-badge stat-actif"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER">
                            <Region styleClass="legend-color" style="-fx-background-color: #fff3e0;"/>
                            <Label fx:id="lblStatutInactif" text="0 en attente" styleClass="stat-badge stat-inactif"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER">
                            <Region styleClass="legend-color" style="-fx-background-color: #ffebee;"/>
                            <Label fx:id="lblStatutRefuse" text="0 refusés" styleClass="stat-badge stat-refuse"/>
                        </HBox>
                        <HBox spacing="4" alignment="CENTER">
                            <Region styleClass="legend-color" style="-fx-background-color: #f5f5f5;"/>
                            <Label fx:id="lblStatutAnnule" text="0 annulés" styleClass="stat-badge stat-annule"/>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblTotalSponsors" text="0 sponsors" styleClass="stat-badge stat-total"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 0 20 20 20;">
            <children>
                <TableView fx:id="tableSponsors" prefHeight="500" VBox.vgrow="ALWAYS" styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colEvenement" text="Événement" prefWidth="200" sortable="true"/>
                        <TableColumn fx:id="colLogo" text="Logo" prefWidth="80" sortable="false"/>
                        <TableColumn fx:id="colNom" text="Sponsor" prefWidth="180" sortable="true"/>
                        <TableColumn fx:id="colType" text="Type" prefWidth="120" sortable="true"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="180" sortable="true"/>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="100" sortable="true"/>
                        <TableColumn fx:id="colDate" text="Date" prefWidth="150" sortable="true"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="200" sortable="false"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 6 0 0 0;">
                    <children>
                        <Label fx:id="lblPageInfo" text="" styleClass="form-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Pagination fx:id="paginationSponsors" maxPageIndicatorCount="7" prefHeight="40"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
