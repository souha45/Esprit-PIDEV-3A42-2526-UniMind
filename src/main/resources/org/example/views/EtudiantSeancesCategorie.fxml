<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
  EtudiantSeancesCategorie.fxml — VERSION MODIFIÉE
  Changement principal : la section-container devient un HBox à 3 colonnes :
     [Conseils]  [Séances grid]  [Sons ambiants ← NOUVEAU]
-->
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.EtudiantSeancesCategorieController"
            styleClass="etudiant-scroll"
            stylesheets="/css/etudiant.css"
            fitToWidth="true" hbarPolicy="NEVER">

    <VBox styleClass="etudiant-page" spacing="0">

        <!-- HEADER -->
        <VBox styleClass="page-header">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="🌸 Séances  ›" styleClass="page-title"/>
                <Label fx:id="lblNomCategorie" text="" styleClass="page-title-accent"/>
            </HBox>
            <Label fx:id="lblDescCategorie" text="" styleClass="page-subtitle" wrapText="true"/>
        </VBox>

        <!-- CONTENU PRINCIPAL : 3 colonnes -->
        <HBox styleClass="section-container" spacing="20" alignment="TOP_LEFT">
            <HBox.margin><Insets top="16" right="16" bottom="16" left="16"/></HBox.margin>

            <!-- ① Conseils (largeur fixe) -->
            <VBox styleClass="conseils-card" prefWidth="300" minWidth="220" spacing="10">
                <Label text="💡 Conseils pour une bonne séance" styleClass="conseils-title"/>
                <Separator/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🔇" style="-fx-font-size:16px;"/>
                    <VBox spacing="2">
                        <Label text="Environnement calme" styleClass="conseils-point"/>
                        <Label text="Trouvez un endroit tranquille sans distractions."
                               styleClass="conseils-text" wrapText="true"/>
                    </VBox>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🌸" style="-fx-font-size:16px;"/>
                    <VBox spacing="2">
                        <Label text="Position confortable" styleClass="conseils-point"/>
                        <Label text="Asseyez-vous ou allongez-vous confortablement."
                               styleClass="conseils-text" wrapText="true"/>
                    </VBox>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🌬" style="-fx-font-size:16px;"/>
                    <VBox spacing="2">
                        <Label text="Respiration consciente" styleClass="conseils-point"/>
                        <Label text="Portez attention à votre respiration naturelle."
                               styleClass="conseils-text" wrapText="true"/>
                    </VBox>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🕊" style="-fx-font-size:16px;"/>
                    <VBox spacing="2">
                        <Label text="Acceptation" styleClass="conseils-point"/>
                        <Label text="Accueillez vos pensées sans jugement."
                               styleClass="conseils-text" wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ② Séances grid (s'étire) -->
            <VBox HBox.hgrow="ALWAYS" spacing="12">
                <Label text="🎵 Séances disponibles" styleClass="section-title"/>
                <FlowPane fx:id="seancesGrid" hgap="16" vgap="16"/>
            </VBox>

            <!-- ③ Sons ambiants (injecté dynamiquement via fx:id) -->
            <!--
                Le VBox est créé par buildAmbientPanel() dans le contrôleur.
                On déclare ici un placeholder fx:id="ambientPanelContainer"
                dans lequel le contrôleur injectera le panneau.
            -->
            <VBox fx:id="ambientPanelContainer" prefWidth="260" minWidth="240" spacing="0"
                  alignment="TOP_CENTER"/>

        </HBox>

    </VBox>
</ScrollPane>
