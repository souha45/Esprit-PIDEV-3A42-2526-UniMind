<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controllers.EtudiantSeancesController"
            styleClass="etudiant-scroll"
            stylesheets="/css/etudiant.css"
            fitToWidth="true" hbarPolicy="NEVER">

    <VBox styleClass="etudiant-page" spacing="0">

        <!-- HERO SECTION -->
        <HBox styleClass="hero-section" spacing="20">
            <VBox.margin><Insets top="0"/></VBox.margin>

            <!-- Left: Meditation intro -->
            <VBox styleClass="hero-card hero-card-purple" prefWidth="500" HBox.hgrow="ALWAYS" spacing="12">
                <Label text="🌸 Bienvenue dans l'espace Méditation" styleClass="hero-title"/>
                <Label text="Détendez-vous, méditez et échangez avec la communauté" styleClass="hero-subtitle"/>
                <Separator styleClass="hero-sep"/>
                <Label text="🌟  Améliorez votre bien-être mental" styleClass="hero-point"/>
                <Label text="Accédez à une collection de méditations guidées conçues pour réduire le stress, améliorer la concentration et favoriser le bien-être général. Nos séances sont adaptées à tous les niveaux, du débutant à l'expérimenté."
                       styleClass="hero-text" wrapText="true"/>
            </VBox>

            <!-- Right: Forum intro -->
            <VBox styleClass="hero-card hero-card-teal" prefWidth="360" spacing="12">
                <Label text="💬 Forum Communautaire" styleClass="hero-title"/>
                <Label text="Échangez &amp; Partagez" styleClass="hero-subtitle"/>
                <Separator styleClass="hero-sep"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="💬" style="-fx-font-size:18px;"/>
                    <VBox spacing="2">
                        <Label text="Communauté bienveillante" styleClass="hero-point"/>
                        <Label text="Rejoignez une communauté d'étudiants partageant les mêmes intérêts."
                               styleClass="hero-text" wrapText="true"/>
                    </VBox>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🌟" style="-fx-font-size:18px;"/>
                    <VBox spacing="2">
                        <Label text="Conseils &amp; Astuces" styleClass="hero-point"/>
                        <Label text="Découvrez des conseils pratiques pour améliorer votre pratique."
                               styleClass="hero-text" wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>
        </HBox>

        <!-- CATEGORIES SECTION -->
        <VBox styleClass="section-container" spacing="16">

            <!-- Section header -->
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="🗂 Catégories de Méditation" styleClass="section-title" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Search bar -->
            <HBox styleClass="search-box" alignment="CENTER_LEFT" spacing="8">
                <Label text="🔍" styleClass="search-icon"/>
                <TextField fx:id="tfSearchCat" promptText="Rechercher une catégorie par nom ou description..."
                           styleClass="search-field" HBox.hgrow="ALWAYS"
                           onKeyReleased="#onSearchCategorie"/>
            </HBox>

            <!-- Categories grid -->
            <FlowPane fx:id="categoriesGrid" hgap="16" vgap="16"
                      styleClass="categories-grid"/>
        </VBox>

        <!-- FORUM SECTION -->
        <VBox styleClass="section-container forum-section" spacing="16">

            <!-- Forum header -->
            <HBox alignment="CENTER_LEFT" spacing="16" >
                <Label text="💬 Forum Communautaire — Toutes les discussions"
                       styleClass="section-title" HBox.hgrow="ALWAYS"/>
                <Button text="✏  Nouveau post" styleClass="btn-primary" onAction="#openNewPostDialog"/>
            </HBox>

            <!-- Posts list -->
            <VBox fx:id="postsContainer" spacing="12"/>

            <!-- Load more -->
            <HBox alignment="CENTER">
                <Button fx:id="btnLoadMore" text="↓  Charger plus de discussions"
                        styleClass="btn-load-more" onAction="#loadMorePosts"/>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>
