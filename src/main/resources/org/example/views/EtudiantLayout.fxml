<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.EtudiantLayoutController"
      styleClass="etudiant-root"
      stylesheets="/css/etudiant.css"
      spacing="0">

    <!-- TOP NAVBAR -->
    <HBox styleClass="etudiant-navbar" alignment="CENTER_LEFT" spacing="0">

        <!-- Brand -->
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand">
            <ImageView fitWidth="32" fitHeight="32" preserveRatio="true">
                <image><Image url="@/images/logo-unimind-699da8d841d01925479563.png"/></image>
            </ImageView>
            <Label text="Unimind" styleClass="navbar-brand-name"/>
        </HBox>

        <!-- Scrollable menu -->
        <ScrollPane styleClass="navbar-scroll" HBox.hgrow="ALWAYS"
                    fitToHeight="true" fitToWidth="false"
                    hbarPolicy="NEVER" vbarPolicy="NEVER">
            <HBox styleClass="navbar-menu" alignment="CENTER_LEFT" spacing="2">
                <Button text="📅 Mes Rendez-vous" styleClass="navbar-btn" onAction="#showRendezVous"/>
                <Button text="📋 Consultations" styleClass="navbar-btn" onAction="#showConsultations"/>
                <Button text="💊 Traitements" styleClass="navbar-btn" onAction="#showTraitements"/>
                <Button text="📋 Suivi Traitements" styleClass="navbar-btn" onAction="#showSuiviTraitements"/>
                <Button text="📝 Questionnaires" styleClass="navbar-btn" onAction="#showQuestionnaires"/>
                <Button text="💬 Mes Réponses" styleClass="navbar-btn" onAction="#showMesReponses"/>
                <Button fx:id="btnSeances" text="🌸 Séances Méditation" styleClass="navbar-btn, navbar-btn-active"
                        onAction="#showSeancesMeditation"/>
                <Button text="❤ Mes Favoris Séances" styleClass="navbar-btn" onAction="#showMesFavoris"/>
                <Button text="🎪 Événements" styleClass="navbar-btn" onAction="#showEvenements"/>
                <Button text="🎟 Mes Événements" styleClass="navbar-btn" onAction="#showMesEvenements"/>
                <Button text="⭐ Mes Favoris" styleClass="navbar-btn" onAction="#showMesFavorisEvenements"/>
            </HBox>
        </ScrollPane>

        <!-- User info + logout -->
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="navbar-user">
            <Label fx:id="lblUserName" text="Étudiant" styleClass="navbar-username"/>
            <Button text="🚪" styleClass="navbar-logout-btn" onAction="#onLogout">
                <tooltip>
                    <Tooltip text="Déconnexion"/>
                </tooltip>
            </Button>
        </HBox>
    </HBox>

    <!-- CONTENT AREA -->
    <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="etudiant-content"/>

</VBox>
