<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.ModifierConsultationModalController"
      spacing="0"
      prefWidth="600" prefHeight="620"
      maxWidth="600" maxHeight="620"
      style="-fx-background-color: #f0f4ff;">

    <!-- ── Header gradient ── -->
    <VBox style="-fx-background-color: linear-gradient(to bottom right, #6366f1, #8b5cf6);
                 -fx-padding: 20 24 18 24;" spacing="3">
        <HBox alignment="CENTER_LEFT">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="✏  Modifier l'avis et la note"
                       style="-fx-font-family:'Segoe UI';-fx-font-size:17px;
                              -fx-font-weight:bold;-fx-text-fill:#ffffff;" />
                <Label text="Ajoutez ou modifiez votre avis et la note de satisfaction"
                       style="-fx-font-family:'Segoe UI';-fx-font-size:11px;
                              -fx-text-fill:rgba(255,255,255,0.75);" />
            </VBox>
            <Button fx:id="btnFermer" text="✕"
                    style="-fx-background-color:rgba(255,255,255,0.18);-fx-text-fill:#ffffff;
                           -fx-font-size:13px;-fx-padding:5 10;-fx-background-radius:8;
                           -fx-cursor:hand;-fx-border-width:0;" />
        </HBox>
    </VBox>

    <!-- ── Body ── -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                VBox.vgrow="ALWAYS"
                style="-fx-background:transparent;-fx-background-color:transparent;">
        <VBox spacing="14"
              style="-fx-padding:22 24 16 24;-fx-background-color:#f0f4ff;">

            <!-- Avis -->
            <!-- Avis -->
            <VBox spacing="4">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="✏  Avis du psychologue"
                           style="-fx-font-family:'Segoe UI';-fx-font-size:12px;
                      -fx-font-weight:bold;-fx-text-fill:#6366f1;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnGenererAvisIA" text="🤖  Générer un avis IA"
                            style="-fx-background-color:#8b5cf6;-fx-text-fill:white;
                       -fx-font-family:'Segoe UI';-fx-font-size:11px;-fx-font-weight:bold;
                       -fx-padding:6 14;-fx-background-radius:20;-fx-cursor:hand;
                       -fx-effect:dropshadow(gaussian,rgba(139,92,246,0.3),4,0,0,2);" />
                </HBox>
                <TextArea fx:id="txtAvis"
                          promptText="Saisissez votre avis détaillé sur la consultation..."
                          prefHeight="120" wrapText="true" maxWidth="Infinity"
                          style="-fx-background-color:#f5f3ff;-fx-border-color:#e0e7ff;
                     -fx-border-radius:10;-fx-background-radius:10;
                     -fx-border-width:1;-fx-font-family:'Segoe UI';
                     -fx-font-size:13px;-fx-text-fill:#374151;
                     -fx-prompt-text-fill:#c4b5fd;-fx-padding:12 14;" />
            </VBox>

            <!-- Note -->
            <VBox spacing="4">
                <Label text="★  Note de satisfaction"
                       style="-fx-font-family:'Segoe UI';-fx-font-size:12px;
                              -fx-font-weight:bold;-fx-text-fill:#6366f1;" />
                <VBox spacing="8" alignment="CENTER"
                      style="-fx-background-color:#f5f3ff;-fx-border-color:#e0e7ff;
                             -fx-border-radius:10;-fx-background-radius:10;
                             -fx-border-width:1;-fx-padding:16 18;">
                    <HBox spacing="15" alignment="CENTER">
                        <HBox fx:id="etoilesContainer" spacing="8" alignment="CENTER"/>
                        <VBox spacing="2" alignment="CENTER">
                            <Label fx:id="lblNoteValue" text="0/5"
                                   style="-fx-font-family:'Segoe UI';-fx-text-fill:#6366f1;
                                          -fx-font-size:24px;-fx-font-weight:bold;" />
                            <Label text="sur 5"
                                   style="-fx-font-family:'Segoe UI';-fx-text-fill:#9ca3af;
                                          -fx-font-size:11px;" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnEffacer" text="Effacer"
                                style="-fx-background-color:rgba(239,68,68,0.1);
                                       -fx-text-fill:#ef4444;-fx-border-color:#ef4444;
                                       -fx-border-radius:6;-fx-background-radius:6;
                                       -fx-font-family:'Segoe UI';-fx-font-size:11px;
                                       -fx-font-weight:bold;-fx-padding:6 12;-fx-cursor:hand;" />
                    </HBox>
                    <Label text="Cliquez sur les étoiles pour attribuer une note"
                           style="-fx-font-family:'Segoe UI';-fx-text-fill:#9ca3af;
                                  -fx-font-size:11px;" />
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- ── Toast overlay (au-dessus du footer) ── -->
    <StackPane fx:id="toastContainer"
               style="-fx-padding: 0 0 8 0;"
               minHeight="0" prefHeight="0"
               visible="false" managed="false"
               mouseTransparent="true"/>

    <!-- ── Footer ── -->
    <HBox alignment="CENTER_RIGHT" spacing="10"
          style="-fx-padding:14 24;-fx-background-color:#ffffff;
                 -fx-border-color:#e0e7ff;-fx-border-width:1 0 0 0;">
        <Button fx:id="btnAnnuler" text="✕ Annuler"
                style="-fx-background-color:#f3f4f6;-fx-text-fill:#6b7280;
                       -fx-font-family:'Segoe UI';-fx-font-size:13px;
                       -fx-padding:10 22;-fx-background-radius:10;
                       -fx-border-color:#e5e7eb;-fx-border-width:1;
                       -fx-border-radius:10;-fx-cursor:hand;" />
        <Button fx:id="btnEnregistrer" text="💾 Enregistrer"
                style="-fx-background-color:#6366f1;-fx-text-fill:#ffffff;
                       -fx-font-family:'Segoe UI';-fx-font-size:13px;-fx-font-weight:bold;
                       -fx-padding:10 22;-fx-background-radius:10;-fx-cursor:hand;
                       -fx-effect:dropshadow(gaussian,rgba(99,102,241,0.35),8,0,0,2);" />
    </HBox>

</VBox>