<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.TraitementAffichageController" stylesheets="@/css/traitements-suivis.css">

    <!-- En-tête de la page -->
    <VBox styleClass="page-header">
        <Label text="Détails du Traitement" styleClass="page-title"/>
        <Label text="Consultez les informations complètes du traitement" styleClass="page-subtitle"/>
    </VBox>

    <!-- Zone scrollable -->
    <ScrollPane styleClass="detail-scroll-pane" fitToWidth="true" VBox.vgrow="ALWAYS">
        <content>
            <VBox styleClass="form-container" spacing="20">
                <padding>
                    <Insets top="20" right="30" bottom="20" left="30"/>
                </padding>

                <!-- Carte Informations générales -->
                <VBox styleClass="detail-card">
                    <Label text="Informations générales" styleClass="detail-section-title"/>
                    <Separator styleClass="detail-separator"/>

                    <GridPane hgap="20" vgap="15" styleClass="detail-grid">

                        <Label text="Titre" styleClass="detail-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblTitre" styleClass="detail-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Type" styleClass="detail-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="lblType" styleClass="detail-value" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                        <Label text="Catégorie" styleClass="detail-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblCategorie" styleClass="detail-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Durée (jours)" styleClass="detail-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <Label fx:id="lblDureeJours" styleClass="detail-value" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    </GridPane>
                </VBox>

                <!-- Carte Statut et Priorité -->
                <VBox styleClass="detail-card">
                    <Label text="Statut et Priorité" styleClass="detail-section-title"/>
                    <Separator styleClass="detail-separator"/>

                    <GridPane hgap="20" vgap="15" styleClass="detail-grid">

                        <Label text="Statut" styleClass="detail-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblStatut" styleClass="detail-value-badge" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Priorité" styleClass="detail-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="lblPriorite" styleClass="detail-value-badge" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    </GridPane>
                </VBox>

                <!-- Carte Dates -->
                <VBox styleClass="detail-card">
                    <Label text="Période du traitement" styleClass="detail-section-title"/>
                    <Separator styleClass="detail-separator"/>

                    <GridPane hgap="20" vgap="15" styleClass="detail-grid">

                        <Label text="Date Début" styleClass="detail-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDateDebut" styleClass="detail-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Date Fin" styleClass="detail-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="lblDateFin" styleClass="detail-value" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    </GridPane>
                </VBox>

                <!-- Carte Dosage -->
                <VBox styleClass="detail-card">
                    <Label text="Dosage" styleClass="detail-section-title"/>
                    <Separator styleClass="detail-separator"/>

                    <GridPane hgap="20" vgap="15" styleClass="detail-grid">

                        <Label text="Dosage prescrit" styleClass="detail-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDosage" styleClass="detail-value" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

                    </GridPane>
                </VBox>

                <!-- Carte Intervenants -->
                <VBox styleClass="detail-card">
                    <Label text="Intervenants" styleClass="detail-section-title"/>
                    <Separator styleClass="detail-separator"/>

                    <GridPane hgap="20" vgap="15" styleClass="detail-grid">

                        <Label text="Étudiant" styleClass="detail-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblEtudiant" styleClass="detail-value" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Psychologue" styleClass="detail-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="lblPsychologue" styleClass="detail-value" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    </GridPane>
                </VBox>

                <!-- Carte Objectif Thérapeutique -->
                <VBox styleClass="detail-card">
                    <Label text="Objectif Thérapeutique" styleClass="detail-section-title"/>
                    <Separator styleClass="detail-separator"/>

                    <VBox spacing="8">
                        <Label fx:id="lblObjectifTherapeutique" styleClass="detail-value-full" wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- Carte Description -->
                <VBox styleClass="detail-card">
                    <Label text="Description" styleClass="detail-section-title"/>
                    <Separator styleClass="detail-separator"/>

                    <VBox spacing="8">
                        <Label fx:id="lblDescription" styleClass="detail-value-full" wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- Boutons d'action -->
                <HBox spacing="15" alignment="CENTER" styleClass="form-buttons">
                    <Button text="Exporter Ordonnance" onAction="#handleExporterPDF" styleClass="btn-info"/>
                    <Button text="Fermer" onAction="#handleFermer" styleClass="btn-primary"/>
                </HBox>
            </VBox>
        </content>
    </ScrollPane>

    <!-- Barre de statut -->
    <HBox styleClass="status-bar">
        <Label fx:id="lblStatus" text="✓ Détails du traitement chargés" styleClass="status-text"/>
    </HBox>
</VBox>