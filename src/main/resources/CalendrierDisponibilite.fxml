<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.CalendrierDisponibiliteController"
            style="-fx-background-color: #f0f4ff;">

    <!-- ══ HEADER ══ -->
    <!-- Message d'info pour le glisser-déposer -->
    <Label fx:id="lblSelection"
           style="-fx-font-family:'Segoe UI'; -fx-font-size:11px;
              -fx-text-fill:#9ca3af; -fx-font-style:italic; -fx-padding:8 0 0 0;" />
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #4c1d95, #6366f1);
                     -fx-padding: 18 24 16 24;" spacing="10">

            <!-- Titre + bouton retour -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Button fx:id="btnRetour" text="← Retour"
                        style="-fx-background-color: rgba(255,255,255,0.15);
                               -fx-text-fill: white; -fx-font-family: 'Segoe UI';
                               -fx-font-size: 12px; -fx-font-weight: bold;
                               -fx-padding: 6 14; -fx-background-radius: 8;
                               -fx-cursor: hand; -fx-border-width: 0;"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="📅  Vue Calendrier"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18px;
                                  -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Cliquez sur un jour pour ajouter une disponibilité"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                                  -fx-text-fill: rgba(255,255,255,0.70);"/>
                </VBox>
            </HBox>

            <!-- Navigation mois + légende -->
            <HBox alignment="CENTER" spacing="16">
                <Button fx:id="btnMoisPrec" text="‹"
                        style="-fx-background-color: rgba(255,255,255,0.20);
                               -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;
                               -fx-min-width: 34; -fx-min-height: 34;
                               -fx-background-radius: 50; -fx-cursor: hand; -fx-border-width: 0;"/>

                <Label fx:id="lblMoisAnnee" text="Avril 2025"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 16px;
                              -fx-font-weight: bold; -fx-text-fill: white;
                              -fx-min-width: 160; -fx-alignment: CENTER;"/>

                <Button fx:id="btnMoisSuiv" text="›"
                        style="-fx-background-color: rgba(255,255,255,0.20);
                               -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;
                               -fx-min-width: 34; -fx-min-height: 34;
                               -fx-background-radius: 50; -fx-cursor: hand; -fx-border-width: 0;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Légende -->
                <HBox spacing="14" alignment="CENTER_RIGHT">
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label style="-fx-background-color:#22c55e;-fx-min-width:12;
                                      -fx-min-height:12;-fx-background-radius:3;"/>
                        <Label text="Disponible"
                               style="-fx-font-family:'Segoe UI';-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.80);"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label style="-fx-background-color:#f97316;-fx-min-width:12;
                                      -fx-min-height:12;-fx-background-radius:3;"/>
                        <Label text="Réservé"
                               style="-fx-font-family:'Segoe UI';-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.80);"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label style="-fx-background-color:#ef4444;-fx-min-width:12;
                                      -fx-min-height:12;-fx-background-radius:3;"/>
                        <Label text="Annulé"
                               style="-fx-font-family:'Segoe UI';-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.80);"/>
                    </HBox>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label style="-fx-background-color:#6366f1;-fx-min-width:12;
                                      -fx-min-height:12;-fx-background-radius:3;-fx-border-color:white;
                                      -fx-border-width:1;-fx-border-radius:3;"/>
                        <Label text="Aujourd'hui"
                               style="-fx-font-family:'Segoe UI';-fx-font-size:11px;-fx-text-fill:rgba(255,255,255,0.80);"/>
                    </HBox>
                </HBox>
            </HBox>

        </VBox>
    </top>

    <!-- ══ CORPS : entêtes jours + grille ══ -->
    <center>
        <VBox style="-fx-padding: 16 20 20 20;" spacing="0">

            <!-- Entêtes colonnes jours -->
            <GridPane fx:id="gridEntetes" hgap="4" vgap="0"
                      style="-fx-padding: 0 0 6 0;">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                </columnConstraints>
            </GridPane>

            <!-- Grille calendrier (remplie dynamiquement) -->
            <GridPane fx:id="gridCalendrier" hgap="4" vgap="4"
                      VBox.vgrow="ALWAYS">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                </columnConstraints>
            </GridPane>

        </VBox>
    </center>

</BorderPane>
