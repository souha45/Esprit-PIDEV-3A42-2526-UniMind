<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox
        prefWidth="240"
        spacing="0"
        style="-fx-background-color: #ffffff; -fx-border-color: #e0e7ff; -fx-border-width: 0 2 0 0; -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.10), 16, 0, 2, 0);"
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.controllers.SidebarEtudiantController">

    <!-- Brand Header -->
    <VBox alignment="CENTER_LEFT" spacing="2"
          style="-fx-background-color: linear-gradient(to bottom right, #6366f1, #8b5cf6); -fx-padding: 24 18 20 18;">
        <Label text="🧠 Unimind"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
        <Label text="Espace Étudiant"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.75); -fx-letter-spacing: 1px;" />
    </VBox>

    <!-- User Info -->
    <VBox alignment="CENTER_LEFT" spacing="3"
          style="-fx-background-color: #f5f3ff; -fx-padding: 16 18 14 18; -fx-border-color: #e0e7ff; -fx-border-width: 0 0 1 0;">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="lblInitiales" text="GH"
                   style="-fx-background-color: #8b5cf6; -fx-text-fill: #ffffff; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10 12 10 12; -fx-background-radius: 50; -fx-min-width: 42; -fx-min-height: 42; -fx-alignment: CENTER;" />
            <VBox spacing="2">
                <Label fx:id="lblNomComplet" text="Ghofrane Hraghi"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #3730a3;" />
                <Label fx:id="lblRole" text="ÉTUDIANT"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 9px; -fx-text-fill: #a78bfa; -fx-letter-spacing: 1.5px;" />
            </VBox>
        </HBox>
    </VBox>

    <!-- Navigation Menu -->
    <VBox spacing="2" style="-fx-padding: 16 10 10 10;" VBox.vgrow="ALWAYS">

        <Label text="NAVIGATION"
               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 9px; -fx-text-fill: #c4b5fd; -fx-padding: 4 8 8 8; -fx-letter-spacing: 2px;" />

        <Button fx:id="btnDashboard" text="  📊  Dashboard"
                maxWidth="Infinity"
                style="-fx-background-color: #ede9fe; -fx-text-fill: #6366f1; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-padding: 11 16; -fx-background-radius: 10; -fx-border-color: #c4b5fd; -fx-border-width: 0 0 0 3; -fx-border-radius: 10; -fx-cursor: hand;" />

        <Button fx:id="btnMesRendezVous" text="  📋  Mes Rendez-vous"
                maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 11 16; -fx-background-radius: 10; -fx-cursor: hand;" />

        <Button fx:id="btnConsultations" text="  📝  Consultations"
                maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 11 16; -fx-background-radius: 10; -fx-cursor: hand;" />

        <Button fx:id="btnTraitements" text="  💊  Traitements"
                maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 11 16; -fx-background-radius: 10; -fx-cursor: hand;" />

        <Button fx:id="btnSuiviTraitements" text="  📈  Suivi Traitements"
                maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 11 16; -fx-background-radius: 10; -fx-cursor: hand;" />

        <Button fx:id="btnQuestionnaires" text="  ❓  Questionnaires"
                maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 11 16; -fx-background-radius: 10; -fx-cursor: hand;" />

        <Button fx:id="btnMesReponses" text="  ✅  Mes Réponses"
                maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 11 16; -fx-background-radius: 10; -fx-cursor: hand;" />

    </VBox>

    <!-- Footer -->
    <VBox spacing="6" style="-fx-padding: 10 10 18 10; -fx-border-color: #e0e7ff; -fx-border-width: 1 0 0 0;">
        <Button fx:id="btnDeconnexion" text="  🚪  Déconnexion"
                maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #ef4444; -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 11 16; -fx-background-radius: 10; -fx-cursor: hand;" />
    </VBox>

</VBox>
