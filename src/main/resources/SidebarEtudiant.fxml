<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" style="-fx-background-color: #2c3e50; -fx-padding: 20;" prefWidth="250"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.SidebarEtudiantController">

    <!-- Avatar et infos utilisateur -->
    <VBox alignment="CENTER" spacing="5">
        <Label fx:id="lblInitiales" text="GH"
               style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 15; -fx-background-radius: 50;" />
        <Label fx:id="lblNomComplet" text="ghofrane hraghi"
               style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
        <Label fx:id="lblRole" text="Étudiant"
               style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;" />
    </VBox>

    <Separator style="-fx-background-color: #34495e;" />

    <!-- Menu de navigation -->
    <VBox spacing="5">
        <Button fx:id="btnDashboard" text="📊 Dashboard"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-cursor: hand;">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
        <Button fx:id="btnMesRendezVous" text="📋 Mes Rendez-vous"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-cursor: hand;">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
        <Button fx:id="btnConsultations" text="📝 Consultations"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-cursor: hand;">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
        <Button fx:id="btnTraitements" text="💊 Traitements"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-cursor: hand;">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
        <Button fx:id="btnSuiviTraitements" text="📈 Suivi Traitements"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-cursor: hand;">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
        <Button fx:id="btnQuestionnaires" text="📝 Questionnaires"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-cursor: hand;">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
        <Button fx:id="btnMesReponses" text="✅ Mes Réponses"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-padding: 10 15; -fx-cursor: hand;">
            <font>
                <Font size="18.0" />
            </font>
        </Button>
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <Button fx:id="btnDeconnexion" text="🚪 Déconnexion"
            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10; -fx-cursor: hand;">
        <font>
            <Font size="18.0" />
        </font>
    </Button>

</VBox>