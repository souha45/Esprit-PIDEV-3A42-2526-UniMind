<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<VBox prefWidth="260" spacing="0" prefHeight="700"
      style="-fx-background-color: #ffffff;
             -fx-border-color: #e0e7ff; -fx-border-width: 0 2 0 0;
             -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.10), 16, 0, 2, 0);"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.SidebarEtudiantController">

    <!-- ── Brand header ───────────────────────────────────────── -->
    <VBox alignment="CENTER_LEFT" spacing="2"
          style="-fx-background-color: linear-gradient(to bottom right, #6366f1, #8b5cf6);
                 -fx-padding: 20 18 16 18;">

        <!-- Ligne Unimind + bouton micro -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="1" HBox.hgrow="ALWAYS">
                <Label text="Unimind"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 20px;
                              -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                <Label text="Espace Étudiant"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px;
                              -fx-text-fill: rgba(255,255,255,0.75); -fx-letter-spacing: 1px;" />
            </VBox>

            <!-- Bouton microphone assistant vocal -->
            <VBox alignment="CENTER" spacing="4">
                <Button fx:id="btnVoice"
                        text="🎙"
                        onAction="#toggleVoiceAssistant"
                        style="-fx-background-color: rgba(255,255,255,0.18);
               -fx-text-fill: white; -fx-font-size: 16px;
               -fx-background-radius: 50%; -fx-min-width: 38px;
               -fx-min-height: 38px; -fx-max-width: 38px;
               -fx-max-height: 38px; -fx-cursor: hand;
               -fx-border-color: rgba(255,255,255,0.35);
               -fx-border-radius: 50%; -fx-border-width: 1.5;">
                    <tooltip>
                        <Tooltip text="Assistant vocal" />
                    </tooltip>
                </Button>
                <Label fx:id="lblVoiceHint" text="vocal"
                       style="-fx-font-size: 8px; -fx-text-fill: rgba(255,255,255,0.65);"/>
            </VBox>
        </HBox>

        <!-- Feedback assistant vocal (transcript + statut) -->
        <VBox fx:id="voiceFeedbackBox" spacing="3"
              visible="false" managed="false"
              style="-fx-background-color: rgba(0,0,0,0.20);
                     -fx-background-radius: 8; -fx-padding: 8 10 8 10;">
            <Label fx:id="lblVoiceStatus" text="🎤 En écoute..."
                   wrapText="true"
                   style="-fx-font-size: 10px; -fx-text-fill: #e0e7ff;
                          -fx-font-family: 'Segoe UI';"/>
            <Label fx:id="lblVoiceTranscript" text=""
                   wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: white;
                          -fx-font-weight: bold; -fx-font-family: 'Segoe UI';"/>
        </VBox>
    </VBox>

    <!-- ── Zone utilisateur ───────────────────────────────────── -->
    <VBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: #f5f3ff; -fx-padding: 16 18 16 18;
                 -fx-border-color: #e0e7ff; -fx-border-width: 0 0 1 0;">
        <HBox spacing="14" alignment="CENTER_LEFT">
            <ImageView fx:id="sidebarPhoto" fitWidth="54" fitHeight="54">
                <clip><Circle centerX="27" centerY="27" radius="27"/></clip>
            </ImageView>
            <VBox spacing="3">
                <Label fx:id="sidebarNomLabel"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px;
                              -fx-font-weight: bold; -fx-text-fill: #3730a3;" />
                <Label fx:id="sidebarPrenomLabel"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                              -fx-text-fill: #6b7280;" />
                <Label fx:id="sidebarRoleLabel" text="Étudiant"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 9px;
                              -fx-text-fill: #a78bfa; -fx-letter-spacing: 1.5px;" />
            </VBox>
        </HBox>
    </VBox>

    <!-- ── Menu principal (SCROLLABLE) ─────────────────────────── -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;
                       -fx-border-width: 0; -fx-padding: 0;">
        <VBox spacing="2" style="-fx-padding: 20 12 12 12;">

            <Label text="NAVIGATION"
                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 9px; -fx-text-fill: #c4b5fd;
                          -fx-padding: 4 8 8 8; -fx-letter-spacing: 2px;" />

            <Button fx:id="btnDashboard" text="  📊  Dashboard" maxWidth="Infinity"
                    style="-fx-background-color: #ede9fe; -fx-text-fill: #6366f1;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16; -fx-background-radius: 10;
                           -fx-border-color: #c4b5fd; -fx-border-width: 0 0 0 3;
                           -fx-border-radius: 10; -fx-cursor: hand;" />

            <Button fx:id="btnMesRendezVous" text="  📅  Mes rendez-vous" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                           -fx-background-radius: 10; -fx-cursor: hand;" />

            <Button fx:id="btnConsultations" text="  📝  Consultations" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                           -fx-background-radius: 10; -fx-cursor: hand;" />

            <Button fx:id="btnTraitements" text="  💊  Traitements" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                           -fx-background-radius: 10; -fx-cursor: hand;" />

            <Button fx:id="btnQuestionnaires" text="  📋  Questionnaires" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                           -fx-background-radius: 10; -fx-cursor: hand;" />

            <Button fx:id="btnMesReponses" text="  💬  Mes réponses" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                           -fx-background-radius: 10; -fx-cursor: hand;" />

            <Button fx:id="btnSeances" text="  🌸 Séances Méditation" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                           -fx-background-radius: 10; -fx-cursor: hand;"
                    onAction="#showSeancesMeditation" />

            <Button fx:id="btnFavoris" text="  ❤ Mes Favoris Séances" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                           -fx-background-radius: 10; -fx-cursor: hand;"
                    onAction="#showMesFavoris" />

            <Button fx:id="btnEvenements" text="  🎪 Événements" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                           -fx-background-radius: 10; -fx-cursor: hand;"
                    onAction="#showEvenements" />

            <Button fx:id="btnMesParticipations" text="  ✅ Mes Participations" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                           -fx-background-radius: 10; -fx-cursor: hand;"
                    onAction="#showMesParticipations" />

            <Button fx:id="btnFavorisEvenements" text="  ❤ Favoris Événements" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                           -fx-background-radius: 10; -fx-cursor: hand;"
                    onAction="#showFavorisEvenements" />

            <Button fx:id="btnProfil" text="  👤  Mon profil" maxWidth="Infinity"
                    style="-fx-background-color: transparent; -fx-text-fill: #6b7280;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                           -fx-background-radius: 10; -fx-cursor: hand;" />
        </VBox>
    </ScrollPane>

    <!-- ── Pied : déconnexion ─────────────────────────────────── -->
    <VBox spacing="6"
          style="-fx-padding: 10 12 18 12; -fx-border-color: #e0e7ff; -fx-border-width: 1 0 0 0;">
        <Button fx:id="btnDeconnexion" text="  🚪  Déconnexion" maxWidth="Infinity"
                style="-fx-background-color: transparent; -fx-text-fill: #ef4444;
                       -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                       -fx-alignment: CENTER_LEFT; -fx-padding: 11 16;
                       -fx-background-radius: 10; -fx-cursor: hand;" />
    </VBox>

</VBox>
