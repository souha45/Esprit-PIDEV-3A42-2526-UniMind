<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<!--
    UniMind Login - Design professionnel deux colonnes
    Inspiré du style Argon Dashboard (split-panel)
    Adaptable à toutes les tailles de fenêtre via AnchorPane + HBox
-->
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.LoginController"
            minWidth="640" minHeight="480"
            style="-fx-background-color: #F0EFFF;">

    <!-- Conteneur principal plein écran -->
    <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <!-- ════════════════════════════════════════
             PANNEAU GAUCHE — Formulaire de connexion
             ════════════════════════════════════════ -->
        <VBox HBox.hgrow="ALWAYS"
              alignment="CENTER"
              style="-fx-background-color: #F8F7FF;"
              spacing="0">

            <!-- Carte formulaire centrée avec largeur max -->
            <VBox alignment="TOP_LEFT" spacing="24"
                  maxWidth="400" minWidth="300"
                  style="-fx-padding: 48 40 48 40;">

                <!-- Logo + Nom -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                        <image><Image url="@/images/unimind.png"/></image>
                    </ImageView>
                    <Label text="UniMind"
                           style="-fx-font-size: 20px; -fx-font-weight: bold;
                                  -fx-text-fill: #3730A3; -fx-font-family: 'Segoe UI';"/>
                </HBox>

                <!-- Titre section -->
                <VBox spacing="4">
                    <Label text="Connexion à UniMind"
                           style="-fx-font-size: 26px; -fx-font-weight: bold;
                                  -fx-text-fill: #1E1B4B; -fx-font-family: 'Segoe UI';"/>
                    <Label text="Entrez vos identifiants pour accéder à votre espace"
                           style="-fx-font-size: 13px; -fx-text-fill: #6B7280;
                                  -fx-font-family: 'Segoe UI';" wrapText="true"/>
                </VBox>

                <!-- Séparateur fin -->
                <Region prefHeight="1"
                        style="-fx-background-color: #E5E7EB; -fx-max-width: 400;"/>

                <!-- Champ Email -->
                <VBox spacing="6">
                    <Label text="Adresse email"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                    <TextField fx:id="emailField"
                               promptText="votre@email.tn"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px;
                                      -fx-padding: 12 14; -fx-background-radius: 10;
                                      -fx-border-color: #DDD6FE; -fx-border-radius: 10;
                                      -fx-border-width: 1.5; -fx-background-color: white;
                                      -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.08), 6, 0, 0, 2);"/>
                </VBox>

                <!-- Champ Mot de passe -->
                <VBox spacing="6">
                    <Label text="Mot de passe"
                           style="-fx-font-size: 12px; -fx-font-weight: bold;
                                  -fx-text-fill: #374151; -fx-font-family: 'Segoe UI';"/>
                    <HBox alignment="CENTER_LEFT"
                          style="-fx-background-color: white; -fx-background-radius: 10;
                                 -fx-border-color: #DDD6FE; -fx-border-radius: 10;
                                 -fx-border-width: 1.5;
                                 -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.08), 6, 0, 0, 2);">
                        <PasswordField fx:id="passwordField" promptText="••••••••"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px;
                                              -fx-padding: 12 14; -fx-background-radius: 10 0 0 10;
                                              -fx-border-color: transparent;
                                              -fx-background-color: transparent;"/>
                        <TextField fx:id="passwordVisible" promptText="••••••••"
                                   HBox.hgrow="ALWAYS" visible="false" managed="false"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px;
                                          -fx-padding: 12 14; -fx-background-radius: 10 0 0 10;
                                          -fx-border-color: transparent;
                                          -fx-background-color: transparent;"/>
                        <Button fx:id="btnOeilLogin" text="👁"
                                onAction="#togglePasswordLogin"
                                style="-fx-background-color: transparent; -fx-cursor: hand;
                                       -fx-font-size: 15px; -fx-padding: 10 14;
                                       -fx-border-color: transparent;"/>
                    </HBox>
                </VBox>

                <!-- Se souvenir de moi + Mot de passe oublié -->
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <CheckBox text="Se souvenir de moi"
                              style="-fx-font-size: 12px; -fx-text-fill: #6B7280;
                                     -fx-font-family: 'Segoe UI';"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Mot de passe oublié ?"
                            onAction="#allerReinitialisationMdp"
                            style="-fx-background-color: transparent; -fx-cursor: hand;
                                   -fx-font-size: 12px; -fx-text-fill: #7C3AED;
                                   -fx-font-family: 'Segoe UI';
                                   -fx-underline: true; -fx-border-color: transparent;
                                   -fx-padding: 0;"/>
                </HBox>

                <!-- Message d'erreur -->
                <Label fx:id="messageErreur"
                       style="-fx-text-fill: #DC2626; -fx-font-size: 12px;
                              -fx-font-family: 'Segoe UI';
                              -fx-background-color: #FEF2F2; -fx-background-radius: 8;
                              -fx-padding: 8 12; -fx-border-color: #FECACA;
                              -fx-border-radius: 8;"
                       wrapText="true" visible="false" managed="false"/>

                <!-- Bouton Se connecter -->
                <Button text="Se connecter  →"
                        onAction="#seConnecter"
                        maxWidth="Infinity"
                        prefHeight="46"
                        style="-fx-background-color: linear-gradient(to right, #4F46E5, #7C3AED);
                               -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-font-family: 'Segoe UI'; -fx-background-radius: 10;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.4), 12, 0, 0, 4);"/>

                <!-- Lien inscription -->
                <HBox alignment="CENTER" spacing="4">
                    <Label text="Vous n'avez pas de compte ?"
                           style="-fx-font-size: 13px; -fx-text-fill: #6B7280;
                                  -fx-font-family: 'Segoe UI';"/>
                    <Button text="Créer un compte"
                            onAction="#allerInscription"
                            style="-fx-background-color: transparent; -fx-cursor: hand;
                                   -fx-font-size: 13px; -fx-text-fill: #7C3AED;
                                   -fx-font-family: 'Segoe UI'; -fx-underline: true;
                                   -fx-border-color: transparent; -fx-padding: 0;"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- ════════════════════════════════════════
             PANNEAU DROIT — Visuel / Citation
             (masqué sur petites fenêtres via minWidth)
             ════════════════════════════════════════ -->
        <StackPane minWidth="340"
                   HBox.hgrow="ALWAYS"
                   style="-fx-background-color: linear-gradient(to bottom right, #4F46E5, #7C3AED);
                          -fx-background-radius: 0 0 0 0;">

            <!-- Cercles décoratifs (profondeur) -->
            <Circle radius="260" fill="rgba(255,255,255,0.04)"
                    translateX="120" translateY="-140"/>
            <Circle radius="180" fill="rgba(255,255,255,0.06)"
                    translateX="-80" translateY="160"/>
            <Circle radius="100" fill="rgba(255,255,255,0.08)"
                    translateX="60" translateY="60"/>

            <!-- Contenu texte centré -->
            <VBox alignment="CENTER" spacing="20"
                  style="-fx-padding: 60 50;">
                <Label text="🧠"
                       style="-fx-font-size: 52px;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 12, 0, 0, 4);"/>
                <Label text="« La santé mentale n'est pas une destination, mais un voyage »"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;
                              -fx-text-fill: white; -fx-font-family: 'Segoe UI';
                              -fx-text-alignment: center; -fx-wrap-text: true;
                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 4, 0, 0, 2);"
                       wrapText="true" maxWidth="320" textAlignment="CENTER"/>
                <Label text="Prendre soin de son bien-être mental est essentiel pour une vie équilibrée et épanouissante."
                       style="-fx-font-size: 13px; -fx-text-fill: rgba(255,255,255,0.80);
                              -fx-font-family: 'Segoe UI'; -fx-text-alignment: center;
                              -fx-wrap-text: true;"
                       wrapText="true" maxWidth="300" textAlignment="CENTER"/>

                <!-- Badges features -->
                <VBox spacing="10" style="-fx-padding: 20 0 0 0;">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="✓"
                               style="-fx-background-color: rgba(255,255,255,0.2);
                                      -fx-background-radius: 50; -fx-padding: 4 8;
                                      -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Label text="Suivi personnalisé de votre bien-être"
                               style="-fx-text-fill: rgba(255,255,255,0.9);
                                      -fx-font-size: 13px; -fx-font-family: 'Segoe UI';"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="✓"
                               style="-fx-background-color: rgba(255,255,255,0.2);
                                      -fx-background-radius: 50; -fx-padding: 4 8;
                                      -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Label text="Ressources et exercices guidés"
                               style="-fx-text-fill: rgba(255,255,255,0.9);
                                      -fx-font-size: 13px; -fx-font-family: 'Segoe UI';"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="✓"
                               style="-fx-background-color: rgba(255,255,255,0.2);
                                      -fx-background-radius: 50; -fx-padding: 4 8;
                                      -fx-text-fill: white; -fx-font-weight: bold;"/>
                        <Label text="Communauté étudiante bienveillante"
                               style="-fx-text-fill: rgba(255,255,255,0.9);
                                      -fx-font-size: 13px; -fx-font-family: 'Segoe UI';"/>
                    </HBox>
                </VBox>
            </VBox>
        </StackPane>
    </HBox>
</AnchorPane>
