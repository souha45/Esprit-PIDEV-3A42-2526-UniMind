<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.TraitementController"
            stylesheets="@/css/traitements-suivis.css">

    <!-- Sidebar gauche -->
    <left>
        <fx:include fx:id="sidebarPsy" source="/SidebarPsy.fxml"/>
    </left>

    <!-- Contenu principal -->
    <center>
        <VBox spacing="0">
            <!-- En-tête de la page avec date -->
            <VBox styleClass="page-header">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Gestion des Traitements" styleClass="page-title"/>
                        <Label text="Gérez les traitements et suivez leur progression" styleClass="page-subtitle"/>
                    </VBox>
                    <Label fx:id="lblDate" styleClass="date-label"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px; -fx-text-fill: #6b7280; -fx-padding: 0 20 0 0;"/>
                </HBox>
            </VBox>

            <!--  SECTION STATISTIQUES  -->
            <HBox spacing="14" style="-fx-background-color: white; -fx-padding: 20 24; -fx-border-color: #e0e7ff; -fx-border-width: 0 0 1 0;">

                <!-- Carte Total -->
                <VBox spacing="5" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 12;
                             -fx-padding: 16 20; -fx-border-color: #a5b4fc; -fx-border-width: 1;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.09), 8, 0, 0, 2);">
                    <Label text="TOTAL" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px; -fx-text-fill: #a5b4fc; -fx-letter-spacing: 1px;"/>
                    <Label fx:id="statTotal" text="0" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #6366f1;"/>
                    <Label text="traitements" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                </VBox>

                <!-- Carte En cours -->
                <VBox spacing="5" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #e0f2fe; -fx-background-radius: 12;
                             -fx-padding: 16 20; -fx-border-color: #7dd3fc; -fx-border-width: 1;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(14,165,233,0.09), 8, 0, 0, 2);">
                    <Label text="EN COURS" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px; -fx-text-fill: #38bdf8; -fx-letter-spacing: 1px;"/>
                    <Label fx:id="statEnCours" text="0" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #0ea5e9;"/>
                    <Label text="en traitement" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-text-fill: #7dd3fc;"/>
                </VBox>

                <!-- Carte Terminés -->
                <VBox spacing="5" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ecfdf5; -fx-background-radius: 12;
                             -fx-padding: 16 20; -fx-border-color: #6ee7b7; -fx-border-width: 1;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.09), 8, 0, 0, 2);">
                    <Label text="TERMINÉS" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px; -fx-text-fill: #34d399; -fx-letter-spacing: 1px;"/>
                    <Label fx:id="statTermine" text="0" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                    <Label text="traitements" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-text-fill: #6ee7b7;"/>
                </VBox>

                <!-- Carte Suspendus -->
                <VBox spacing="5" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #fef3c7; -fx-background-radius: 12;
                             -fx-padding: 16 20; -fx-border-color: #fcd34d; -fx-border-width: 1;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.09), 8, 0, 0, 2);">
                    <Label text="SUSPENDUS" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px; -fx-text-fill: #fbbf24; -fx-letter-spacing: 1px;"/>
                    <Label fx:id="statSuspendu" text="0" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                    <Label text="traitements" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-text-fill: #fcd34d;"/>
                </VBox>

                <!-- Carte Priorité Haute -->
                <VBox spacing="5" HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #fef2f2; -fx-background-radius: 12;
                             -fx-padding: 16 20; -fx-border-color: #fecaca; -fx-border-width: 1;
                             -fx-border-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(239,68,68,0.09), 8, 0, 0, 2);">
                    <Label text="PRIORITÉ HAUTE" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px; -fx-text-fill: #f87171; -fx-letter-spacing: 1px;"/>
                    <Label fx:id="statPrioriteHaute" text="0" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ef4444;"/>
                    <Label text="traitements" style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-text-fill: #fecaca;"/>
                </VBox>

            </HBox>

            <!-- Barre de recherche et filtrage -->
            <HBox styleClass="filter-bar" spacing="15" alignment="CENTER_LEFT">
                <HBox styleClass="search-box">
                    <Label text="🔍" styleClass="search-icon"/>
                    <TextField fx:id="txtRecherche" promptText="Rechercher par titre, type ou objectif..." styleClass="search-field"/>
                </HBox>

                <ComboBox fx:id="cmbFiltreStatut" prefWidth="150" promptText="Statut" styleClass="filter-combo"/>
                <ComboBox fx:id="cmbFiltrePriorite" prefWidth="150" promptText="Priorité" styleClass="filter-combo"/>
                <ComboBox fx:id="cmbTri" prefWidth="200" promptText="Trier par..." styleClass="filter-combo"/>

                <Button fx:id="btnAppliquerFiltres" text="Appliquer" onAction="#handleAppliquerFiltres" styleClass="btn-primary-small"/>
                <Button fx:id="btnReinitialiserFiltres" text="Réinitialiser" onAction="#handleReinitialiserFiltres" styleClass="btn-secondary-small"/>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- Barre d'actions -->
            <HBox styleClass="action-bar" spacing="15" alignment="CENTER_LEFT">
                <Button fx:id="btnAjouter" text="+ Nouveau Traitement" onAction="#handleAjouter" styleClass="btn-primary"/>
                <Button text="Rafraîchir" onAction="#handleRafraichir" styleClass="btn-secondary"/>
                <Button text="Suivi des Traitements" onAction="#ouvrirSuiviTraitementView" styleClass="btn-info"/>
                <Button text="Exporter Excel" onAction="#handleExporterExcel" styleClass="btn-secondary"/>
                <Button fx:id="btnStatistiques" text="📊 Statistiques" onAction="#handleStatistiques" styleClass="btn-primary"
                        style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: 600; -fx-padding: 8 16; -fx-background-radius: 6; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4.0, 0.0, 0.0, 2.0);"/>

                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblCount" styleClass="count-badge"/>
            </HBox>

            <!-- Table principale avec pagination -->
            <ScrollPane styleClass="table-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="0">
                        <!-- TableView -->
                        <VBox styleClass="table-container">
                            <TableView fx:id="tableViewTraitements" styleClass="custom-table">
                                <columns>
                                    <TableColumn text="ÉTUDIANT" />
                                    <TableColumn text="TITRE" />
                                    <TableColumn text="TYPE" />
                                    <TableColumn text="CATÉGORIE" />
                                    <TableColumn text="DURÉE" />
                                    <TableColumn text="STATUT" />
                                    <TableColumn text="PRIORITÉ" />
                                    <TableColumn text="DATE DÉBUT" />
                                    <TableColumn text="OBJECTIF" />
                                    <TableColumn text="SUIVIS" />
                                    <TableColumn fx:id="colActions" text="ACTIONS" />
                                </columns>
                            </TableView>
                        </VBox>

                        <!-- Pagination -->
                        <HBox styleClass="pagination-bar" spacing="15" alignment="CENTER"
                              style="-fx-padding: 15 24; -fx-background-color: white; -fx-border-color: #e5e7eb; -fx-border-width: 1 0 0 0;">

                            <Label text="Lignes par page :" style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            <ComboBox fx:id="cmbItemsPerPage" prefWidth="80" styleClass="filter-combo"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <HBox spacing="10" alignment="CENTER">
                                <Button fx:id="btnFirstPage" text="⏮" styleClass="pagination-button" onAction="#handleFirstPage"/>
                                <Button fx:id="btnPrevPage" text="◀" styleClass="pagination-button" onAction="#handlePrevPage"/>
                                <Label fx:id="lblPageInfo" text="Page 1 / 1" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #4f46e5; -fx-min-width: 80; -fx-alignment: CENTER;"/>
                                <Button fx:id="btnNextPage" text="▶" styleClass="pagination-button" onAction="#handleNextPage"/>
                                <Button fx:id="btnLastPage" text="⏭" styleClass="pagination-button" onAction="#handleLastPage"/>
                            </HBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label fx:id="lblTotalPagesInfo" style="-fx-font-size: 11px; -fx-text-fill: #9ca3af;"/>
                        </HBox>
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Barre de statut -->
            <HBox styleClass="status-bar">
                <Label fx:id="lblStatus" text="✓ Prêt" styleClass="status-text"/>
            </HBox>
        </VBox>
    </center>

    <!-- Toast Container pour les notifications -->
    <StackPane fx:id="toastContainer"
               style="-fx-background-color: transparent; -fx-padding: 20;"
               visible="false" managed="false"/>
</BorderPane>