<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.TraitementController" stylesheets="@/css/traitements-suivis.css">

    <!-- En-tête de la page -->
    <VBox styleClass="page-header">
        <Label text="Gestion des Traitements" styleClass="page-title"/>
        <Label text="Gérez les traitements et suivez leur progression" styleClass="page-subtitle"/>
    </VBox>

    <!-- ===== SECTION STATISTIQUES ===== -->
    <HBox styleClass="stats-container" spacing="15" alignment="CENTER">
        <!-- Carte Total -->
        <VBox styleClass="stat-card">
            <Label text="Total" styleClass="stat-label"/>
            <Label fx:id="statTotal" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Carte En cours -->
        <VBox styleClass="stat-card stat-card-en-cours">
            <Label text="En cours" styleClass="stat-label"/>
            <Label fx:id="statEnCours" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Carte Terminés -->
        <VBox styleClass="stat-card stat-card-termine">
            <Label text="Terminés" styleClass="stat-label"/>
            <Label fx:id="statTermine" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Carte Suspendus -->
        <VBox styleClass="stat-card stat-card-suspendu">
            <Label text="Suspendus" styleClass="stat-label"/>
            <Label fx:id="statSuspendu" text="0" styleClass="stat-value"/>
        </VBox>

        <!-- Carte Priorité Haute -->
        <VBox styleClass="stat-card stat-card-haute">
            <Label text="Priorité haute" styleClass="stat-label"/>
            <Label fx:id="statPrioriteHaute" text="0" styleClass="stat-value"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Barre de recherche et filtrage -->
    <HBox styleClass="filter-bar" spacing="15" alignment="CENTER_LEFT">
        <HBox styleClass="search-box">
            <Label text="🔍" styleClass="search-icon"/>
            <TextField fx:id="txtRecherche" promptText="Rechercher par titre, type ou objectif..." styleClass="search-field"/>
        </HBox>

        <ComboBox fx:id="cmbFiltreStatut" prefWidth="150" promptText="Statut" styleClass="filter-combo"/>
        <ComboBox fx:id="cmbFiltrePriorite" prefWidth="150" promptText="Priorité" styleClass="filter-combo"/>

        <!-- ===== NOUVEAU : Tri ===== -->
        <ComboBox fx:id="cmbTri" prefWidth="180" promptText="Trier par..." styleClass="filter-combo"/>

        <!-- Boutons d'action des filtres -->
        <Button fx:id="btnAppliquerFiltres" text="Appliquer" onAction="#handleAppliquerFiltres" styleClass="btn-primary-small"/>
        <Button fx:id="btnReinitialiserFiltres" text="Réinitialiser" onAction="#handleReinitialiserFiltres" styleClass="btn-secondary-small"/>

        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Barre d'actions -->
    <HBox styleClass="action-bar" spacing="15" alignment="CENTER_LEFT">
        <Button fx:id="btnAjouter" text="+ Nouveau Traitement" onAction="#handleAjouter" styleClass="btn-primary"/>
        <Button text="⟳ Rafraîchir" onAction="#handleRafraichir" styleClass="btn-secondary"/>
        <Button text="📋 Suivi des Traitements" onAction="#ouvrirSuiviTraitementView" styleClass="btn-info"/>

        <!-- ===== NOUVEAU : Export Excel ===== -->
        <Button text="📎 Exporter Excel" onAction="#handleExporterExcel" styleClass="btn-secondary"/>

        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblCount" styleClass="count-badge"/>
    </HBox>

    <!-- Table principale -->
    <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
        <TableView fx:id="tableViewTraitements" styleClass="custom-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn text="ÉTUDIANT" />
                <TableColumn text="TITRE" />
                <TableColumn text="TYPE" />
                <TableColumn text="CATÉGORIE" />
                <TableColumn text="DURÉE" />
                <TableColumn text="STATUT" />
                <TableColumn text="PRIORITÉ" />
                <TableColumn text="DATE DÉBUT" />
                <TableColumn text="OBJECTIF" />
                <TableColumn fx:id="colActions" text="ACTIONS" />
            </columns>
        </TableView>
    </VBox>

    <!-- Barre de statut -->
    <HBox styleClass="status-bar">
        <Label fx:id="lblStatus" text="✓ Prêt" styleClass="status-text"/>
    </HBox>
</VBox>