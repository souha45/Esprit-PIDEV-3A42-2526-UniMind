<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controllers.RendezVousEtudiantController"
            style="-fx-background-color: #f0f4ff;">

    <!-- ========== SIDEBAR ========== -->
    <left>
        <fx:include fx:id="sidebarEtudiant" source="SidebarEtudiant.fxml" />
    </left>

    <!-- ========== CONTENU PRINCIPAL ========== -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #f0f4ff; -fx-background: #f0f4ff; -fx-border-width: 0;">
            <VBox spacing="0" style="-fx-background-color: #f0f4ff;">

                <!-- ── PAGE HEADER ── -->
                <VBox style="-fx-background-color: #ffffff; -fx-padding: 24 28 20 28;
                             -fx-border-color: #e0e7ff; -fx-border-width: 0 0 2 0;
                             -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.07), 8, 0, 0, 2);"
                      spacing="3">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label text="Mes rendez-vous"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 22px;
                                          -fx-font-weight: bold; -fx-text-fill: #3730a3;" />
                            <Label text="Consultez et gérez vos rendez-vous avec vos psychologues"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                          -fx-text-fill: #6b7280;" />
                        </VBox>
                        <Label fx:id="lblDate"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                      -fx-font-weight: bold; -fx-text-fill: #6366f1;" />
                    </HBox>
                </VBox>

                <!-- ── BODY ── -->
                <VBox spacing="20" style="-fx-padding: 24 28 28 28;">

                    <!-- ── STAT CARDS ── -->
                    <HBox spacing="14">

                        <!-- Total -->
                        <VBox spacing="5" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #eef2ff; -fx-background-radius: 12;
                                     -fx-padding: 16 20; -fx-border-color: #a5b4fc; -fx-border-width: 1;
                                     -fx-border-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.09), 8, 0, 0, 2);">
                            <Label text="📋 TOTAL"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px;
                                          -fx-text-fill: #a5b4fc; -fx-letter-spacing: 1px;" />
                            <Label fx:id="lblStatTotal" text="—"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px;
                                          -fx-font-weight: bold; -fx-text-fill: #6366f1;" />
                            <Label text="rendez-vous"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                                          -fx-text-fill: #a5b4fc;" />
                        </VBox>

                        <!-- À venir -->
                        <VBox spacing="5" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #ecfdf5; -fx-background-radius: 12;
                                     -fx-padding: 16 20; -fx-border-color: #6ee7b7; -fx-border-width: 1;
                                     -fx-border-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(16,185,129,0.09), 8, 0, 0, 2);">
                            <Label text="🕐 À VENIR"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px;
                                          -fx-text-fill: #34d399; -fx-letter-spacing: 1px;" />
                            <Label fx:id="lblStatAVenir" text="—"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px;
                                          -fx-font-weight: bold; -fx-text-fill: #10b981;" />
                            <Label text="confirmés / en cours"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                                          -fx-text-fill: #6ee7b7;" />
                        </VBox>

                        <!-- En attente -->
                        <VBox spacing="5" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #fefce8; -fx-background-radius: 12;
                                     -fx-padding: 16 20; -fx-border-color: #fde68a; -fx-border-width: 1;
                                     -fx-border-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(245,158,11,0.09), 8, 0, 0, 2);">
                            <Label text="⏳ EN ATTENTE"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px;
                                          -fx-text-fill: #fcd34d; -fx-letter-spacing: 1px;" />
                            <Label fx:id="lblStatAttente" text="—"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px;
                                          -fx-font-weight: bold; -fx-text-fill: #f59e0b;" />
                            <Label text="demandes en cours"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                                          -fx-text-fill: #fcd34d;" />
                        </VBox>

                        <!-- Terminés -->
                        <VBox spacing="5" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #f3f4f6; -fx-background-radius: 12;
                                     -fx-padding: 16 20; -fx-border-color: #d1d5db; -fx-border-width: 1;
                                     -fx-border-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(107,114,128,0.09), 8, 0, 0, 2);">
                            <Label text="✅ TERMINÉS"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px;
                                          -fx-text-fill: #9ca3af; -fx-letter-spacing: 1px;" />
                            <Label fx:id="lblStatTermines" text="—"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px;
                                          -fx-font-weight: bold; -fx-text-fill: #6b7280;" />
                            <Label text="séances effectuées"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                                          -fx-text-fill: #9ca3af;" />
                        </VBox>

                        <!-- Annulés -->
                        <VBox spacing="5" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: #fef2f2; -fx-background-radius: 12;
                                     -fx-padding: 16 20; -fx-border-color: #fca5a5; -fx-border-width: 1;
                                     -fx-border-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(239,68,68,0.09), 8, 0, 0, 2);">
                            <Label text="❌ ANNULÉS"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 10px;
                                          -fx-text-fill: #fca5a5; -fx-letter-spacing: 1px;" />
                            <Label fx:id="lblStatAnnules" text="—"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 28px;
                                          -fx-font-weight: bold; -fx-text-fill: #ef4444;" />
                            <Label text="annulés / absents"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px;
                                          -fx-text-fill: #fca5a5;" />
                        </VBox>

                    </HBox>

                    <!-- ── TABLE CONTAINER ── -->
                    <VBox spacing="0"
                          style="-fx-background-color: #ffffff; -fx-background-radius: 14;
                                 -fx-border-color: #e0e7ff; -fx-border-width: 1; -fx-border-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.08), 10, 0, 0, 3);">

                        <!-- Toolbar interne -->
                        <HBox alignment="CENTER_LEFT" spacing="10"
                              style="-fx-padding: 16 18 14 18; -fx-border-color: #f3f4f6;
                                     -fx-border-width: 0 0 1 0;">

                            <!-- Recherche -->
                            <HBox alignment="CENTER_LEFT" spacing="6"
                                  style="-fx-background-color: #f5f3ff; -fx-border-color: #c7d2fe;
                                         -fx-border-radius: 10; -fx-background-radius: 10;
                                         -fx-padding: 0 12; -fx-border-width: 1;"
                                  prefWidth="220">
                                <Label text="🔍" style="-fx-font-size: 13px; -fx-text-fill: #a5b4fc;" />
                                <TextField fx:id="fieldRecherche"
                                           promptText="Rechercher par psy, date..."
                                           style="-fx-background-color: transparent; -fx-border-width: 0;
                                                  -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                                  -fx-text-fill: #374151; -fx-prompt-text-fill: #c4b5fd;
                                                  -fx-padding: 9 0;"
                                           prefWidth="180" />
                            </HBox>

                            <!-- Filtre psychologue -->
                            <ComboBox fx:id="comboPsy"
                                      promptText="Tous les psy"
                                      style="-fx-background-color: #ffffff; -fx-border-color: #c7d2fe;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-border-width: 1; -fx-font-family: 'Segoe UI';
                                             -fx-font-size: 12px; -fx-pref-height: 38px; -fx-cursor: hand;"
                                      prefWidth="160" />

                            <!-- Filtre type -->
                            <ComboBox fx:id="comboType"
                                      promptText="Tous les types"
                                      style="-fx-background-color: #ffffff; -fx-border-color: #c7d2fe;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-border-width: 1; -fx-font-family: 'Segoe UI';
                                             -fx-font-size: 12px; -fx-pref-height: 38px; -fx-cursor: hand;"
                                      prefWidth="140" />

                            <Region HBox.hgrow="ALWAYS" />

                            <!-- Rafraîchir -->
                            <Button fx:id="btnRafraichir" text="🔄"
                                    style="-fx-background-color: #f3f4f6; -fx-text-fill: #6b7280;
                                           -fx-font-size: 14px; -fx-padding: 9 14;
                                           -fx-background-radius: 10; -fx-border-color: #e5e7eb;
                                           -fx-border-width: 1; -fx-border-radius: 10; -fx-cursor: hand;" />

                            <!-- Prendre RDV -->
                            <Button fx:id="btnPrendreRdv" text="＋  Prendre rendez-vous"
                                    style="-fx-background-color: #6366f1; -fx-text-fill: #ffffff;
                                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                           -fx-font-weight: bold; -fx-padding: 10 20;
                                           -fx-background-radius: 10; -fx-cursor: hand;
                                           -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.35), 8, 0, 0, 2);" />
                        </HBox>

                        <!-- Filtres statut (onglets) -->
                        <HBox spacing="6" style="-fx-padding: 12 18 0 18;">
                            <Button fx:id="btnFiltreAll"      text="Tous"
                                    style="-fx-background-color: #6366f1; -fx-text-fill: #ffffff;
                                           -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                           -fx-font-weight: bold; -fx-padding: 7 16;
                                           -fx-background-radius: 20; -fx-cursor: hand;" />
                            <Button fx:id="btnFiltreDemande"  text="Demandes"
                                    style="-fx-background-color: #fef9c3; -fx-text-fill: #ca8a04;
                                           -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                           -fx-font-weight: bold; -fx-padding: 7 16;
                                           -fx-background-radius: 20; -fx-cursor: hand;" />
                            <Button fx:id="btnFiltreConfirme" text="Confirmés"
                                    style="-fx-background-color: #dcfce7; -fx-text-fill: #16a34a;
                                           -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                           -fx-font-weight: bold; -fx-padding: 7 16;
                                           -fx-background-radius: 20; -fx-cursor: hand;" />
                            <Button fx:id="btnFiltreEnCours"  text="En cours"
                                    style="-fx-background-color: #dbeafe; -fx-text-fill: #2563eb;
                                           -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                           -fx-font-weight: bold; -fx-padding: 7 16;
                                           -fx-background-radius: 20; -fx-cursor: hand;" />
                            <Button fx:id="btnFiltreTermine"  text="Terminés"
                                    style="-fx-background-color: #f3f4f6; -fx-text-fill: #6b7280;
                                           -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                           -fx-font-weight: bold; -fx-padding: 7 16;
                                           -fx-background-radius: 20; -fx-cursor: hand;" />
                            <Button fx:id="btnFiltreAnnule"   text="Annulés"
                                    style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626;
                                           -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                           -fx-font-weight: bold; -fx-padding: 7 16;
                                           -fx-background-radius: 20; -fx-cursor: hand;" />
                            <Button fx:id="btnFiltreAbsent"   text="Absents"
                                    style="-fx-background-color: #ffedd5; -fx-text-fill: #c2410c;
                                           -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                           -fx-font-weight: bold; -fx-padding: 7 16;
                                           -fx-background-radius: 20; -fx-cursor: hand;" />
                        </HBox>

                        <!-- TableView -->
                        <TableView fx:id="tableViewRendezVous"
                                   prefHeight="440"
                                   style="-fx-background-color: transparent; -fx-border-width: 0;
                                          -fx-table-cell-border-color: #f3f4f6; -fx-padding: 8 0 0 0;">
                            <columns>
                                <TableColumn fx:id="colDateHeure"    prefWidth="190" text="📅  Date &amp; Heure" />
                                <TableColumn fx:id="colPsychologue"  prefWidth="180" text="👨‍⚕️  Psychologue" />
                                <TableColumn fx:id="colType"         prefWidth="140" text="💬  Type" />
                                <TableColumn fx:id="colStatut"       prefWidth="140" text="📌  Statut" />
                                <TableColumn fx:id="colActions"      prefWidth="130" text="⚙  Actions" />
                            </columns>
                            <placeholder>
                                <Label text="✨ Aucun rendez-vous trouvé"
                                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 14px;
                                              -fx-text-fill: #c4b5fd;" />
                            </placeholder>
                        </TableView>

                        <!-- Bas de table -->
                        <HBox alignment="CENTER_LEFT" spacing="6"
                              style="-fx-padding: 10 18 14 18; -fx-border-color: #f3f4f6;
                                     -fx-border-width: 1 0 0 0;">
                            <Label text="💡" style="-fx-font-size: 12px;" />
                            <Label fx:id="lblStatut"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;
                                          -fx-text-fill: #9ca3af;" />
                        </HBox>

                    </VBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
